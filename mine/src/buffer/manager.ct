(cl:defpackage #:mine/buffer/manager
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
   (#:buf #:mine/buffer/buffer)
   (#:gap #:mine/buffer/gap)
   (#:cell #:coalton/cell)
   (#:hm #:coalton/hashmap)
   (#:iter #:coalton/iterator)
   (#:str #:coalton/string))
  (:export
   #:BufferManager
   #:bufmgr-new
   #:bufmgr-open-file!
   #:bufmgr-save!
   #:bufmgr-close!
   #:bufmgr-force-close!
   #:bufmgr-close-under-path!
   #:bufmgr-buffers-under-path
   #:bufmgr-find-by-path
   #:bufmgr-find-by-document-key
   #:bufmgr-current
   #:bufmgr-switch!
   #:bufmgr-any-dirty?
   #:bufmgr-path-dirty?))

(in-package #:mine/buffer/manager)

(coalton-toplevel

  ;;; BufferManager

  (define-struct BufferManager
    "Registry of open buffers with a monotonic id counter."
    (buffers  (Cell (hm:HashMap UFix buf:Buffer)))
    (next-id  (Cell UFix))
    (current  (Cell (Optional buf:BufferId))))

  (declare bufmgr-new (Void -> BufferManager))
  (define (bufmgr-new)
    "Create a new empty buffer manager."
    (BufferManager (cell:new hm:empty)
                   (cell:new 0)
                   (cell:new None)))

  ;;; Creating buffers

  (declare bufmgr-open-file! (BufferManager * String -> Result String buf:Buffer))
  (define (bufmgr-open-file! mgr fpath)
    "Open a file, create a buffer, and register it.
If the file does not exist, creates an empty buffer with that path (not written to disk until saved)."
    (match (buf:buffer-resolve-path fpath)
      ((Err message) (Err message))
      ((Ok path)
       (match (bufmgr-find-by-path mgr path)
         ((Some buffer) (Ok buffer))
         ((None)
          (match (buf:buffer-file-exists? path)
            ((Err message) (Err message))
            ((Ok exists?)
             (let n = (cell:read (.next-id mgr)))
             (let bid = (buf:BufferId n))
             (match (if exists?
                        (buf:buffer-from-file bid path)
                        (Ok (buf:buffer-new-file bid path)))
               ((Err message) (Err message))
               ((Ok buffer)
                (cell:update! (fn (buffers) (hm:insert buffers n buffer)) (.buffers mgr))
                (cell:write! (.next-id mgr) (+ n 1))
                (Ok buffer))))))))))

  ;;; Save

  (declare bufmgr-save! (BufferManager * buf:BufferId -> Result String Unit))
  (define (bufmgr-save! mgr bid)
    "Save a buffer to its path. Returns Err if no path is set or on I/O error."
    (match (bufmgr-get mgr bid)
      ((None) (Err "Buffer not found"))
      ((Some b)
       (match (buf:buffer-path b)
         ((None) (Err "Buffer has no file path"))
         ((Some fpath)
          (let contents = (gap:gap-to-string (buf:buffer-gap b)))
          (let result =
            (lisp (-> (Result String Unit)) (fpath contents)
              (cl:handler-case
                  (cl:progn
                    (cl:with-open-file (s fpath :direction ':output
                                                :if-exists ':supersede
                                                :if-does-not-exist ':create
                                                :external-format (coalton-impl/source:source-external-format))
                      (cl:write-string contents s))
                    (Ok Unit))
                (cl:error (c)
                  (Err (cl:format cl:nil "~A" c))))))
          (match result
            ((Ok _)
             (buf:buffer-mark-clean! b)
             (Ok Unit))
            ((Err e) (Err e))))))))

  ;;; Close

  (declare bufmgr-close! (BufferManager * buf:BufferId -> Boolean))
  (define (bufmgr-close! mgr bid)
    "Close a buffer. Returns False if the buffer is dirty (caller decides).
Returns True if closed successfully."
    (match (bufmgr-get mgr bid)
      ((None) True)
      ((Some b)
       (cond
         ((buf:buffer-dirty? b) False)
         (True (bufmgr-force-close! mgr bid) True)))))

  (declare bufmgr-force-close! (BufferManager * buf:BufferId -> Void))
  (define (bufmgr-force-close! mgr bid)
    "Close a buffer unconditionally, discarding any unsaved changes."
    (match bid
      ((buf:BufferId n)
       (cell:update! (fn (buffers) (hm:remove buffers n)) (.buffers mgr))
       (match (cell:read (.current mgr))
         ((Some cur)
          (when (== cur bid)
            (cell:write! (.current mgr) None)
            (values)))
         ((None) (values))))))

  (declare bufmgr-close-under-path! (BufferManager * String -> Void))
  (define (bufmgr-close-under-path! mgr directory)
    "Close clean buffers within DIRECTORY, preserving every unsaved document."
    (rec close ((buffers (bufmgr-buffers-under-path mgr directory)))
      (match buffers
        ((Nil) (values))
        ((Cons buffer rest)
         (bufmgr-close! mgr (buf:buffer-id buffer))
         (close rest))))
    (values))

  (declare bufmgr-buffers-under-path (BufferManager * String -> List buf:Buffer))
  (define (bufmgr-buffers-under-path mgr directory)
    "Snapshot documents within DIRECTORY using canonical identities and a directory boundary."
    (let prefix =
      (lisp (-> (Optional String)) (directory)
        (cl:handler-case
            (cl:if (cl:zerop (cl:length directory))
                   None
                   (Some (mine/buffer/buffer::%normalize-file-document-key
                          (cl:namestring (uiop:ensure-directory-pathname directory)))))
          (cl:error () None))))
    (match prefix
      ((None) Nil)
      ((Some key)
       (rec collect ((entries (hm:entries (cell:read (.buffers mgr)))) (found Nil))
         (match (iter:next! entries)
           ((None) found)
           ((Some (Tuple _ buffer))
            (let document = (buf:buffer-document-key buffer))
            (let inside? = (and (<= (str:length key) (str:length document))
                                (== key (str:substring document 0 (str:length key)))))
            (collect entries (if inside? (Cons buffer found) found))))))))

  ;;; Lookup

  (declare bufmgr-get (BufferManager * buf:BufferId -> Optional buf:Buffer))
  (define (bufmgr-get mgr bid)
    "Look up a buffer by its id."
    (match bid
      ((buf:BufferId n)
       (hm:lookup (cell:read (.buffers mgr)) n))))

  (declare bufmgr-current (BufferManager -> Optional buf:Buffer))
  (define (bufmgr-current mgr)
    "Return the currently active buffer, if any."
    (match (cell:read (.current mgr))
      ((None) None)
      ((Some bid) (bufmgr-get mgr bid))))

  (declare bufmgr-find-by-path (BufferManager * String -> Optional buf:Buffer))
  (define (bufmgr-find-by-path mgr fpath)
    "Find an open buffer by canonical document identity."
    (let key = (lisp (-> String) (fpath)
                 (cl:or (mine/buffer/buffer::%normalize-file-document-key fpath) "")))
    (bufmgr-find-by-document-key mgr key))

  (declare bufmgr-find-by-document-key (BufferManager * String -> Optional buf:Buffer))
  (define (bufmgr-find-by-document-key mgr document-key)
    "Find a buffer by its stable document key."
    (find-by-document-key-in (hm:entries (cell:read (.buffers mgr))) document-key))

  (declare find-by-document-key-in (iter:Iterator (Tuple UFix buf:Buffer) * String -> Optional buf:Buffer))
  (define (find-by-document-key-in entries document-key)
    (match (iter:next! entries)
      ((Some (Tuple _ buf))
       (if (== (buf:buffer-document-key buf) document-key)
           (Some buf)
           (find-by-document-key-in entries document-key)))
      ((None) None)))

  ;;; Switching

  (declare bufmgr-switch! (BufferManager * buf:BufferId -> Void))
  (define (bufmgr-switch! mgr bid)
    "Set BID as the current buffer."
    (cell:write! (.current mgr) (Some bid))
    (values))

  (declare any-dirty-in (iter:Iterator (Tuple UFix buf:Buffer) -> Boolean))
  (define (any-dirty-in entries)
    (match (iter:next! entries)
      ((Some (Tuple _ b))
       (or (buf:buffer-dirty? b)
           (any-dirty-in entries)))
      ((None) False)))

  (declare bufmgr-any-dirty? (BufferManager -> Boolean))
  (define (bufmgr-any-dirty? mgr)
    "Return True if any open buffer is dirty."
    (any-dirty-in (hm:entries (cell:read (.buffers mgr)))))

  (declare bufmgr-path-dirty? (BufferManager * String -> Boolean))
  (define (bufmgr-path-dirty? mgr fpath)
    "Return True if any open buffer with path FPATH is dirty."
    (match (bufmgr-find-by-path mgr fpath)
      ((Some buffer) (buf:buffer-dirty? buffer))
      ((None) False))))
