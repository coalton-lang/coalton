(cl:defpackage #:mine/protocol/messages
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
   (#:wire #:mine/protocol/wire))
  (:export
   #:RequestId #:RequestId
   #:Request
   #:ReqEval #:ReqComplete #:ReqMacroexpand
   #:ReqQuickResult
   #:ReqCompileString #:ReqCompileFile #:ReqBeamSystem
   #:ReqCoaltonTypeOf #:ReqFindDefinition #:ReqArglist
   #:ReqPing #:ReqQuit #:ReqHeapInfo #:ReqTypeOf #:ReqIndentRules
   #:ReqInterruptRequest #:ReqDebugRestart #:ReqDebugAbort #:ReqIOResponse #:ReqIOAbort
   #:request-foreground-id
   #:request-to-sexpr))

(in-package #:mine/protocol/messages)

(coalton-toplevel

  ;;; RequestId

  (derive Eq)
  (define-type RequestId
    "Unique identifier for a protocol request."
    (RequestId UFix))

  ;;; Request

  (define-type Request
    "A request from the TUI client to the runtime server."
    (ReqEval RequestId String String Boolean)
    (ReqQuickResult RequestId String String Boolean)
    (ReqComplete RequestId String String UFix)
    (ReqMacroexpand RequestId String)
    (ReqCompileString RequestId String String String UFix UFix Boolean)
    (ReqCompileFile RequestId String Boolean)
    (ReqBeamSystem RequestId String String)
    (ReqCoaltonTypeOf RequestId String String)
    (ReqFindDefinition RequestId String String)
    (ReqArglist RequestId String String)
    (ReqHeapInfo RequestId)
    (ReqTypeOf RequestId String String)
    (ReqIndentRules RequestId (List String) String)
    (ReqInterruptRequest RequestId RequestId)
    (ReqDebugRestart RequestId UFix)
    (ReqDebugAbort RequestId)
    (ReqIOResponse RequestId String)
    (ReqIOAbort RequestId)
    (ReqPing RequestId)
    (ReqQuit RequestId))

  (declare request-foreground-id (Request -> Optional RequestId))
  (define (request-foreground-id request)
    (match request
      ((ReqEval id _ _ _) (Some id))
      ((ReqQuickResult id _ _ _) (Some id))
      ((ReqCompileString id _ _ _ _ _ _) (Some id))
      ((ReqCompileFile id _ _) (Some id))
      ((ReqBeamSystem id _ _) (Some id))
      (_ None)))

  ;;; Request -> SExpr serialization

  (declare request-to-sexpr (Request -> wire:SExpr))
  (define (request-to-sexpr req)
    "Convert a Request to its wire SExpr representation."
    (match req
      ((ReqEval (RequestId id) form pkg auto-coalton?)
       (wire:SList (make-list (wire:SAtom ":EVAL")
                              (wire:SInteger (into id))
                              (wire:SString form)
                              (wire:SString pkg)
                              (if auto-coalton? (wire:SAtom "T") wire:SNil))))
      ((ReqQuickResult (RequestId id) form pkg auto-coalton?)
       (wire:SList (make-list (wire:SAtom ":QUICK-RESULT")
                              (wire:SInteger (into id))
                              (wire:SString form)
                              (wire:SString pkg)
                              (if auto-coalton? (wire:SAtom "T") wire:SNil))))
      ((ReqComplete (RequestId id) prefix pkg limit)
       (wire:SList (make-list (wire:SAtom ":COMPLETE")
                              (wire:SInteger (into id))
                              (wire:SString prefix)
                              (wire:SString pkg)
                              (wire:SInteger (into limit)))))
      ((ReqMacroexpand (RequestId id) form)
       (wire:SList (make-list (wire:SAtom ":MACROEXPAND")
                              (wire:SInteger (into id))
                              (wire:SString form))))
      ((ReqCompileString (RequestId id) code document-key pkg pos client-prefix-length auto-coalton?)
       (wire:SList (make-list (wire:SAtom ":COMPILE-STRING")
                              (wire:SInteger (into id))
                              (wire:SString code)
                              (wire:SString document-key)
                              (wire:SString pkg)
                              (wire:SInteger (into pos))
                              (wire:SInteger (into client-prefix-length))
                              (if auto-coalton? (wire:SAtom "T") wire:SNil))))
      ((ReqCompileFile (RequestId id) filename load?)
       (wire:SList (make-list (wire:SAtom ":COMPILE-FILE")
                              (wire:SInteger (into id))
                              (wire:SString filename)
                              (if load? (wire:SAtom "T") wire:SNil))))
      ((ReqBeamSystem (RequestId id) system-name asd-path)
       (wire:SList (make-list (wire:SAtom ":BEAM-SYSTEM")
                              (wire:SInteger (into id))
                              (wire:SString system-name)
                              (wire:SString asd-path))))
      ((ReqCoaltonTypeOf (RequestId id) sym pkg)
       (wire:SList (make-list (wire:SAtom ":COALTON-TYPE-OF")
                              (wire:SInteger (into id))
                              (wire:SString sym)
                              (wire:SString pkg))))
      ((ReqFindDefinition (RequestId id) sym pkg)
       (wire:SList (make-list (wire:SAtom ":FIND-DEFINITION")
                              (wire:SInteger (into id))
                              (wire:SString sym)
                              (wire:SString pkg))))
      ((ReqArglist (RequestId id) func pkg)
       (wire:SList (make-list (wire:SAtom ":ARGLIST")
                              (wire:SInteger (into id))
                              (wire:SString func)
                              (wire:SString pkg))))
      ((ReqHeapInfo (RequestId id))
       (wire:SList (make-list (wire:SAtom ":HEAP-INFO") (wire:SInteger (into id)))))
      ((ReqTypeOf (RequestId id) symbol package)
       (wire:SList (make-list (wire:SAtom ":TYPE-OF") (wire:SInteger (into id))
                              (wire:SString symbol) (wire:SString package))))
      ((ReqIndentRules (RequestId id) heads package)
       (wire:SList (make-list (wire:SAtom ":INDENT-RULES") (wire:SInteger (into id))
                              (wire:SList (map wire:SString heads)) (wire:SString package))))
      ((ReqInterruptRequest (RequestId id) (RequestId target))
       (wire:SList (make-list (wire:SAtom ":INTERRUPT-REQUEST") (wire:SInteger (into id))
                              (wire:SInteger (into target)))))
      ((ReqDebugRestart (RequestId id) index)
       (wire:SList (make-list (wire:SAtom ":DEBUG-RESTART") (wire:SInteger (into id))
                              (wire:SInteger (into index)))))
      ((ReqDebugAbort (RequestId id))
       (wire:SList (make-list (wire:SAtom ":DEBUG-ABORT") (wire:SInteger (into id)))))
      ((ReqIOResponse (RequestId id) text)
       (wire:SList (make-list (wire:SAtom ":IO-RESPONSE") (wire:SInteger (into id))
                              (wire:SString text))))
      ((ReqIOAbort (RequestId id))
       (wire:SList (make-list (wire:SAtom ":IO-ABORT") (wire:SInteger (into id)))))
      ((ReqPing (RequestId id))
       (wire:SList (make-list (wire:SAtom ":PING")
                              (wire:SInteger (into id)))))
      ((ReqQuit (RequestId id))
       (wire:SList (make-list (wire:SAtom ":QUIT")
                              (wire:SInteger (into id)))))))

  )
