(cl:defpackage #:mine/protocol/messages
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
   (#:wire #:mine/protocol/wire)
   (#:str #:coalton/string))
  (:export
   #:RequestId #:RequestId
   #:Request
   #:ReqEval #:ReqComplete #:ReqMacroexpand
   #:ReqQuickResult
   #:ReqCompileString #:ReqCompileFile #:ReqBeamSystem
   #:ReqCoaltonTypeOf #:ReqFindDefinition #:ReqArglist
   #:ReqPing #:ReqQuit #:ReqHeapInfo #:ReqTypeOf #:ReqIndentRules
   #:ReqInterruptRequest #:ReqDebugRestart #:ReqDebugAbort #:ReqIOResponse #:ReqIOAbort
   #:request-foreground-id
   #:request-to-sexpr #:request-id-value
   #:Restart #:restart-index #:restart-name #:restart-report
   #:StackFrame #:frame-index #:frame-description
   #:DebuggerSnapshot #:debugger-request-id #:debugger-condition #:debugger-restarts #:debugger-frames
   #:InputRequest #:input-request-id #:input-prompt
   #:Response #:ResponseReturn #:ResponseOutput #:ResponseOutputChunk #:ResponsePackage
   #:ResponseRestartRejected #:ResponseDebugger #:ResponseInput #:ResponseDiagnostic
   #:ResponseConnectionLost #:ResponseBackgroundConnectionLost #:decode-response))

(in-package #:mine/protocol/messages)

(coalton-toplevel

  ;;; RequestId

  (derive Eq)
  (define-type RequestId
    "Unique identifier for a protocol request."
    (RequestId UFix))

  ;;; Request

  (define-type Request
    "A request from the TUI client to the runtime server."
    (ReqEval RequestId String String Boolean)
    (ReqQuickResult RequestId String String Boolean)
    (ReqComplete RequestId String String UFix)
    (ReqMacroexpand RequestId String)
    (ReqCompileString RequestId String String String UFix UFix Boolean)
    (ReqCompileFile RequestId String Boolean)
    (ReqBeamSystem RequestId String String)
    (ReqCoaltonTypeOf RequestId String String)
    (ReqFindDefinition RequestId String String)
    (ReqArglist RequestId String String)
    (ReqHeapInfo RequestId)
    (ReqTypeOf RequestId String String)
    (ReqIndentRules RequestId (List String) String)
    (ReqInterruptRequest RequestId RequestId)
    (ReqDebugRestart RequestId UFix)
    (ReqDebugAbort RequestId)
    (ReqIOResponse RequestId String)
    (ReqIOAbort RequestId)
    (ReqPing RequestId)
    (ReqQuit RequestId))

  (declare request-foreground-id (Request -> Optional RequestId))
  (define (request-foreground-id request)
    (match request
      ((ReqEval id _ _ _) (Some id))
      ((ReqQuickResult id _ _ _) (Some id))
      ((ReqCompileString id _ _ _ _ _ _) (Some id))
      ((ReqCompileFile id _ _) (Some id))
      ((ReqBeamSystem id _ _) (Some id))
      (_ None)))

  ;;; Request -> SExpr serialization

  (declare request-to-sexpr (Request -> wire:SExpr))
  (define (request-to-sexpr req)
    "Convert a Request to its wire SExpr representation."
    (match req
      ((ReqEval (RequestId id) form pkg auto-coalton?)
       (wire:SList (make-list (wire:SAtom ":EVAL")
                              (wire:SInteger (into id))
                              (wire:SString form)
                              (wire:SString pkg)
                              (if auto-coalton? (wire:SAtom "T") wire:SNil))))
      ((ReqQuickResult (RequestId id) form pkg auto-coalton?)
       (wire:SList (make-list (wire:SAtom ":QUICK-RESULT")
                              (wire:SInteger (into id))
                              (wire:SString form)
                              (wire:SString pkg)
                              (if auto-coalton? (wire:SAtom "T") wire:SNil))))
      ((ReqComplete (RequestId id) prefix pkg limit)
       (wire:SList (make-list (wire:SAtom ":COMPLETE")
                              (wire:SInteger (into id))
                              (wire:SString prefix)
                              (wire:SString pkg)
                              (wire:SInteger (into limit)))))
      ((ReqMacroexpand (RequestId id) form)
       (wire:SList (make-list (wire:SAtom ":MACROEXPAND")
                              (wire:SInteger (into id))
                              (wire:SString form))))
      ((ReqCompileString (RequestId id) code document-key pkg pos client-prefix-length auto-coalton?)
       (wire:SList (make-list (wire:SAtom ":COMPILE-STRING")
                              (wire:SInteger (into id))
                              (wire:SString code)
                              (wire:SString document-key)
                              (wire:SString pkg)
                              (wire:SInteger (into pos))
                              (wire:SInteger (into client-prefix-length))
                              (if auto-coalton? (wire:SAtom "T") wire:SNil))))
      ((ReqCompileFile (RequestId id) filename load?)
       (wire:SList (make-list (wire:SAtom ":COMPILE-FILE")
                              (wire:SInteger (into id))
                              (wire:SString filename)
                              (if load? (wire:SAtom "T") wire:SNil))))
      ((ReqBeamSystem (RequestId id) system-name asd-path)
       (wire:SList (make-list (wire:SAtom ":BEAM-SYSTEM")
                              (wire:SInteger (into id))
                              (wire:SString system-name)
                              (wire:SString asd-path))))
      ((ReqCoaltonTypeOf (RequestId id) sym pkg)
       (wire:SList (make-list (wire:SAtom ":COALTON-TYPE-OF")
                              (wire:SInteger (into id))
                              (wire:SString sym)
                              (wire:SString pkg))))
      ((ReqFindDefinition (RequestId id) sym pkg)
       (wire:SList (make-list (wire:SAtom ":FIND-DEFINITION")
                              (wire:SInteger (into id))
                              (wire:SString sym)
                              (wire:SString pkg))))
      ((ReqArglist (RequestId id) func pkg)
       (wire:SList (make-list (wire:SAtom ":ARGLIST")
                              (wire:SInteger (into id))
                              (wire:SString func)
                              (wire:SString pkg))))
      ((ReqHeapInfo (RequestId id))
       (wire:SList (make-list (wire:SAtom ":HEAP-INFO") (wire:SInteger (into id)))))
      ((ReqTypeOf (RequestId id) symbol package)
       (wire:SList (make-list (wire:SAtom ":TYPE-OF") (wire:SInteger (into id))
                              (wire:SString symbol) (wire:SString package))))
      ((ReqIndentRules (RequestId id) heads package)
       (wire:SList (make-list (wire:SAtom ":INDENT-RULES") (wire:SInteger (into id))
                              (wire:SList (map wire:SString heads)) (wire:SString package))))
      ((ReqInterruptRequest (RequestId id) (RequestId target))
       (wire:SList (make-list (wire:SAtom ":INTERRUPT-REQUEST") (wire:SInteger (into id))
                              (wire:SInteger (into target)))))
      ((ReqDebugRestart (RequestId id) index)
       (wire:SList (make-list (wire:SAtom ":DEBUG-RESTART") (wire:SInteger (into id))
                              (wire:SInteger (into index)))))
      ((ReqDebugAbort (RequestId id))
       (wire:SList (make-list (wire:SAtom ":DEBUG-ABORT") (wire:SInteger (into id)))))
      ((ReqIOResponse (RequestId id) text)
       (wire:SList (make-list (wire:SAtom ":IO-RESPONSE") (wire:SInteger (into id))
                              (wire:SString text))))
      ((ReqIOAbort (RequestId id))
       (wire:SList (make-list (wire:SAtom ":IO-ABORT") (wire:SInteger (into id)))))
      ((ReqPing (RequestId id))
       (wire:SList (make-list (wire:SAtom ":PING")
                              (wire:SInteger (into id)))))
      ((ReqQuit (RequestId id))
       (wire:SList (make-list (wire:SAtom ":QUIT")
                              (wire:SInteger (into id)))))))

  ;;; Typed replies. Only the socket boundary deals with host Lisp objects.

  (declare request-id-value (RequestId -> UFix))
  (define (request-id-value (RequestId number)) number)

  (define-struct Restart
    (restart-index UFix)
    (restart-name String)
    (restart-report String))

  (define-struct StackFrame
    (frame-index UFix)
    (frame-description String))

  (define-struct DebuggerSnapshot
    (debugger-request-id RequestId)
    (debugger-condition String)
    (debugger-restarts (List Restart))
    (debugger-frames (List StackFrame)))

  (define-struct InputRequest
    (input-request-id RequestId)
    (input-prompt String))

  (declare restart-index (Restart -> UFix))
  (define restart-index .restart-index)
  (declare restart-name (Restart -> String))
  (define restart-name .restart-name)
  (declare restart-report (Restart -> String))
  (define restart-report .restart-report)
  (declare frame-index (StackFrame -> UFix))
  (define frame-index .frame-index)
  (declare frame-description (StackFrame -> String))
  (define frame-description .frame-description)
  (declare debugger-request-id (DebuggerSnapshot -> RequestId))
  (define debugger-request-id .debugger-request-id)
  (declare debugger-condition (DebuggerSnapshot -> String))
  (define debugger-condition .debugger-condition)
  (declare debugger-restarts (DebuggerSnapshot -> List Restart))
  (define debugger-restarts .debugger-restarts)
  (declare debugger-frames (DebuggerSnapshot -> List StackFrame))
  (define debugger-frames .debugger-frames)
  (declare input-request-id (InputRequest -> RequestId))
  (define input-request-id .input-request-id)
  (declare input-prompt (InputRequest -> String))
  (define input-prompt .input-prompt)

  (define-type Response
    (ResponseReturn RequestId (Result String wire:SExpr))
    (ResponseOutput String)
    (ResponseOutputChunk RequestId String)
    (ResponsePackage RequestId String)
    (ResponseRestartRejected RequestId String)
    (ResponseDebugger DebuggerSnapshot)
    (ResponseInput InputRequest)
    (ResponseDiagnostic wire:SExpr)
    ResponseConnectionLost
    ResponseBackgroundConnectionLost)

  (declare %decode-ufix (wire:SExpr -> Optional UFix))
  (define (%decode-ufix expr)
    (match expr
      ((wire:SInteger number) (tryInto number))
      (_ None)))

  (declare %decode-request-id (wire:SExpr -> Optional RequestId))
  (define (%decode-request-id expr)
    (map RequestId (%decode-ufix expr)))

  (declare %decode-restart (wire:SExpr -> Optional Restart))
  (define (%decode-restart expr)
    (match expr
      ((wire:SList (Cons index (Cons (wire:SString name) (Cons (wire:SString report) (Nil)))))
       (map (fn (number) (Restart number name report)) (%decode-ufix index)))
      (_ None)))

  (declare %decode-frame (wire:SExpr -> Optional StackFrame))
  (define (%decode-frame expr)
    (match expr
      ((wire:SList (Cons index (Cons (wire:SString description) (Nil))))
       (map (fn (number) (StackFrame number description)) (%decode-ufix index)))
      (_ None)))

  (declare %decode-return (List wire:SExpr -> Optional Response))
  (define (%decode-return fields)
    (match fields
      ((Cons rid (Cons (wire:SList (Cons (wire:SAtom tag) (Cons payload (Nil)))) (Nil)))
       (do
         (request-id <- (%decode-request-id rid))
         (cond
           ((== (str:upcase tag) ":OK") (Some (ResponseReturn request-id (Ok payload))))
           ((== (str:upcase tag) ":ERROR")
            (match payload
              ((wire:SString text) (Some (ResponseReturn request-id (Err text))))
              (_ None)))
           (True None))))
      (_ None)))

  (declare %decode-debugger (List wire:SExpr -> Optional Response))
  (define (%decode-debugger fields)
    (match fields
      ((Cons rid (Cons (wire:SString condition) (Cons restarts (Cons frames (Nil)))))
       (do
         (request-id <- (%decode-request-id rid))
         (restart-items <- (wire:sexpr-list-items restarts))
         (frame-items <- (wire:sexpr-list-items frames))
         (decoded-restarts <- (traverse %decode-restart restart-items))
         (decoded-frames <- (traverse %decode-frame frame-items))
         (Some (ResponseDebugger
                (DebuggerSnapshot request-id condition decoded-restarts decoded-frames)))))
      (_ None)))

  (declare %decode-notification (List wire:SExpr -> Optional Response))
  (define (%decode-notification fields)
    (match fields
      ((Cons (wire:SList (Cons (wire:SAtom raw-tag) arguments)) (Nil))
       (let tag = (str:upcase raw-tag))
       (cond
         ((== tag ":DIAGNOSTIC") (Some (ResponseDiagnostic (wire:SList arguments))))
         ((== tag ":OUTPUT")
          (match arguments
            ((Cons (wire:SString text) (Nil)) (Some (ResponseOutput text)))
            (_ None)))
         (True
          (match arguments
            ((Cons rid (Cons (wire:SString text) (Nil)))
             (do
               (request-id <- (%decode-request-id rid))
               (cond
                 ((== tag ":OUTPUT-CHUNK") (Some (ResponseOutputChunk request-id text)))
                 ((== tag ":PACKAGE") (Some (ResponsePackage request-id text)))
                 ((== tag ":DEBUG-RESTART-REJECTED") (Some (ResponseRestartRejected request-id text)))
                 (True None))))
            (_ None)))))
      (_ None)))

  (declare decode-response (wire:SExpr -> Optional Response))
  (define (decode-response expr)
    "Validate a reply at the boundary, preserving nested payloads as typed data."
    (match expr
      ((wire:SList (Cons (wire:SAtom raw-tag) fields))
       (let tag = (str:upcase raw-tag))
       (cond
         ((== tag ":RETURN") (%decode-return fields))
         ((== tag ":NOTIFY") (%decode-notification fields))
         ((== tag ":DEBUG") (%decode-debugger fields))
         ((== tag ":IO-REQUEST")
          (match fields
            ((Cons rid (Cons (wire:SString prompt) (Nil)))
             (map (fn (request-id) (ResponseInput (InputRequest request-id prompt)))
                  (%decode-request-id rid)))
            (_ None)))
         ((== tag ":CONNECTION-LOST")
          (match fields ((Nil) (Some ResponseConnectionLost)) (_ None)))
         ((== tag ":BACKGROUND-CONNECTION-LOST")
          (match fields ((Nil) (Some ResponseBackgroundConnectionLost)) (_ None)))
         (True None)))
      (_ None)))

  )
