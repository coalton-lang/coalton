(cl:defpackage #:mine/syntax/indent
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
   (#:gap #:mine/buffer/gap)
   (#:source #:mine/syntax/context)
   (#:cellw #:mine/text/width)
   (#:str #:coalton/string)
   (#:list #:coalton/list))
  (:export
   #:IndentRule
   #:RuleGeneric
   #:RuleKnown
   #:IndentRuleEntry
   #:PreparedIndent #:prepare-indent-for-line #:prepare-blank-indent-at-position
   #:prepare-indent-from-source #:prepared-indent-heads #:compute-prepared-indent
   #:prepared-source #:prepared-position
   #:indent-heads-for-line
   #:compute-indent-with-rules
   #:compute-blank-indent-at-position-with-rules))

(in-package #:mine/syntax/indent)

(coalton-toplevel

  (define-type IndentToken
    (TokAtom UFix UFix UFix String)
    (TokLiteral UFix UFix UFix)
    (TokList UFix UFix UFix)
    (TokClose UFix UFix UFix))

  (define-type IndentContext
    (Ctx UFix UFix (Optional IndentContext) UFix (List IndentToken) Boolean))

  (define-struct PreparedIndent
    (prepared-source source:SourceContext)
    (prepared-position UFix)
    (prepared-context (Optional IndentContext))
    (prepared-first-token (Optional IndentToken))
    (prepared-original-column UFix)
    (prepared-preserve Boolean)
    (prepared-supported Boolean))

  (declare prepared-source (PreparedIndent -> source:SourceContext))
  (define (prepared-source prepared) (.prepared-source prepared))

  (declare prepared-position (PreparedIndent -> UFix))
  (define (prepared-position prepared) (.prepared-position prepared))

  (define-type IndentRule
    "Indentation metadata resolved by the runtime image.
BODY-START is the first form element that should use body indentation.
LAMBDA-INDEX is the form element whose list should be lambda-list indented.
The booleans mark IF-style distinguished args, local function binding forms,
and DEFMETHOD's qualifier-sensitive lambda list."
    RuleGeneric
    (RuleKnown (Optional UFix) (Optional UFix) Boolean Boolean Boolean))

  (define-type IndentRuleEntry
    (IndentRuleEntry String IndentRule))

  (declare token-col (IndentToken -> UFix))
  (define (token-col token)
    (match token
      ((TokAtom _ _ col _) col)
      ((TokLiteral _ _ col) col)
      ((TokList _ _ col) col)
      ((TokClose _ _ col) col)))

  (declare token-text (IndentToken -> Optional String))
  (define (token-text token)
    (match token
      ((TokAtom _ _ _ text) (Some text))
      (_ None)))

  (declare token-list? (IndentToken -> Boolean))
  (define (token-list? token)
    (match token
      ((TokList _ _ _) True)
      (_ False)))

  (declare token-close? (IndentToken -> Boolean))
  (define (token-close? token)
    (match token
      ((TokClose _ _ _) True)
      (_ False)))

  (declare context-open-col (IndentContext -> UFix))
  (define (context-open-col context)
    (match context
      ((Ctx _ col _ _ _ _) col)))

  (declare context-parent (IndentContext -> Optional IndentContext))
  (define (context-parent context)
    (match context
      ((Ctx _ _ parent _ _ _) parent)))

  (declare context-parent-index (IndentContext -> UFix))
  (define (context-parent-index context)
    (match context
      ((Ctx _ _ _ parent-index _ _) parent-index)))

  (declare context-raw-elements (IndentContext -> List IndentToken))
  (define (context-raw-elements context)
    (match context
      ((Ctx _ _ _ _ elements _) elements)))

  (declare context-literal? (IndentContext -> Boolean))
  (define (context-literal? context)
    (match context ((Ctx _ _ _ _ _ literal) literal)))

  (declare context-elements (IndentContext -> List IndentToken))
  (define (context-elements context)
    (list:reverse (context-raw-elements context)))

  (declare advance-col (UFix * Char -> UFix))
  (define (advance-col col ch)
    (let width = (lisp (-> UFix) () mine/buffer/gap::*tab-width*))
    (cond
      ((== ch #\Newline) 0)
      ((== ch #\Tab) (+ col (- width (mod col width))))
      (True (+ col (cellw:editor-char-cell-width ch)))))

  (declare source-column (source:SourceContext * UFix -> UFix))
  (define (source-column context position)
    (let text = (source:source-text context))
    (let start =
      (rec scan ((pos position))
        (if (or (== pos 0) (== (str:ref text (- pos 1)) (Some #\Newline)))
            pos (scan (- pos 1)))))
    (rec scan ((pos start) (col 0))
      (if (>= pos position) col
          (match (str:ref text pos)
            ((Some ch) (scan (+ pos 1) (advance-col col ch)))
            ((None) col)))))

  (declare form-token (source:SourceContext * source:SourceForm -> IndentToken))
  (define (form-token context form)
    (let start = (source:form-start form))
    (let end = (source:form-end form))
    (let col = (source-column context start))
    (match (source:form-kind form)
      ((source:SymbolForm) (TokAtom start end col (source:form-text context form)))
      ((source:DelimitedForm _) (TokList start end col))
      (_ (TokLiteral start end col))))

  (declare forms-before (source:SourceContext * List source:SourceForm * UFix * List IndentToken
                        -> List IndentToken))
  (define (forms-before context forms pos acc)
    (match forms
      ((Nil) acc)
      ((Cons form rest)
       (if (>= (source:form-start form) pos) acc
           (forms-before context rest pos (Cons (form-token context form) acc))))))

  (declare form-open-at? (source:SourceForm * UFix -> Boolean))
  (define (form-open-at? form pos)
    (and (< (source:form-start form) pos)
         (or (< pos (source:form-end form))
             (and (not (source:form-complete? form)) (<= pos (source:form-end form))))))

  (declare context-at (source:SourceContext * List source:SourceForm * Optional IndentContext
                       * UFix * UFix * Boolean -> Optional IndentContext))
  (define (context-at source-context forms parent index pos quoted)
    (match forms
      ((Nil) parent)
      ((Cons form rest)
       (cond
         ((>= (source:form-start form) pos) parent)
         ((form-open-at? form pos)
          (match (source:form-kind form)
            ((source:DelimitedForm delimiter)
             (let start = (source:form-start form))
             (let context = (Ctx start (source-column source-context start) parent index
                                 (forms-before source-context (source:form-children form) pos Nil)
                                 (or quoted (not (== delimiter source:ParenDelimiter)))))
             (context-at source-context (source:form-children form) (Some context) 0 pos False))
            ((source:PrefixedForm _)
             (let prefix = (str:ref (source:source-text source-context) (source:form-start form)))
             (context-at source-context (source:form-children form) parent index pos
                         (or (== prefix (Some #\')) (== prefix (Some #\`)))))
            (_ parent)))
         (True (context-at source-context rest parent (+ index 1) pos quoted))))))

  (declare first-token-at (source:SourceContext * UFix -> Optional IndentToken))
  (define (first-token-at context pos)
    (let text = (source:source-text context))
    (let end =
      (rec scan ((p pos))
        (match (str:ref text p)
          ((None) p)
          ((Some #\Newline) p)
          (_ (scan (+ p 1))))))
    (rec scan ((tokens (source:source-tokens context)))
      (match tokens
        ((Nil) None)
        ((Cons token rest)
         (let start = (source:token-start token))
         (cond
           ((< start pos) (scan rest))
           ((>= start end) None)
           (True
            (let col = (source-column context start))
            (let token-end = (source:token-end token))
            (match (source:token-kind token)
              ((source:CloseToken _) (Some (TokClose start token-end col)))
              ((source:OpenToken _) (Some (TokList start token-end col)))
              ((source:SymbolToken _) (Some (TokAtom start token-end col (source:token-text context token))))
              ((source:CommentToken _) None)
              (_ (Some (TokLiteral start token-end col))))))))))

  (declare leading-column (source:SourceContext * UFix -> UFix))
  (define (leading-column context pos)
    (let text = (source:source-text context))
    (rec scan ((p pos) (col 0))
      (match (str:ref text p)
        ((Some #\Space) (scan (+ p 1) (+ col 1)))
        ((Some #\Tab) (scan (+ p 1) (advance-col col #\Tab)))
        (_ col))))

  (declare prepare-indent-from-source (source:SourceContext * UFix * UFix * Boolean -> PreparedIndent))
  (define (prepare-indent-from-source context mode pos blank)
    "Prepare once; None from compute-prepared-indent means preserve literal text."
    (let position = (min pos (str:length (source:source-text context))))
    (let class = (source:source-class-at context position))
    ;; Whitespace before a comment/literal opener is outside that literal.
    ;; Only a token begun on an earlier line can protect this line's prefix.
    (let inside-token = (list:any
                         (fn (token)
                           (and (< (source:token-start token) position)
                                (<= position (source:token-end token))))
                         (source:source-tokens context)))
    (PreparedIndent context position
                    (context-at context (source:source-forms context) None 0 position False)
                    (if blank None (first-token-at context position))
                    (leading-column context position)
                    (and inside-token (not (== class source:SourceCode)))
                    (and (> position 0) (<= mode 1))))

  (declare prepare-indent-for-line (gap:GapBuffer * UFix * UFix -> PreparedIndent))
  (define (prepare-indent-for-line gb mode line)
    (prepare-indent-from-source (source:scan-source (gap:gap-to-string gb)) mode
                                (gap:gap-line-to-pos gb line) False))

  (declare prepare-blank-indent-at-position (gap:GapBuffer * UFix * UFix -> PreparedIndent))
  (define (prepare-blank-indent-at-position gb mode pos)
    (prepare-indent-from-source (source:scan-source (gap:gap-to-string gb)) mode pos True))

  (declare context-head (IndentContext -> Optional String))
  (define (context-head context)
    (if (context-literal? context) None
        (match (context-elements context)
          ((Cons (TokAtom _ _ _ text) _) (Some text))
          (_ None))))

  (declare call-keyword? (String -> Boolean))
  (define (call-keyword? text)
    (== (str:ref text 0) (Some #\:)))

  (declare lambda-list-keyword? (String -> Boolean))
  (define (lambda-list-keyword? text)
    (== (str:ref text 0) (Some #\&)))

  (declare rule-entry-head (IndentRuleEntry -> String))
  (define (rule-entry-head entry)
    (match entry
      ((IndentRuleEntry head _) head)))

  (declare rule-entry-rule (IndentRuleEntry -> IndentRule))
  (define (rule-entry-rule entry)
    (match entry
      ((IndentRuleEntry _ rule) rule)))

  (declare lookup-rule (String * List IndentRuleEntry -> IndentRule))
  (define (lookup-rule head rules)
    (match rules
      ((Nil) RuleGeneric)
      ((Cons entry rest)
       (if (== head (rule-entry-head entry))
           (rule-entry-rule entry)
           (lookup-rule head rest)))))

  (declare context-rule (IndentContext * List IndentRuleEntry -> IndentRule))
  (define (context-rule context rules)
    (match (context-head context)
      ((Some head) (lookup-rule head rules))
      ((None) RuleGeneric)))

  (declare rule-body-start (IndentRule -> Optional UFix))
  (define (rule-body-start rule)
    (match rule
      ((RuleKnown body-start _ _ _ _) body-start)
      ((RuleGeneric) None)))

  (declare rule-lambda-index (IndentRule -> Optional UFix))
  (define (rule-lambda-index rule)
    (match rule
      ((RuleKnown _ lambda-index _ _ _) lambda-index)
      ((RuleGeneric) None)))

  (declare rule-distinguished? (IndentRule -> Boolean))
  (define (rule-distinguished? rule)
    (match rule
      ((RuleKnown _ _ distinguished? _ _) distinguished?)
      ((RuleGeneric) False)))

  (declare rule-local-bindings? (IndentRule -> Boolean))
  (define (rule-local-bindings? rule)
    (match rule
      ((RuleKnown _ _ _ local-bindings? _) local-bindings?)
      ((RuleGeneric) False)))

  (declare rule-defmethod? (IndentRule -> Boolean))
  (define (rule-defmethod? rule)
    (match rule
      ((RuleKnown _ _ _ _ defmethod?) defmethod?)
      ((RuleGeneric) False)))

  (declare context-heads-loop (Optional IndentContext * List String -> List String))
  (define (context-heads-loop context acc)
    (match context
      ((None) acc)
      ((Some context-value)
       (context-heads-loop
        (context-parent context-value)
        (match (context-head context-value)
          ((Some head) (Cons head acc))
          ((None) acc))))))

  (declare indent-heads-for-line (gap:GapBuffer * UFix -> List String))
  (define (indent-heads-for-line gb line)
    "Return raw form-head tokens whose rules may affect LINE indentation."
    (prepared-indent-heads (prepare-indent-for-line gb 0 line)))

  (declare prepared-indent-heads (PreparedIndent -> List String))
  (define (prepared-indent-heads prepared)
    (if (or (.prepared-preserve prepared) (not (.prepared-supported prepared)))
        Nil
        (context-heads-loop (.prepared-context prepared) Nil)))

  (declare earlier-list-element? (IndentContext * UFix * UFix -> Boolean))
  (define (earlier-list-element? context start end)
    (rec scan ((tokens (context-elements context))
               (index 0))
      (match tokens
        ((Nil) False)
        ((Cons token rest)
         (or (and (>= index start)
                  (< index end)
                  (token-list? token))
             (scan rest (+ index 1)))))))

  (declare defmethod-lambda-context? (IndentContext * UFix -> Boolean))
  (define (defmethod-lambda-context? parent parent-index)
    (and (>= parent-index 2)
         (not (earlier-list-element? parent 2 parent-index))))

  (declare local-function-binding-context? (IndentContext * List IndentRuleEntry -> Boolean))
  (define (local-function-binding-context? context rules)
    (match (context-parent context)
      ((Some binding-list)
       (match (context-parent binding-list)
         ((Some binding-form)
          (and (== (context-parent-index binding-list) 1)
               (rule-local-bindings? (context-rule binding-form rules))))
         ((None) False)))
      ((None) False)))

  (declare local-function-lambda-context? (IndentContext * UFix * List IndentRuleEntry -> Boolean))
  (define (local-function-lambda-context? parent parent-index rules)
    (and (== parent-index 1)
         (local-function-binding-context? parent rules)))

  (declare lambda-context? (IndentContext * List IndentRuleEntry -> Boolean))
  (define (lambda-context? context rules)
    (match (context-parent context)
      ((Some parent)
       (let parent-index = (context-parent-index context))
       (let parent-rule = (context-rule parent rules))
       (or (match (rule-lambda-index parent-rule)
             ((Some lambda-index) (== parent-index lambda-index))
             ((None) False))
           (and (rule-defmethod? parent-rule)
                (defmethod-lambda-context? parent parent-index))
           (local-function-lambda-context? parent parent-index rules)))
      ((None) False)))

  (declare first-keyword-col ((String -> Boolean) * List IndentToken -> Optional UFix))
  (define (first-keyword-col predicate tokens)
    (match tokens
      ((Nil) None)
      ((Cons token rest)
       (match (token-text token)
         ((Some text)
          (if (predicate text)
              (Some (token-col token))
              (first-keyword-col predicate rest)))
         ((None) (first-keyword-col predicate rest))))))

  (declare last-lambda-keyword-col (List IndentToken -> Optional UFix))
  (define (last-lambda-keyword-col tokens)
    (rec scan ((remaining tokens)
               (last-col None))
      (match remaining
        ((Nil) last-col)
        ((Cons token rest)
         (scan rest
               (match (token-text token)
                 ((Some text)
                  (if (lambda-list-keyword? text)
                      (Some (token-col token))
                      last-col))
                 ((None) last-col)))))))

  (declare first-param-after-last-lambda-keyword-col (List IndentToken -> Optional UFix))
  (define (first-param-after-last-lambda-keyword-col tokens)
    (rec scan ((remaining tokens)
               (seen-keyword False)
               (candidate None))
      (match remaining
        ((Nil) candidate)
        ((Cons token rest)
         (match (token-text token)
           ((Some text)
            (cond
              ((lambda-list-keyword? text)
               (scan rest True None))
              ((and seen-keyword (== candidate None))
               (scan rest seen-keyword (Some (token-col token))))
              (True
               (scan rest seen-keyword candidate))))
           ((None)
            (scan rest seen-keyword candidate)))))))

  (declare body-start-index (IndentContext * List IndentRuleEntry -> Optional UFix))
  (define (body-start-index context rules)
    (if (local-function-binding-context? context rules)
        (Some 2)
        (rule-body-start (context-rule context rules))))

  (declare distinguished-arg? (IndentRule * UFix * Optional UFix -> Boolean))
  (define (distinguished-arg? rule index body-start)
    (cond
      ((rule-distinguished? rule) (> index 0))
      (True
       (match body-start
         ((Some start) (and (> index 0) (< index start)))
         ((None) False)))))

  (declare generic-call-indent (IndentContext -> UFix))
  (define (generic-call-indent context)
    (match (context-elements context)
      ((Cons _ (Cons first-arg _)) (token-col first-arg))
      (_ (+ (context-open-col context) 2))))

  (declare first-element-indent (IndentContext * List IndentToken -> UFix))
  (define (first-element-indent context elements)
    (match elements
      ((Cons token _) (token-col token))
      ((Nil) (+ (context-open-col context) 1))))

  (declare lambda-parameter-indent
           (IndentContext * List IndentToken * Optional UFix * Optional UFix -> UFix))
  (define (lambda-parameter-indent context elements first-param last-keyword)
    (match first-param
      ((Some col) col)
      ((None)
       (match last-keyword
         ((Some col) (+ col 2))
         ((None) (first-element-indent context elements))))))

  (declare lambda-indent (IndentContext * Optional IndentToken -> UFix))
  (define (lambda-indent context first-token)
    (let elements = (context-elements context))
    (let first-text =
      (match first-token
        ((Some token) (token-text token))
        ((None) None)))
    (let first-keyword = (first-keyword-col lambda-list-keyword? elements))
    (let first-param = (first-param-after-last-lambda-keyword-col elements))
    (let last-keyword = (last-lambda-keyword-col elements))
    (match first-text
      ((Some text)
       (if (lambda-list-keyword? text)
           (match first-keyword
             ((Some col) col)
             ((None) (first-element-indent context elements)))
           (lambda-parameter-indent context elements first-param last-keyword)))
      ((None)
       (lambda-parameter-indent context elements first-param last-keyword))))

  (declare keyword-call-line? (Optional IndentToken -> Boolean))
  (define (keyword-call-line? token)
    (match token
      ((Some tok)
       (match (token-text tok)
         ((Some text) (call-keyword? text))
         ((None) False)))
      ((None) False)))

  (declare body-or-generic-indent (IndentContext * List IndentRuleEntry -> UFix))
  (define (body-or-generic-indent context rules)
    (let rule = (context-rule context rules))
    (let body-start = (body-start-index context rules))
    (let next-index = (list:length (context-raw-elements context)))
    (match body-start
      ((Some start)
       (if (>= next-index start)
           (+ (context-open-col context) 2)
           (if (distinguished-arg? rule next-index body-start)
               (+ (context-open-col context) 4)
               (generic-call-indent context))))
      ((None)
       (if (distinguished-arg? rule next-index body-start)
           (+ (context-open-col context) 4)
           (generic-call-indent context)))))

  (declare compute-indent-from-context
           (Optional IndentContext * Optional IndentToken * List IndentRuleEntry -> UFix))
  (define (compute-indent-from-context context first-token rules)
    (match context
      ((None) 0)
      ((Some context-value)
       (cond
         ((match first-token
            ((Some token) (token-close? token))
            ((None) False))
          (context-open-col context-value))
         ((context-literal? context-value)
          (first-element-indent context-value (context-elements context-value)))
         ((lambda-context? context-value rules)
          (lambda-indent context-value first-token))
         ((keyword-call-line? first-token)
          (match (first-keyword-col call-keyword? (context-elements context-value))
            ((Some col) col)
            ((None) (generic-call-indent context-value))))
         (True
          (body-or-generic-indent context-value rules))))))

  (declare compute-prepared-indent (PreparedIndent * List IndentRuleEntry -> Optional UFix))
  (define (compute-prepared-indent prepared rules)
    "Return None when changing leading whitespace would alter literal text."
    (cond
      ((.prepared-preserve prepared) None)
      ((not (.prepared-supported prepared)) (Some 0))
      (True
       (Some (compute-indent-from-context (.prepared-context prepared)
                                          (.prepared-first-token prepared) rules)))))

  (declare compatible-indent (PreparedIndent * List IndentRuleEntry -> UFix))
  (define (compatible-indent prepared rules)
    (match (compute-prepared-indent prepared rules)
      ((Some col) col)
      ((None) (.prepared-original-column prepared))))

  (declare compute-indent-with-rules (gap:GapBuffer * UFix * UFix * List IndentRuleEntry -> UFix))
  (define (compute-indent-with-rules gb mode line rules)
    "Compatibility wrapper; preserve existing whitespace inside literals."
    (compatible-indent (prepare-indent-for-line gb mode line) rules))

  (declare compute-blank-indent-at-position-with-rules
           (gap:GapBuffer * UFix * UFix * List IndentRuleEntry -> UFix))
  (define (compute-blank-indent-at-position-with-rules gb mode pos rules)
    "Compute indentation for a blank line inserted at POS."
    (compatible-indent (prepare-blank-indent-at-position gb mode pos) rules))

)
