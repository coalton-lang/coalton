(in-package #:mine/app/state)

(cl:defstruct %native-box
  "A box holding an arbitrary CL object, used for mailboxes, threads, streams."
  (value cl:nil :type cl:t))

(coalton-toplevel

;;; NativeBox -- opaque wrapper for CL-side objects

  (repr :native %native-box)
  (define-type NativeBox
    "Opaque container for CL-side native objects (mailboxes, threads, streams).")

  (declare native-box-new (Void -> NativeBox))
  (define (native-box-new)
    "Create an empty NativeBox."
    (lisp (-> NativeBox) ()
      (make-%native-box)))

;;; Layout state

  (repr :enum)
  (derive Eq)
  (define-type TreeLayout
    TreeHidden
    TreeVisible)

  (repr :enum)
  (derive Eq)
  (define-type CenterLayout
    CenterEditor
    CenterEditorFull
    CenterEditorFullReplRow
    CenterEditorReplSplit
    CenterReplFull)

  (define-struct MineLayout
    (ml-tree   TreeLayout)
    (ml-center CenterLayout))

;;; Application state

  (define-struct MineState
    "Top-level mutable application state."
    (ms-menu              menubar:MenuBar)
    (ms-status            status:StatusBar)
    (ms-pending-error     (Cell (Optional String)))
    (ms-editor            editor:EditorPane)
    (ms-bufmgr            mgr:BufferManager)
    (ms-cursor            cursor:CursorState)
    (ms-repl              repl:ReplPane)
    (ms-tree              tree:TreePane)
    (ms-focus             focus:FocusManager)
    (ms-runtime           lifecycle:RuntimeManager)
    (ms-next-req-id       (Cell UFix))
    (ms-layout            (Cell MineLayout))
    (ms-tree-frozen       (Cell Boolean))
    (ms-content-x         (Cell UFix))
    (ms-repl-package      (Cell String))
    (ms-repl-busy         (Cell Boolean))
    (ms-repl-timing       (Cell String))
    (ms-proto-mailbox     NativeBox) ;; sb-concurrency mailbox, or nil
    (ms-proto-thread      NativeBox) ;; reader thread handle, or nil
    (ms-debugger-active   (Cell Boolean))
    (ms-debugger-condition (Cell String))
    (ms-debugger-snapshot (Cell (Optional msg:DebuggerSnapshot)))
    (ms-debugger-selected (Cell UFix))
    (ms-debugger-request-id (Cell (Optional msg:RequestId)))
    (ms-jump-stack        (Cell (List requests:SourceLocation)))
    (ms-project-system    (Cell (Optional String)))
    (ms-project-asd-path  (Cell (Optional String)))
    (ms-quit              (Cell Boolean))
    (ms-eval-start-time   (Cell UFix))
    (ms-active-request    (Cell (Optional msg:RequestId)))
    (ms-minibuffer        mini:Minibuffer)
    (ms-repl-lang         (Cell String))
    (ms-preview-path      (Cell (Optional String)))
    (ms-diagnostics       NativeBox) ;; CL hash table: filepath -> diagnostics
    (ms-structural-editing (Cell Boolean))
    (ms-config             cfgt:MineConfig)
    (ms-io-request-active  (Cell Boolean))
    (ms-io-request-data    (Cell (Optional msg:InputRequest)))
    (ms-completion         complete:CompletionState)
    (ms-busy-activity     (Cell (Optional String)))
    (ms-spinner           spinner:Spinner)
    (ms-debugger-scroll   (Cell UFix))
    (ms-debugger-body-h   (Cell UFix))
    (ms-debugger-total    (Cell UFix))
    (ms-debugger-follow   (Cell Boolean))
    (ms-beam-request-id   (Cell (Optional msg:RequestId)))
    (ms-quick-result-state (Cell qr:QuickResultState))
    (ms-quick-result-request-id (Cell (Optional msg:RequestId)))
    (ms-bg-proto-thread    NativeBox)
    (ms-update-check-state NativeBox) ;; CL plist for update-check status
    (ms-editor-views (Cell (hm:HashMap UFix editor:EditorView)))
    (ms-view-buffer (Cell (Optional buf:BufferId)))
    (ms-requests requests:RequestState)
    (ms-initialization-request (Cell (Optional msg:RequestId)))
    (ms-after-initialization (Cell (Optional (Tuple msg:Request Boolean)))))

  (declare mine-state-new (cfgt:MineConfig -> MineState))
  (define (mine-state-new config)
    "Create application state without opening a terminal or starting the runtime."
    (let runtime = (lifecycle:runtime-manager-new))
    (lifecycle:runtime-set-heap-size! runtime (cfgt:.config-repl-heap-size config))
    (MineState (menubar:menubar-new) (status:statusbar-new)
               (cell:new None)
               (editor:editor-pane-new) (mgr:bufmgr-new) (cursor:cursor-new)
               (repl:repl-pane-new) (tree:tree-pane-new) (focus:focus-new) runtime
               (cell:new 0) (cell:new (MineLayout TreeHidden CenterEditor))
               (cell:new (not (cfgt:.config-auto-hide-tree-pane config)))
               (cell:new 0)
               (cell:new (cfgt:.config-default-package config)) (cell:new False)
               (cell:new "")
               (native-box-new) (native-box-new)
               (cell:new False) (cell:new "")
               (cell:new None) (cell:new 0) (cell:new None)
               (cell:new Nil)
               (cell:new None) (cell:new None) (cell:new False)
               (cell:new 0) (cell:new None)
               (mini:minibuffer-new)
               (cell:new (if (== (cfgt:.config-repl-language config) "lisp")
                             "Lisp" "Coalton"))
               (cell:new None) (native-box-new)
               (cell:new (cfgt:.config-structural-editing config)) config
               (cell:new False) (cell:new None) (complete:completion-new)
               (cell:new None) (spinner:spinner-new)
               (cell:new 0) (cell:new 0) (cell:new 0) (cell:new True)
               (cell:new None) (cell:new qr:QuickResultHidden) (cell:new None)
               (native-box-new) (native-box-new)
               (cell:new hm:empty) (cell:new None) (requests:request-state-new)
               (cell:new None) (cell:new None)))

  (declare activate-buffer! (MineState * buf:Buffer -> Void))
  (define (activate-buffer! st buffer)
    "Switch documents while preserving each document's cursor, selection, and viewport."
    (let bid = (buf:buffer-id buffer))
    (when (not (== (cell:read (.ms-view-buffer st)) (Some bid)))
      (complete:completion-dismiss! (.ms-completion st))
      (match (cell:read (.ms-view-buffer st))
        ((Some (buf:BufferId previous))
         (let saved = (editor:editor-pane-save-view (.ms-editor st) (.ms-cursor st)))
         (cell:update! (fn (views) (hm:insert views previous saved)) (.ms-editor-views st))
         (values))
        ((None) (values)))
      (match bid
        ((buf:BufferId id)
         (let saved = (match (hm:lookup (cell:read (.ms-editor-views st)) id)
                        ((Some saved) saved)
                        ((None) (editor:editor-pane-save-view (editor:editor-pane-new)
                                                               (cursor:cursor-new)))))
         (editor:editor-pane-set-buffer! (.ms-editor st) bid)
         (editor:editor-pane-restore-view! (.ms-editor st) (buf:buffer-gap buffer)
                                           (.ms-cursor st) saved)))
      (cell:write! (.ms-view-buffer st) (Some bid)))
    (mgr:bufmgr-switch! (.ms-bufmgr st) bid)
    (values))

  (declare forget-buffer-view! (MineState * buf:BufferId -> Void))
  (define (forget-buffer-view! st bid)
    (match bid
      ((buf:BufferId id)
       (cell:update! (fn (views) (hm:remove views id)) (.ms-editor-views st))))
    (when (== (cell:read (.ms-view-buffer st)) (Some bid))
      (cell:write! (.ms-view-buffer st) None))
    (values))

;;; Named accessors for CL interop

  (declare get-status-bar (MineState -> status:StatusBar))
  (define (get-status-bar st) (.ms-status st))

  (declare get-pending-error-cell (MineState -> (Cell (Optional String))))
  (define (get-pending-error-cell st) (.ms-pending-error st))

  (declare get-editor-pane (MineState -> editor:EditorPane))
  (define (get-editor-pane st) (.ms-editor st))

  (declare get-bufmgr (MineState -> mgr:BufferManager))
  (define (get-bufmgr st) (.ms-bufmgr st))

  (declare get-cursor-state (MineState -> cursor:CursorState))
  (define (get-cursor-state st) (.ms-cursor st))

  (declare get-repl-pane (MineState -> repl:ReplPane))
  (define (get-repl-pane st) (.ms-repl st))

  (declare get-focus-mgr (MineState -> focus:FocusManager))
  (define (get-focus-mgr st) (.ms-focus st))

  (declare get-repl-package-cell (MineState -> (Cell String)))
  (define (get-repl-package-cell st) (.ms-repl-package st))

  (declare get-repl-lang-cell (MineState -> (Cell String)))
  (define (get-repl-lang-cell st) (.ms-repl-lang st))

  (declare get-runtime-mgr (MineState -> lifecycle:RuntimeManager))
  (define (get-runtime-mgr st) (.ms-runtime st))

  (declare get-eval-start-time-cell (MineState -> (Cell UFix)))
  (define (get-eval-start-time-cell st) (.ms-eval-start-time st))

  (declare get-proto-mailbox (MineState -> NativeBox))
  (define (get-proto-mailbox st) (.ms-proto-mailbox st))

  (declare get-proto-thread (MineState -> NativeBox))
  (define (get-proto-thread st) (.ms-proto-thread st))

  (declare get-bg-proto-thread (MineState -> NativeBox))
  (define (get-bg-proto-thread st) (.ms-bg-proto-thread st))

  (declare get-debugger-condition-cell (MineState -> (Cell String)))
  (define (get-debugger-condition-cell st) (.ms-debugger-condition st))

  (declare get-debugger-snapshot-cell (MineState -> Cell (Optional msg:DebuggerSnapshot)))
  (define (get-debugger-snapshot-cell st) (.ms-debugger-snapshot st))

  (declare get-debugger-selected-cell (MineState -> (Cell UFix)))
  (define (get-debugger-selected-cell st) (.ms-debugger-selected st))

  (declare get-debugger-scroll-cell (MineState -> (Cell UFix)))
  (define (get-debugger-scroll-cell st) (.ms-debugger-scroll st))

  (declare get-debugger-body-h-cell (MineState -> (Cell UFix)))
  (define (get-debugger-body-h-cell st) (.ms-debugger-body-h st))

  (declare get-debugger-total-cell (MineState -> (Cell UFix)))
  (define (get-debugger-total-cell st) (.ms-debugger-total st))

  (declare get-debugger-follow-cell (MineState -> (Cell Boolean)))
  (define (get-debugger-follow-cell st) (.ms-debugger-follow st))

  (declare get-debugger-request-id-cell (MineState -> Cell (Optional msg:RequestId)))
  (define (get-debugger-request-id-cell st) (.ms-debugger-request-id st))

  (declare get-jump-stack (MineState -> Cell (List requests:SourceLocation)))
  (define (get-jump-stack st) (.ms-jump-stack st))

  (declare get-next-req-id-cell (MineState -> (Cell UFix)))
  (define (get-next-req-id-cell st) (.ms-next-req-id st))

  (declare get-io-request-data (MineState -> Cell (Optional msg:InputRequest)))
  (define (get-io-request-data st) (.ms-io-request-data st))

  (declare get-layout-cell (MineState -> (Cell MineLayout)))
  (define (get-layout-cell st) (.ms-layout st))

  (declare get-completion (MineState -> complete:CompletionState))
  (define (get-completion st) (.ms-completion st))

  (declare get-content-x-cell (MineState -> (Cell UFix)))
  (define (get-content-x-cell st) (.ms-content-x st))

  (declare get-quick-result-state (MineState -> Cell qr:QuickResultState))
  (define (get-quick-result-state st) (.ms-quick-result-state st))

  (declare get-quick-result-request-id-cell (MineState -> Cell (Optional msg:RequestId)))
  (define (get-quick-result-request-id-cell st) (.ms-quick-result-request-id st))

  (declare get-requests (MineState -> requests:RequestState))
  (define (get-requests st) (.ms-requests st))

  (declare get-active-request-cell (MineState -> Cell (Optional msg:RequestId)))
  (define (get-active-request-cell st) (.ms-active-request st))
  (declare get-debugger-active-cell (MineState -> Cell Boolean))
  (define (get-debugger-active-cell st) (.ms-debugger-active st))
