(cl:defpackage #:mine/edit/operations
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
   (#:gap #:mine/buffer/gap)
   (#:buf #:mine/buffer/buffer)
   (#:cursor #:mine/edit/cursor)
   (#:undo #:mine/edit/undo)
   (#:str #:coalton/string))
  (:export
   #:replace-range!
   #:undo! #:redo!
   #:insert-char! #:insert-string!
   #:delete-backward! #:delete-backward-word! #:delete-forward!))

(in-package #:mine/edit/operations)

(coalton-toplevel

  (declare replace-range! (buf:Buffer * undo:UndoTree * cursor:CursorState
                           * UFix * UFix * String * UFix -> Void))
  (define (replace-range! buffer tree cs start end text cursor-after)
    "Apply one editor replacement, preserving CRLF units and coherent undo state.
CURSOR-AFTER is an absolute position in the resulting document."
    (let gb = (buf:buffer-gap buffer))
    (let before = (gap:gap-editor-unit-end-pos gb (cursor:cursor-position cs)))
    (let range =
      (if (== start end)
          (progn
            (let p = (gap:gap-editor-unit-end-pos gb start))
            (Tuple p p))
          (gap:gap-expand-range-to-editor-units gb (min start end) (max start end))))
    (match range
      ((Tuple first last)
       (buf:buffer-replace-range! buffer tree first last text before cursor-after)
       (cursor:cursor-move-to-buffer-position! gb cs cursor-after)
       (cursor:cursor-clear-selection! cs)
       (values))))

  (declare insert-char! (buf:Buffer * undo:UndoTree * cursor:CursorState * Char -> Void))
  (define (insert-char! buffer tree cs ch)
    (insert-string! buffer tree cs (into ch)))

  (declare insert-string! (buf:Buffer * undo:UndoTree * cursor:CursorState * String -> Void))
  (define (insert-string! buffer tree cs text)
    "Insert text at a clamped editor-unit boundary as one undo step."
    (let gb = (buf:buffer-gap buffer))
    (let pos = (gap:gap-editor-unit-end-pos gb (cursor:cursor-position cs)))
    (replace-range! buffer tree cs pos pos text (+ pos (str:length text))))

  (declare delete-backward! (buf:Buffer * undo:UndoTree * cursor:CursorState -> Void))
  (define (delete-backward! buffer tree cs)
    (let gb = (buf:buffer-gap buffer))
    (let pos = (gap:gap-editor-unit-end-pos gb (cursor:cursor-position cs)))
    (cursor:cursor-move-to-buffer-position! gb cs pos)
    (when (> pos 0)
      (let start = (gap:gap-editor-unit-prev-pos gb pos))
      (replace-range! buffer tree cs start pos "" start)))

  (declare delete-backward-word! (buf:Buffer * undo:UndoTree * cursor:CursorState -> Void))
  (define (delete-backward-word! buffer tree cs)
    (let gb = (buf:buffer-gap buffer))
    (let pos = (gap:gap-editor-unit-end-pos gb (cursor:cursor-position cs)))
    (cursor:cursor-move-to-buffer-position! gb cs pos)
    (when (> pos 0)
      (cursor:cursor-move-word-left! gb cs)
      (let start = (cursor:cursor-position cs))
      (cursor:cursor-move-to-buffer-position! gb cs pos)
      (replace-range! buffer tree cs start pos "" start)))

  (declare delete-forward! (buf:Buffer * undo:UndoTree * cursor:CursorState -> Void))
  (define (delete-forward! buffer tree cs)
    (let gb = (buf:buffer-gap buffer))
    (let pos = (gap:gap-editor-unit-start-pos gb (cursor:cursor-position cs)))
    (cursor:cursor-move-to-buffer-position! gb cs pos)
    (when (< pos (gap:gap-length gb))
      (replace-range! buffer tree cs pos (gap:gap-editor-unit-next-pos gb pos) "" pos)))

  (declare apply-inverse-ops! (gap:GapBuffer * List undo:EditOp -> Void))
  (define (apply-inverse-ops! gb edits)
    (match edits
      ((Nil) (values))
      ((Cons op rest)
       (match op
         ((undo:OpInsert pos text)
          (gap:gap-delete-range! gb pos (+ pos (str:length text)))
          (values))
         ((undo:OpDelete pos text)
          (gap:gap-insert-string! gb pos text)))
       (apply-inverse-ops! gb rest))))

  (declare apply-history! (buf:Buffer * cursor:CursorState * Optional undo:UndoEntry -> Boolean))
  (define (apply-history! buffer cs entry)
    (match entry
      ((None) False)
      ((Some (undo:UndoEntry edits before _))
       (let gb = (buf:buffer-gap buffer))
       (apply-inverse-ops! gb edits)
       (cursor:cursor-move-to-buffer-position! gb cs before)
       (cursor:cursor-clear-selection! cs)
       (buf:buffer-sync-dirty! buffer)
       True)))

  (declare undo! (buf:Buffer * cursor:CursorState -> Boolean))
  (define (undo! buffer cs)
    "Undo a document transaction, updating cursor, dirty state, and diagnostics."
    (apply-history! buffer cs (undo:undo-undo! (buf:buffer-undo buffer))))

  (declare redo! (buf:Buffer * cursor:CursorState -> Boolean))
  (define (redo! buffer cs)
    "Redo a document transaction, updating cursor, dirty state, and diagnostics."
    (apply-history! buffer cs (undo:undo-redo! (buf:buffer-undo buffer)))))
