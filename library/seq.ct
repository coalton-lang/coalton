(coalton/utils:defstdlib-package #:coalton/seq
  (:documentation "Persistent sequences based on relaxed radix balanced trees.")
  (:use
   #:coalton
   #:coalton/builtin
   #:coalton/functions
   #:coalton/classes)
  (:local-nicknames
   (#:math #:coalton/math)
   (#:optional #:coalton/optional)
   (#:cell #:coalton/cell)
   (#:vector #:coalton/vector)
   (#:iter #:coalton/iterator)
   (#:show #:coalton/show))
  (:export
   #:Seq
   #:new
   #:push
   #:pop
   #:size
   #:get
   #:put
   #:empty?
   #:conc
   #:make
   #:fold-range
   #:map-with))

(in-package #:coalton/seq)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

;;;;
;;; This module implements a persistent sequence data type based on
;;; Relaxed Radix Balanced Trees, introduced by Phillip Bagwell
;;; See: 
;;; https://www.semanticscholar.org/paper/RRB-Trees%3A-Efficient-Immutable-Vectors-Bagwell-Rompf/30c8c562f6421ab6b00d0b7faebd897c407de69c
;;; 

(coalton-toplevel 
  ;;
  ;; Seq
  ;; 
  
  (declare max-branching UFix)
  (define max-branching 32)

  (declare min-branching UFix)
  (define min-branching 24)

  (define-type (Seq :a)
    (RelaxedNode
     UFix                               ; height
     UFix                               ; cached full subtree size
     (vector:Vector UFix)               ; cumulative size table
     (vector:Vector (Seq :a)))         ; subtrees
    (LeafArray (vector:Vector :a)))

  (declare new (Void -> Seq :a))
  (define (new)
    "Create a new empty `Seq`."
    (LeafArray (vector:new)))

  (declare size (Seq :a -> UFix))
  (define (size seq)
    "Return the number of elements in the `seq`."
    (match seq
      ((RelaxedNode _ _ cst _) (vector:last-unsafe cst))
      ((LeafArray leaves) (vector:length leaves))))
  
  (declare empty? (Seq :a -> Boolean))
  (define (empty? seq)
    (math:zero? (size seq)))

  (declare get (Seq :a * UFix -> Optional :a))
  (define (get seq idx)
    "Get the member of `seq` at index `idx`, or `None` if `idx` is at least
`(size seq)`."
    (match seq
      ((LeafArray leaves)
       (vector:index idx leaves))
      
      ((RelaxedNode _ fss cst sts)
       (do
        (let guess = (math:div idx fss))
        ((Tuple subtree-idx offset) <- (cst-search guess cst idx))
         (subtree <- (vector:index subtree-idx sts))
         (get subtree (- idx offset))))))
  
  (declare put (Seq :a * UFix * :a -> Optional (Seq :a)))
  (define (put seq idx a)
    "If `idx` is less than `(size seq)`, Return a new `seq` whose `idx` position
contains `a`."
    (match seq
      ((LeafArray leaves)
       (if (<= (vector:length leaves) idx)
           None
           (let ((newleaves (vector:copy leaves)))
             (vector:set! idx a newleaves)
             (Some (LeafArray newleaves)))))

      ((RelaxedNode h fss cst sts)
       (do
        (let guess = (math:div idx fss))
        ((Tuple subtree-idx offset) <- (cst-search guess cst idx))
         (subtree <- (vector:index subtree-idx sts))
         (new-subtree <- (put subtree (- idx offset) a))
         (let ((newsts (vector:copy sts)))
           (vector:set! subtree-idx new-subtree newsts)
           (pure (RelaxedNode h fss cst newsts)))))))

  (declare push (Seq :a * :a -> Seq :a))
  (define (push seq a)
    "Push `a` onto the end of `seq`, returning a new `Seq` instance."
    (let (values node in-place?) = (%push seq a))
    (if in-place? node
        (let ((h (+ (the UFix 1) (height seq)))
              (s (size seq)))
          (RelaxedNode h (perfect-subtree-size-at-height h)
                       (vector:make s (+ (the UFix 1) s))
                       (vector:make seq node)))))

  (declare pop (Seq :a -> Optional (Tuple :a (Seq :a))))
  (define (pop seq)
    "If `seq` is empty, return `None`. Otherwise, the last member of `seq` and
a new `Seq` instance."
    (match (%pop seq)
      ((Some (Tuple x rest)) (Some (Tuple x (%collapse rest))))
      ((None) None)))

  (declare conc (Seq :a * Seq :a -> Seq :a))
  (define (conc left right)
    "Concatenate two `Seq`s"
    (cond
      ((empty? left) right)
      ((empty? right) left)
      (True
       (let ((lh (height left))
             (rh (height right)))
         ;; Merge the right edge of LEFT with the left edge of RIGHT,
         ;; recursively, then rebalance the subtrees at each level. The
         ;; recursive concatenation can be shorter or taller than the
         ;; subtrees it replaces, so it is converted to subtrees of their
         ;; height first.
         (cond
           ((< lh rh)
            (let ((rsubs (%subtrees right)))
              (rebalance-branches
               (vector:append (%subtrees-of-height (- rh 1) (conc left (vector:head-unsafe rsubs)))
                              (butfirst rsubs)))))
           ((> lh rh)
            (let ((lsubs (%subtrees left)))
              (rebalance-branches
               (vector:append (butlast lsubs)
                              (%subtrees-of-height (- lh 1) (conc (vector:last-unsafe lsubs) right))))))
           ((== lh 1)
            (rebalance-branches (vector:make left right)))
           (True
            (let ((lsubs (%subtrees left))
                  (rsubs (%subtrees right)))
              (rebalance-branches
               (vector:append
                (vector:append (butlast lsubs)
                               (%subtrees-of-height
                                (- lh 1)
                                (conc (vector:last-unsafe lsubs) (vector:head-unsafe rsubs))))
                (butfirst rsubs))))))))))

  ;;
  ;; Folding over ranges, and mapping in chunks
  ;;

  (declare fold-range ((:b * :a -> :b) * :b * Seq :a * UFix * UFix -> :b))
  (define (fold-range f init seq start end)
    "Fold `f` over the elements of `seq` at indices from `start` (inclusive)
to `end` (exclusive), in order, starting with `init`, as `fold` does over
all of the elements. Indices from `(size seq)` on are ignored. This takes
time proportional to the number of elements folded, plus the height of
`seq`."
    (let ((stop (min end (size seq))))
      (if (< start stop)
          (%fold-range f init seq start stop)
          init)))

  (declare map-with ((UFix * UFix * (UFix * UFix -> Void) -> Void)
                     * (:a -> :b) * Seq :a -> Seq :b))
  (define (map-with for-chunks f seq)
    "Apply `f` to every element of `seq`, as `map` does, using `for-chunks`
to divide the work.

Unless `seq` is empty, `for-chunks` is called once, with the indices 0
and `(size seq)` and a function of two indices. It must call that
function on disjoint, nonempty chunks of indices, each given by its
first index and the index after its last, that together cover the
indices from its first argument to its second, and return once all of
these calls have returned. The calls may happen in any order, and at the
same time, so `for-chunks` can make them in parallel, as
`coalton/threads/parallel:for-chunks!` does. `f` is only called within
these calls.

The result has the same structure as `seq`. Each leaf of the tree is
mapped by the call on the chunk containing its first index."
    (match seq
      ((LeafArray leaves)
       (if (vector:empty? leaves)
           (LeafArray (map f leaves))
           (let ((result (cell:new (LeafArray (vector:new)))))
             (for-chunks 0 (vector:length leaves)
                         (fn (start _)
                           (when (math:zero? start)
                             (cell:write! result (LeafArray (map f leaves)))
                             (values))))
             (cell:read result))))
      ((RelaxedNode _ _ _ _)
       (let ((result (%map-skeleton (LeafArray (vector:new)) seq)))
         (unless (empty? seq)
           (for-chunks 0 (size seq)
                       (fn (start end)
                         (%map-leaves f seq result 0 start end))))
         result))))

  ;;
  ;; Instances
  ;; 

  (define-instance (Semigroup (Seq :a))
    (define (<> a b)
      (conc a b)))
  
  (define-instance (Monoid (Seq :a))
    (define mempty (new)))

  (define-instance (iter:IntoIterator (Seq :a) :a)
    (define (iter:into-iter seq)
      (let ((leaves (%leaves seq))
            (leaf (cell:new (vector:new)))
            (index (cell:new 0)))
        (iter:with-size
         (fn ()
           (rec % ()
             (let ((v (cell:read leaf))
                   (i (cell:read index)))
               (if (< i (vector:length v))
                   (progn
                     (cell:write! index (+ i 1))
                     (Some (vector:index-unsafe i v)))
                   (match (iter:next! leaves)
                     ((Some next)
                      (cell:write! leaf next)
                      (cell:write! index 0)
                      (%))
                     ((None) None))))))
         (size seq)))))

  (define-instance (Functor Seq)
    (define (map f seq)
      (match seq
        ((LeafArray v) (LeafArray (map f v)))
        ((RelaxedNode ht fss cst subs)
         (RelaxedNode ht fss cst (map (fn (sub) (map f sub)) subs))))))

  (define-instance (Foldable Seq)
    (define (fold f init seq)
      (match seq
        ((LeafArray leaves) (fold f init leaves))
        ((RelaxedNode _ _ _ subs)
         (fold (fn (acc sub) (fold f acc sub)) init subs))))
    (define (foldr f init seq)
      (match seq
        ((LeafArray leaves) (foldr f init leaves))
        ((RelaxedNode _ _ _ subs)
         (foldr (fn (sub acc) (foldr f acc sub)) init subs)))))

  (define-instance (iter:FromIterator (Seq :a) :a)
    (define (iter:collect! it)
      (%from-vector (iter:collect! it))))

  ;; The builders collect the elements in a vector, and build the tree
  ;; at the end, in time proportional to the number of elements.

  (define-instance (FromItemizedCollection (Seq :a) :a (vector:Vector :a))
    (define (begin-collection-builder _ size)
      (vector:with-capacity size))
    (define (adjoin-to-collection-builder _ elements _index item)
      (vector:push! item elements)
      elements)
    (define (finalize-collection-builder _ elements)
      (%from-vector elements)))

  (define-instance (FromItemizedAssociation (Seq (Tuple :key :value))
                                            :key
                                            :value
                                            (vector:Vector (Tuple :key :value)))
    (define (begin-association-builder _ size)
      (vector:with-capacity size))
    (define (adjoin-to-association-builder _ entries _index key value)
      (vector:push! (Tuple key value) entries)
      entries)
    (define (finalize-association-builder _ entries)
      (%from-vector entries)))

  (define-instance (FromCollectionComprehension (Seq :a) :a (vector:Vector :a))
    (define (begin-collection-comprehension _ size-hint)
      (vector:with-capacity (with-default 0 size-hint)))
    (define (adjoin-to-collection-comprehension _ elements item)
      (vector:push! item elements)
      elements)
    (define (finalize-collection-comprehension _ elements)
      (%from-vector elements)))

  (define-instance (FromAssociationComprehension (Seq (Tuple :key :value))
                                                 :key
                                                 :value
                                                 (vector:Vector (Tuple :key :value)))
    (define (begin-association-comprehension _ size-hint)
      (vector:with-capacity (with-default 0 size-hint)))
    (define (adjoin-to-association-comprehension _ entries key value)
      (vector:push! (Tuple key value) entries)
      entries)
    (define (finalize-association-comprehension _ entries)
      (%from-vector entries)))

  (define-instance (Default (Seq :a))
    (define (default)
      (new)))

  (overlap)
  (define-instance (Foldable :f => Into (:f :a) (Seq :a))
    (define (into fld)
      (%from-vector (fold (fn (elements x)
                            (vector:push! x elements)
                            elements)
                          (vector:new)
                          fld))))

  ;; Resolve the intersection with Into :a :a without rebuilding the sequence.
  (overlap)
  (define-instance (Into (Seq :a) (Seq :a))
    (define (into seq) seq))


  (define-instance (Eq :a => Eq (Seq :a))
    (define (== a b)
      ;; because they're immutable, if they happen to be identical then == is true
      (or (lisp (-> Boolean) (a b) (cl:eq a b))
          ;; otherwise, compare their elements, leaf by leaf
          (and (== (size a) (size b))
               (%leaves-equal? (%leaves a) (%leaves b))))))

  (define-instance (show:Show :a => show:Show (Seq :a))
    (define (show:show-to f seq)
      (f "#<Seq [")
      (let items = (iter:into-iter seq))
      (match (iter:next! items)
        ((None)
         (values))
        ((Some item)
         (show:show-to f item)
         (rec % ()
           (match (iter:next! items)
             ((None)
              (values))
             ((Some next-item)
              (f " ")
              (show:show-to f next-item)
              (%))))))
      (f "]>")))

  (define-instance (Into (Seq :a) (List :a))
    (define (into seq)
      (foldr Cons Nil seq)))

  (define-instance (Into (Seq :a) (vector:Vector :a))
    (define (into seq)
      (fold (fn (elements x)
              (vector:push! x elements)
              elements)
            (vector:with-capacity (size seq))
            seq)))

  ;;
  ;; Helpers
  ;; 

  (define (height seq)
    (match seq
      ;;relaxed nodes should have a minimum height of 2
      ((RelaxedNode h _ _ _) h)
      ((LeafArray _) (the UFix 1))))

  ;; helper. Calculate the capacity of a subtree of node
  (define (perfect-subtree-size-at-height h)
    (math:^ max-branching (- h (the UFix 1))))

  ;; helper. Return the index into a Relaxed Node's subtree array, as
  ;; well as the offset to subtract from the search index.
  (define (cst-search guess cst idx)
    (let ((search-forward
            (fn (gs last-cumulative)
              (do (cumulative <- (vector:index gs cst))
                  (if (< idx cumulative)
                      (pure (Tuple gs last-cumulative))
                      (search-forward (+ (the UFix 1) gs) cumulative)))))) 
      (>>= (alt (if (math:zero? guess)  ; avoid UFix underflow
                    None
                    (vector:index (- guess (the UFix 1)) cst)) ; Note, 0 < guess <= 31
                (pure (the UFix 0)))
           (fn (last-cumulative)
             (search-forward guess last-cumulative)))))  

  (declare %first-child-ending-after (vector:Vector UFix * UFix -> UFix))
  (define (%first-child-ending-after cst index)
    "The position of the first subtree that ends after `index`, in a node
whose cumulative size table is `cst`, or the number of subtrees if there
is none."
    (rec % ((i 0))
      (if (or (>= i (vector:length cst))
              (> (vector:index-unsafe i cst) index))
          i
          (% (+ i 1)))))

  (declare %fold-range ((:b * :a -> :b) * :b * Seq :a * UFix * UFix -> :b))
  (define (%fold-range f init seq start end)
    "Fold `f` over the elements of `seq` at indices from `start` to `end`,
where `end` is at most `(size seq)`."
    (match seq
      ((LeafArray leaves)
       (rec % ((i start) (acc init))
         (if (>= i end)
             acc
             (% (+ i 1) (f acc (vector:index-unsafe i leaves))))))
      ((RelaxedNode _ _ cst subs)
       (rec % ((i (%first-child-ending-after cst start)) (acc init))
         (let ((sub-start (if (math:zero? i) 0 (vector:index-unsafe (- i 1) cst))))
           (if (or (>= i (vector:length subs)) (>= sub-start end))
               acc
               (let ((sub-end (vector:index-unsafe i cst)))
                 (% (+ i 1)
                    (%fold-range f acc (vector:index-unsafe i subs)
                                 (- (max start sub-start) sub-start)
                                 (- (min end sub-end) sub-start))))))))))

  (declare %map-skeleton (Seq :b * Seq :a -> Seq :b))
  (define (%map-skeleton placeholder seq)
    "A tree with the structure and size tables of `seq`, whose leaves are
all `placeholder`."
    (match seq
      ((LeafArray _) placeholder)
      ((RelaxedNode h fss cst subs)
       (RelaxedNode h fss cst (map (fn (sub) (%map-skeleton placeholder sub)) subs)))))

  (declare %map-leaves ((:a -> :b) * Seq :a * Seq :b * UFix * UFix * UFix -> Void))
  (define (%map-leaves f seq result offset start end)
    "Store in `result`, a tree with the structure of `seq`, the leaves of
`seq` mapped with `f` whose first index is from `start` (inclusive) to
`end` (exclusive). The first element of `seq` has the index `offset`."
    (match seq
      ((LeafArray _) (values))
      ((RelaxedNode _ _ cst subs)
       (match result
         ((LeafArray _) (unreachable))
         ((RelaxedNode _ _ _ results)
          (rec % ((i (%first-child-ending-after cst (if (> start offset) (- start offset) 0))))
            (let ((sub-start (+ offset (if (math:zero? i) 0 (vector:index-unsafe (- i 1) cst)))))
              (when (and (< i (vector:length subs)) (< sub-start end))
                (match (vector:index-unsafe i subs)
                  ((LeafArray leaves)
                   (when (>= sub-start start)
                     (vector:set! i (LeafArray (map f leaves)) results)))
                  (sub
                   (%map-leaves f sub (vector:index-unsafe i results) sub-start start end)))
                (% (+ i 1))))))))))

  (declare %pop (Seq :a -> Optional (Tuple :a (Seq :a))))
  (define (%pop seq)
    "Like `pop`, but the new tree has the height of `seq`, unless it is
empty, in which case it is an empty leaf."
    (match seq
      ((LeafArray leaves)
       (let ((n (vector:length leaves)))
         (if (math:zero? n)
             None
             (let ((newleaves (vector:copy leaves)))
               (let ((x (vector:index-unsafe (- n 1) newleaves)))
                 (%truncate! newleaves (- n 1))
                 (Some (Tuple x (LeafArray newleaves))))))))
      ((RelaxedNode h fss cst sts)
       (do
        ((Tuple x newsub) <- (%pop (vector:last-unsafe sts)))
        (let newsts = (vector:copy sts))
        (let newcst = (vector:copy cst))
        (let last-idx = (- (vector:length sts) 1))
         (pure
          (Tuple x
                 (cond
                   ((not (empty? newsub))
                    (vector:set! last-idx newsub newsts)
                    (vector:set! last-idx (- (vector:index-unsafe last-idx newcst) 1) newcst)
                    (RelaxedNode h fss newcst newsts))
                   ;; The last subtree is now empty: drop it.
                   ((math:zero? last-idx)
                    (LeafArray (vector:new)))
                   (True
                    (%truncate! newsts last-idx)
                    (%truncate! newcst last-idx)
                    (RelaxedNode h fss newcst newsts)))))))))

  (declare %truncate! (vector:Vector :a * UFix -> Void))
  (define (%truncate! v n)
    "Remove the elements of `v` from index `n` on. Their slots are cleared, so
that `v` no longer refers to them, and they can be garbage collected."
    (lisp (-> Void) (v n)
      (cl:let ((end (cl:fill-pointer v)))
        (cl:when (cl:< n end)
          (cl:fill v cl:nil :start n :end end)
          (cl:setf (cl:fill-pointer v) n)))
      (cl:values)))

  (declare %collapse (Seq :a -> Seq :a))
  (define (%collapse seq)
    "`seq`, without the nodes with a single subtree at its root."
    (match seq
      ((RelaxedNode _ _ _ sts)
       (if (== 1 (vector:length sts))
           (%collapse (vector:index-unsafe 0 sts))
           seq))
      ((LeafArray _) seq)))

  (declare %subtrees (Seq :a -> vector:Vector (Seq :a)))
  (define (%subtrees seq)
    "The subtrees of `seq`, which must be a node. The vector must not be modified."
    (match seq
      ((RelaxedNode _ _ _ subs) subs)
      ((LeafArray _) (unreachable))))

  (declare %subtrees-of-height (UFix * Seq :a -> vector:Vector (Seq :a)))
  (define (%subtrees-of-height h seq)
    "Subtrees of height `h` whose concatenation is `seq`, whose height must be
at most `h + 1`. The vector must not be modified."
    (let ((sh (height seq)))
      (cond
        ((== sh h) (vector:make seq))
        ((== sh (+ h 1)) (%subtrees seq))
        ((< sh h) (%subtrees-of-height h (make-relaxed-node (+ sh 1) (vector:make seq))))
        (True (unreachable)))))

  (declare %from-vector (vector:Vector :a -> Seq :a))
  (define (%from-vector elements)
    "A `Seq` of the elements of `elements`, whose leaves are full, except the
last. `elements` is not modified."
    (let ((n (vector:length elements))
          (leaves (vector:with-capacity (math:div (+ n (- max-branching 1)) max-branching))))
      (for ((start 0 (+ start max-branching)))
        :while (< start n)
        (let ((end (min n (+ start max-branching))))
          (let ((leaf (vector:with-capacity (- end start))))
            (for ((i start (+ i 1)))
              :while (< i end)
              (vector:push! (vector:index-unsafe i elements) leaf)
              (values))
            (vector:push! (LeafArray leaf) leaves)
            (values))))
      (make-node-from-branches leaves)))

  (declare %leaves (Seq :a -> iter:Iterator (vector:Vector :a)))
  (define (%leaves seq)
    "An iterator over the vectors of elements in the leaves of `seq`, in
order. They must not be modified."
    (let ((pending (cell:new (make-list seq))))
      (iter:new
       (fn ()
         (rec % ()
           (match (cell:read pending)
             ((Nil) None)
             ((Cons next rest)
              (match next
                ((LeafArray v)
                 (cell:write! pending rest)
                 (Some v))
                ((RelaxedNode _ _ _ subs)
                 (cell:write! pending (foldr Cons rest subs))
                 (%))))))))))

  (declare %leaves-equal? (Eq :a => iter:Iterator (vector:Vector :a) * iter:Iterator (vector:Vector :a)
                                      -> Boolean))
  (define (%leaves-equal? as bs)
    "Do `as` and `bs`, the leaves of two `Seq`s of the same size, hold equal
elements?"
    (rec % ((va (vector:new)) (ia 0) (vb (vector:new)) (ib 0))
      (cond
        ((>= ia (vector:length va))
         (match (iter:next! as)
           ((Some v) (% v 0 vb ib))
           ((None) True)))
        ((>= ib (vector:length vb))
         (match (iter:next! bs)
           ((Some v) (% va ia v 0))
           ((None) False)))
        ((== (vector:index-unsafe ia va) (vector:index-unsafe ib vb))
         (% va (+ ia 1) vb (+ ib 1)))
        (True False))))

  (declare %prefix (Seq :a * UFix -> List :a))
  (define (%prefix seq n)
    "The first `n` elements of `seq`, or all of them if there are fewer."
    (fold (fn (acc x) (Cons x acc))
          Nil
          (fold-range (fn (acc x) (Cons x acc)) Nil seq 0 n)))

  (declare %push (Seq :a * :a -> (Seq :a) * Boolean))
  (define (%push seq a)
    (match seq
      ((LeafArray v)
       (if (< (vector:length v) max-branching)
           (let ((newv (vector:copy v)))
             (vector:push! a newv)
             (values (LeafArray newv) True))
           (values (LeafArray (vector:make a)) False)))
      
      ((RelaxedNode h fss cst sts)
       (progn
         (let (values new-node in-place?) = (%push (vector:last-unsafe sts) a))
         (cond
           ;; modified "in place": i.e. height not adjusted on recursive step
           (in-place?
            (let ((newsts
                    (vector:copy sts))
                  (newcst
                    (vector:copy cst))
                  (last-idx
                    (- (vector:length sts) (the UFix 1))))
              (vector:set! last-idx (+ (the UFix 1) (vector:last-unsafe newcst)) newcst)
              (vector:set! last-idx new-node newsts)
              (values (RelaxedNode h fss newcst newsts) True)))

           ;; wasn't in place, but there's room here
           ((< (vector:length cst) max-branching)
            (let ((newsts
                    (vector:copy sts))
                  (newcst
                    (vector:copy cst)))
              (vector:push! (+ (the UFix 1) (size seq)) newcst)
              (vector:push! new-node newsts)
              (values (RelaxedNode h fss newcst newsts) True)))

           ;; not in place, and no room here.
           (True
            (let ((newh (+ (the UFix 1) (height new-node))))
              (values
               (RelaxedNode newh
                            (perfect-subtree-size-at-height newh)
                            (vector:make (the UFix 1))
                            (vector:make new-node))
               False))))))))

  (declare group-vectors (UFix * vector:Vector :a -> vector:Vector (vector:Vector :a)))
  (define (group-vectors len vec)
    "Return a vector of vectors of elements from `vec`, each of length `len`
ecxept for the last one which has a nonzero length less than or equal
to `len`."
    (lisp (-> (vector:Vector (vector:Vector :a))) (len vec)
      (cl:let ((result (cl:make-array 0 :fill-pointer 0 :adjustable cl:t :element-type cl:t))
               (vec-len (cl:length vec)))
        (cl:cond
          ((cl:zerop vec-len)
           result)
          ((cl:zerop len)
           (cl:vector-push-extend (alexandria:copy-array vec) result)
           result)
          (cl:t
           (cl:loop
             :with start = 0
             :while (cl:< start vec-len)
             :do
                (cl:let* ((end (cl:min vec-len (cl:+ start len)))
                          (chunk-len (cl:- end start))
                          (chunk (cl:make-array chunk-len
                                                :fill-pointer chunk-len
                                                :adjustable cl:t
                                                :element-type cl:t)))
                  (cl:replace chunk vec :start2 start :end2 end)
                  (cl:vector-push-extend chunk result)
                  (cl:setf start end)))
           result)))))

  (declare build-cumulative-size-table (vector:Vector (Seq :a) -> vector:Vector UFix))
  (define (build-cumulative-size-table subtrees)
    (let ((cumulative (cell:new (the UFix 0))))
      (iter:collect!
       (map (fn (sub)
              (let ((ret (+ (size sub) (cell:read cumulative))))
                (cell:swap! cumulative ret)
                ret))
            (iter:into-iter subtrees)))))

  (declare %shift-n-onto! (vector:Vector :a * vector:Vector :a * UFix -> Void))
  (define (%shift-n-onto! target source n0)
    "Shifts the first `n` members of `source` onto the end of `target`, and
shifts the each member of `target` down by `n` positions.  Mutates both
`target` and `source`. If `n` is greater than or equal to the length of the
`source`, then the entire `source` is so shifted."
    (let ((source-len
            (vector:length source))
          (n
            (min n0 source-len)))
      (iter:for-each!
       (fn (i)
         (vector:push! (vector:index-unsafe i source) target)
         (iter:for-each!
          (fn (j)
            (do
             (x <- (vector:index (+ j n) source))
             (let (values) = (vector:set! j x source))
             (pure Unit))
            (values))
          (iter:range-increasing n i source-len))
         (values))
       (iter:up-to n))
      (%truncate! source (- source-len n))))

  (declare butfirst (vector:Vector :a -> vector:Vector :a))
  (define (butfirst v)
    (vector:subseq v (the UFix 1) (vector:length v)))

  (define (butlast v)
    (let ((cv (vector:copy v)))
      (%truncate! cv (- (vector:length cv) 1))
      cv))
  
  (define (branch-count seq)
    ;; Count subtrees rather than entries of the size table, which is
    ;; stale while rebalancing moves subtrees between nodes.
    (match seq
      ((LeafArray v) (vector:length v))
      ((RelaxedNode _ _ _ subs) (vector:length subs))))

  (define (%shift-n-branches-onto seq1 seq2 n)
        "Moves `n` subbranches from the front of `seq2` to the back of
`seq1`. Leaves both in a potentially dirty state: the cumulative size
table of relaxed nodes may be inaccurate. `seq2` may furthermore be
invalid because size can no longer be applied correctly."
    (match (Tuple seq1 seq2)
      ((Tuple (LeafArray vec1) (LeafArray vec2))
       (%shift-n-onto! vec1 vec2 n)
       (values))
      ((Tuple (RelaxedNode _ _ _ vec1) (RelaxedNode _ _ _ vec2))
       (%shift-n-onto! vec1 vec2 n)
       (values))
      (_ (unreachable)))
    (values))

  (define (rebuild-size-table seq)
    (match seq
      ((LeafArray _) seq)
      ((RelaxedNode ht fss _ subs)
       (RelaxedNode ht fss (build-cumulative-size-table subs) subs))))

  (define (make-relaxed-node ht branches)
    (RelaxedNode ht (perfect-subtree-size-at-height ht) (build-cumulative-size-table branches) branches))
  
  (declare make-node-from-branches (vector:Vector (Seq :a) -> Seq :a))
  (define (make-node-from-branches branches)
    "Makes a `Seq` tall enough to contain all the branches. Branches are
all assumed to have the same height."
    (cond ((vector:empty? branches)
           (LeafArray (vector:new)))
          ((vector:singleton? branches)
           (vector:pop-unsafe! branches))
          (True 
           (let ht = (height (vector:head-unsafe branches)))
           (if (<= (vector:length branches) max-branching)
               (make-relaxed-node (+ ht (the UFix 1)) branches)
               (let ((groups
                       (group-vectors max-branching branches))
                     (taller-branches
                       (map (fn (group) (make-relaxed-node (+ ht (the UFix 1)) group)) groups)))
                 (make-node-from-branches taller-branches))))))

  (define (copy seq)
    "A shallow copy of `seq`"
    (match seq
      ((LeafArray vec)
       (LeafArray (vector:copy vec)))
      ((RelaxedNode ht fss cst seq)
       (RelaxedNode ht fss (vector:copy cst) (vector:copy seq)))))

  (declare rebalance-branches (vector:Vector (Seq :a) -> Seq :a))
  (define (rebalance-branches branches)
    "Ensures each member of `branches` has between `min-branching` and
`max-branching` subnodes of their own. Returns a new `Seq` whose branches
are the rebalanced `branches`. 

This function assumes that each member of `branches` has the same
height. It also assumes that each member of `branches` is itself already
balanced.

It attempts to rebalance with a minimum of array copying."
    (let count = (vector:length branches))
    (let result = (vector:new))
    (let cached-branch = (cell:new None))
    (iter:for-each!
     (fn (i)
       (let branch =
         (match (cell:read cached-branch)
           ((None) (vector:index-unsafe i branches))
           ((Some cached) cached)))
       (let subbranch-count = (branch-count branch))
       (let rebuilt =
         (cond
           ((or (== i (- count (the UFix 1)))
                (<= min-branching subbranch-count))
            (cell:swap! cached-branch None)
            (rebuild-size-table branch))
           (True
            (let this-branch =
              (if (optional:some? (cell:read cached-branch))
                  branch
                  (copy branch)))
            (let next-branch =
              (copy (vector:index-unsafe (+ i (the UFix 1)) branches)))
            (%shift-n-branches-onto
             this-branch next-branch (- min-branching subbranch-count))
            (cell:swap! cached-branch (Some next-branch))
            (rebuild-size-table this-branch))))
       ;; `size` can observe transiently invalid branches during rebalancing.
       ;; `branch-count` is robust here and still drops empty branches.
       (unless (math:zero? (branch-count rebuilt))
         (vector:push! rebuilt result)
         (values))
       (values))
     (iter:up-to count))
    (make-node-from-branches result))

  )

(define-expression-macro make (cl:&rest elems)
  "Create a new `Seq` containing `elems`."
  `(%from-vector (vector:make ,@elems)))

;; This method uses :around because sum types implement cl:print-object
;; for each representation. The :around method short-circuits them, to
;; print the elements rather than the tree that holds them.
(cl:defmethod cl:print-object :around ((self seq) stream)
  (cl:let* ((limit cl:*print-length*)
            (count (size self))
            ;; One element more than printed shows that some are elided.
            (elements (%prefix self (cl:if (cl:and limit (cl:< limit count))
                                          (cl:1+ limit)
                                          count))))
    (cl:print-unreadable-object (self stream :type cl:nil)
      (cl:write-string "SEQ [" stream)
      (cl:loop :for element :in elements
               :for count :from 0
               :do (cl:unless (cl:zerop count)
                     (cl:write-char #\Space stream))
                   (cl:when (cl:and limit (cl:>= count limit))
                     (cl:write-string "..." stream)
                     (cl:return))
                   (cl:prin1 element stream))
      (cl:write-string "]" stream)))
  self)

#+sb-package-locks
(sb-ext:lock-package "COALTON/SEQ")
