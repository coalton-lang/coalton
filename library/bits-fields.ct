;;;; bits-fields.ct
;;;;
;;;; Operations on bit fields of `Bits' instances. They convert their
;;;; `UFix' sizes and positions into `Integer' shift counts with `into',
;;;; whose instance is defined by coalton/math, which is compiled after
;;;; bits.ct, so they are defined here instead.

(in-package #:coalton/bits)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (inline)
  (declare ldb (Bits :a => UFix * UFix * :a -> :a))
  (define (ldb size position x)
    "Extract the `size`-bit field of `x` that starts at bit `position`:

```
(ldb size position x) = wrap (ldb (byte size position) x)
```

where the right-hand side is the Common Lisp `ldb` and `wrap` is as in
`Bits`. A field that is narrower than the type and lies within its
width is returned as a non-negative value."
    (and (shift (coalton/math:negate (into position)) x)
         (not (shift (into size) (not (xor x x))))))

  (inline)
  (declare dpb (Bits :a => :a * UFix * UFix * :a -> :a))
  (define (dpb new size position x)
    "Replace the `size`-bit field of `x` that starts at bit `position` with the low `size` bits of `new`:

```
(dpb new size position x) = wrap (dpb new (byte size position) x)
```

where the right-hand side is the Common Lisp `dpb` and `wrap` is as in
`Bits`. Together with `ldb`, it satisfies the following laws for all
values `a`, `n`, and `m`, sizes `s`, and positions `p`, where `w` is the
width of the type:

```
(dpb (ldb s p a) s p a) = a
(dpb m s p (dpb n s p a)) = (dpb m s p a)
(ldb s p (dpb n s p a)) = (ldb s 0 n)    ; when s + p <= w
```"
    (let ((p (the Integer (into position)))
          (field (not (shift (into size) (not (xor x x))))))
      (let ((mask (shift p field)))
        ;; Take the bits of the shifted NEW where MASK is set and the bits
        ;; of X elsewhere, without complementing MASK.
        (xor x (and (xor (shift p new) x) mask)))))

  (inline)
  (declare bit-length (coalton/math:Integral :a => :a -> UFix))
  (define (bit-length x)
    "The number of bits needed to represent `x` in two's complement without its sign bit:

```
(bit-length x) = (cl:integer-length (toInteger x))
```

For $x \\ge 0$, this is the smallest non-negative integer $k$ such that $x < 2^k$, so `(bit-length 0) = 0` and `(bit-length x) = 1 + (ilog 2 x)` for $x > 0$. For $x < 0$, `(bit-length x) = (bit-length (not x))`."
    (let ((n (coalton/math:toInteger x)))
      (coalton++:unsafe
        (lisp (-> UFix) (n)
          (cl:integer-length n))))))

(cl:defmacro %define-bit-length-specialization (type)
  (cl:let ((spec-name (alexandria:format-symbol cl:*package* "%~A-BIT-LENGTH" type)))
    `(coalton-toplevel
       (specialize bit-length ,spec-name (,type -> UFix))
       (inline)
       (declare ,spec-name (,type -> UFix))
       (define (,spec-name x)
         (coalton++:unsafe
           (lisp (-> UFix) (x)
             (cl:integer-length x)))))))

(%define-bit-length-specialization Bit)
(%define-bit-length-specialization U8)
(%define-bit-length-specialization U16)
(%define-bit-length-specialization U32)
(%define-bit-length-specialization UFix)
(%define-bit-length-specialization U64)
(%define-bit-length-specialization I8)
(%define-bit-length-specialization I16)
(%define-bit-length-specialization I32)
(%define-bit-length-specialization IFix)
(%define-bit-length-specialization I64)
(%define-bit-length-specialization Integer)
