;;;; arith.lisp
;;;;
;;;; Number types and basic arithmetic.

(coalton/utils:defstdlib-package #:coalton/math/arith
  (:documentation "Division (`Reciprocable`, `Dividable`), conjugation (`ConjugateRing`), scaling and linear spaces (`Scale`, `Module`, `VectorSpace`, `InnerSpace`), transfinite and IEEE floating-point values (`Transfinite`, `IEEEFloat`), and basic arithmetic predicates and operations.")
  (:use
   #:coalton
   #:coalton/builtin
   #:coalton/classes
   #:coalton/functions
   #:coalton/utils)
  (:export
   #:Reciprocable
   #:/
   #:recip
   #:reciprocal
   #:Dividable
   #:general/
   #:ConjugateRing
   #:conjugate
   #:Scale
   #:scale
   #:Module
   #:VectorSpace
   #:InnerSpace
   #:inner-product
   #:Transfinite
   #:infinity
   #:infinite?
   #:finite?
   #:negative-infinity
   #:IEEEFloat
   #:nan
   #:nan?
   #:neg
   #:negate
   #:abs
   #:sign
   #:ash
   #:1+
   #:1-
   #:positive?
   #:negative?
   #:nonpositive?
   #:nonnegative?
   #:zero?
   #:nonzero?))

(in-package #:coalton/math/arith)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  ;;
  ;; Division
  ;;

  (define-class (Ring :a => Reciprocable :a)
    "A `Ring` with a partial multiplicative inverse `recip` and division `/`.

When every nonzero element is invertible, `:a` is a **division ring** (or **skew field**), and if multiplication is commutative, a **field**. Rings whose units are a subset of the nonzero elements (such as local rings like `Dual`, `Hyperdual`, and `PowerSeries`) may also implement `Reciprocable` by signaling a run-time error on non-units.

Laws (for invertible `x` and `y`):
- Inverse: `(* (recip x) x) == (* x (recip x)) == one`
- Division: `(/ x y) == (* x (recip y))`

If no reciprocal exists for an element (i.e., `zero` in a field or division ring, or non-units in rings like `Dual` or `PowerSeries`), produce a run-time error."
    (/ (:a * :a -> :a))
    (recip (:a -> :a)))

  (inline)
  (declare reciprocal (Reciprocable :a => :a -> :a))
  (define (reciprocal x)
    "An alias for `recip`."
    (recip x))

  (define-class (Dividable :arg-type :res-type)
    "Division of two elements of `:arg-type` producing a `:res-type` (for example, `(Dividable Integer Fraction)` or `(Dividable F32 F32)`).

`general/` is partial and signals a run-time error if the divisor is zero."
    (general/ (:arg-type * :arg-type -> :res-type)))

  (define-instance (Reciprocable :a => Dividable :a :a)
    (inline)
    (define (general/ a b) (/ a b)))

  ;;
  ;; Conjugation (*-Rings), Scaling, Modules, and Vector Spaces
  ;;

  (define-class (Ring :a => ConjugateRing :a)
    "A `Ring` equipped with an involutive anti-automorphism `conjugate` (also known as a \"star ring\" or $\\ast$-ring).

For real types, `conjugate` is the identity function; for complex numbers $a + bi$, it is $a - bi$.

Laws:
- Involution: `(conjugate (conjugate x)) == x`
- Additivity: `(conjugate (+ x y)) == (+ (conjugate x) (conjugate y))`
- Anti-multiplicativity: `(conjugate (* x y)) == (* (conjugate y) (conjugate x))`
- Identity: `(conjugate one) == one`"
    (conjugate (:a -> :a)))

  (define-class (Scale :s :v)
    "Left scaling action of a scalar `:s` on a value `:v`."
    (scale (:s * :v -> :v)))

  (define-class ((Ring :r) (AdditiveGroup :m) (Scale :r :m) => Module :r :m)
    "An `AdditiveGroup` `:m` equipped with a linear scaling action by a `Ring` `:r`.

Laws:
- Left distributivity: `(scale r (+ x y)) == (+ (scale r x) (scale r y))`
- Right distributivity: `(scale (+ r s) x) == (+ (scale r x) (scale s x))`
- Compatibility: `(scale (* r s) x) == (scale r (scale s x))`
- Identity: `(scale one x) == x`")

  (define-class ((Reciprocable :k) (Module :k :v) => VectorSpace :k :v (:v -> :k))
    "A `Module` `:v` over a scalar division ring / field (`Reciprocable`) `:k`.")

  (define-class ((ConjugateRing :k) (VectorSpace :k :v) => InnerSpace :k :v (:v -> :k))
    "A `VectorSpace` over a `ConjugateRing` scalar `:k` equipped with a (possibly Hermitian) inner product.

Laws:
- Conjugate symmetry: `(inner-product x y) == (conjugate (inner-product y x))`
- Linearity in second argument: `(inner-product x (+ (scale c y) z)) == (+ (* c (inner-product x y)) (inner-product x z))`
- Non-degeneracy: `(inner-product x x) == zero` iff `x == zero`"
    (inner-product (:v * :v -> :k)))

  (define-class (Transfinite :a)
    "Types with a representation of positive infinity and finiteness predicates.

For types with `AdditiveGroup :a`, `negative-infinity` is `(neg infinity)`. For types without indeterminate values, `(finite? x)` is `(not (infinite? x))`; for types that also implement `IEEEFloat`, `(finite? nan)` is `False`."
    (infinity :a)
    (infinite? (:a -> Boolean))
    (finite? (:a -> Boolean)))

  (define-class (Transfinite :a => IEEEFloat :a)
    "Floating-point types supporting an IEEE 754 indeterminate Not-a-Number (`nan`) value.

Laws:
- `(nan? nan) == True`
- `(finite? nan) == False`
- `(infinite? nan) == False`"
    (nan :a)
    (nan? (:a -> Boolean)))

  (declare negative-infinity ((Transfinite :a) (AdditiveGroup :a) => :a))
  (define negative-infinity
    (neg infinity))

  (define-instance (Transfinite F32)
    (define infinity
      (coalton++:unsafe
        (lisp (-> F32) ()
          float-features:single-float-positive-infinity)))
    (inline)
    (define (infinite? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          (float-features:float-infinity-p x))))
    (inline)
    (define (finite? x)
      (not (or (infinite? x) (nan? x)))))

  (define-instance (IEEEFloat F32)
    (define nan
      (coalton++:unsafe
        (lisp (-> F32) ()
          float-features:single-float-nan)))
    (inline)
    (define (nan? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          #+(not allegro)
          (float-features:float-NaN-p x)
          #+allegro
          (cl:and (float-features:float-NaN-p x) cl:t)))))

  (define-instance (Transfinite F64)
    (define infinity
      (coalton++:unsafe
        (lisp (-> F64) ()
          float-features:double-float-positive-infinity)))
    (inline)
    (define (infinite? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          (float-features:float-infinity-p x))))
    (inline)
    (define (finite? x)
      (not (or (infinite? x) (nan? x)))))

  (define-instance (IEEEFloat F64)
    (define nan
      (coalton++:unsafe
        (lisp (-> F64) ()
          float-features:double-float-nan)))
    (inline)
    (define (nan? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          #+(not allegro)
          (float-features:float-NaN-p x)
          #+allegro
          (cl:and (float-features:float-NaN-p x) cl:t)))))

  (inline)
  (declare abs ((Ord :a) (AdditiveGroup :a) => :a -> :a))
  (define (abs x)
    "Absolute value of `x`."
    (if (< x zero)
        (neg x)
        x))

  (inline)
  (declare sign ((Ord :a) (Additive :a) (AdditiveGroup :b) (Multiplicative :b) => :a -> :b))
  (define (sign x)
    "The sign of `x`, where `(sign zero) == zero`."
    (cond
      ((positive? x) one)
      ((negative? x) (neg one))
      (True zero)))

  (inline)
  (declare ash (Integer * Integer -> Integer))
  (define (ash x n)
    "Compute the \"arithmetic shift\" of `x` by `n`."
    (coalton++:unsafe
      (lisp (-> Integer) (x n) (cl:ash x n))))

  (inline)
  (declare 1+ ((Additive :num) (Multiplicative :num) => :num -> :num))
  (define (1+ num)
    "Increment `num`."
    (+ num one))

  (inline)
  (declare 1- ((AdditiveGroup :num) (Multiplicative :num) => :num -> :num))
  (define (1- num)
    "Decrement `num`."
    (- num one))

  (inline)
  (declare positive? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (positive? x)
    "Is `x` positive?"
    (> x zero))

  (inline)
  (declare negative? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (negative? x)
    "Is `x` negative?"
    (< x zero))

  (inline)
  (declare nonpositive? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (nonpositive? x)
    "Is `x` not positive?"
    (<= x zero))

  (inline)
  (declare nonnegative? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (nonnegative? x)
    "Is `x` not negative?"
    (>= x zero))

  (inline)
  (declare zero? ((Eq :a) (Additive :a) => :a -> Boolean))
  (define (zero? x)
    "Is `x` zero?"
    (== x zero))

  (inline)
  (declare nonzero? ((Eq :a) (Additive :a) => :a -> Boolean))
  (define (nonzero? x)
    "Is `x` not zero?"
    (/= x zero)))

(cl:defmacro %define-sign-native (type)
  (cl:let ((sign-spec (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-SIGN"))))
    `(cl:progn
       (coalton-toplevel
         (specialize sign ,sign-spec (,type -> ,type))
         (inline)
         (declare ,sign-spec (,type -> ,type))
         (define (,sign-spec n)
           (coalton++:unsafe
             (lisp (-> ,type) (n)
               (cl:signum n))))))))

(cl:defmacro %define-abs-native (type)
  (cl:let ((abs (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ABS"))))
    `(cl:progn
       (coalton-toplevel
         (specialize abs ,abs (,type -> ,type))
         (inline)
         (declare ,abs (,type -> ,type))
         (define (,abs n)
           (coalton++:unsafe
             (lisp (-> ,type) (n)
               (cl:abs n))))))))

(%define-sign-native Bit)
(%define-sign-native Integer)
(%define-sign-native I8)
(%define-sign-native I16)
(%define-sign-native I32)
(%define-sign-native I64)
(%define-sign-native IFix)
(%define-sign-native U8)
(%define-sign-native U16)
(%define-sign-native U32)
(%define-sign-native U64)
(%define-sign-native UFix)
(%define-sign-native Fraction)
(%define-sign-native F32)
(%define-sign-native F64)

(%define-abs-native Integer)
(%define-abs-native I8)
(%define-abs-native I16)
(%define-abs-native I32)
(%define-abs-native I64)
(%define-abs-native IFix)
(%define-abs-native U8)
(%define-abs-native U16)
(%define-abs-native U32)
(%define-abs-native U64)
(%define-abs-native UFix)
(%define-abs-native Fraction)
(%define-abs-native F32)
(%define-abs-native F64)

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/ARITH")
