;;;; arith.lisp
;;;;
;;;; Number types and basic arithmetic.

(coalton/utils:defstdlib-package #:coalton/math/arith
  (:use
   #:coalton
   #:coalton/builtin
   #:coalton/classes
   #:coalton/functions
   #:coalton/utils)
  (:export
   #:Reciprocable
   #:/
   #:reciprocal
   #:Dividable
   #:general/
   #:Scale
   #:scale
   #:Module
   #:VectorSpace
   #:InnerSpace
   #:inner-product
   #:fromNat
   #:Transfinite
   #:infinity
   #:infinite?
   #:finite?
   #:negative-infinity
   #:nan
   #:nan?
   #:negate
   #:abs
   #:sign
   #:ash
   #:1+
   #:1-
   #:positive?
   #:negative?
   #:nonpositive?
   #:nonnegative?
   #:zero?
   #:nonzero?))

(in-package #:coalton/math/arith)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  ;;
  ;; Division
  ;;

  (define-class (Num :a => Reciprocable :a)
    "A `Num` where nonzero elements have a multiplicative inverse `reciprocal`.

Laws:
- Inverse (for nonzero `x`): `(* (reciprocal x) x) == (* x (reciprocal x)) == one`
- Division: `(/ x y) == (* x (reciprocal y))`

If no reciprocal exists for an element, produce a run-time error (e.g., zero)."
    (/ (:a * :a -> :a))
    (reciprocal (:a -> :a)))

  (define-class (Dividable :arg-type :res-type)
    "Division of two elements of `:arg-type` producing a `:res-type` (for example, `(Dividable Integer Fraction)` or `(Dividable F32 F32)`).

`general/` is partial and signals a run-time error if the divisor is zero."
    (general/ (:arg-type * :arg-type -> :res-type)))

  (define-instance (Reciprocable :a => Dividable :a :a)
    (inline)
    (define (general/ a b) (/ a b)))

  ;;
  ;; Scaling, Modules, and Vector Spaces
  ;;

  (define-class (Scale :s :v)
    "Left scaling action of a scalar `:s` on a value `:v`."
    (scale (:s * :v -> :v)))

  (define-class ((Ring :r) (AdditiveGroup :m) (Scale :r :m) => Module :r :m)
    "An `AdditiveGroup` `:m` equipped with a linear scaling action by a `Ring` `:r`.

Laws:
- Left distributivity: `(scale r (+ x y)) == (+ (scale r x) (scale r y))`
- Right distributivity: `(scale (+ r s) x) == (+ (scale r x) (scale s x))`
- Compatibility: `(scale (* r s) x) == (scale r (scale s x))`
- Identity: `(scale one x) == x`")

  (define-class ((Reciprocable :k) (Module :k :v) => VectorSpace :k :v (:v -> :k))
    "A `Module` `:v` over a scalar division ring / field (`Reciprocable`) `:k`.")

  (define-class (VectorSpace :k :v => InnerSpace :k :v (:v -> :k))
    "A `VectorSpace` equipped with an inner product (dot product).

Laws:
- Linearity: `(inner-product x (+ (scale c y) z)) == (+ (* c (inner-product x y)) (inner-product x z))`
- Zero: `(inner-product zero zero) == zero`"
    (inner-product (:v * :v -> :k)))

  (declare fromNat (Semiring :a => UFix -> :a))
  (define (fromNat n)
    "Embed a natural number `n` into any `Semiring` by repeated addition of `one`."
    (if (lisp (-> Boolean) (n) (cl:zerop n))
        zero
        (rec % ((k n) (base one) (acc zero))
          (if (lisp (-> Boolean) (k) (cl:= k 1))
              (+ base acc)
              (let ((half (lisp (-> UFix) (k) (cl:ash k -1)))
                    (odd-bit (lisp (-> Boolean) (k) (cl:oddp k))))
                (% half
                   (+ base base)
                   (if odd-bit (+ base acc) acc)))))))

  (define-class (Transfinite :a)
    "Numeric type with a value for (positive) infinity and/or NaN."
    (infinity :a)
    (infinite? (:a -> Boolean))
    (nan :a)
    (nan? (:a -> Boolean)))

  (declare finite? ((Transfinite :a) => :a -> Boolean))
  (define (finite? x)
    "Neither infinite or NaN."
    (not (or (infinite? x) (nan? x))))

  (declare negative-infinity ((Transfinite :a) (AdditiveGroup :a) => :a))
  (define negative-infinity
    (negate infinity))

  (define-instance (Transfinite F32)
    (define infinity
      (coalton++:unsafe
        (lisp (-> F32) ()
          float-features:single-float-positive-infinity)))
    (define nan
      (coalton++:unsafe
        (lisp (-> F32) ()
          float-features:single-float-nan)))
    (inline)
    (define (nan? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          #+(not allegro)
          (float-features:float-NaN-p x)
          #+allegro
          (cl:and (float-features:float-NaN-p x) cl:t))))
    (inline)
    (define (infinite? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          (float-features:float-infinity-p x)))))

  (define-instance (Transfinite F64)
    (define infinity
      (coalton++:unsafe
        (lisp (-> F64) ()
          float-features:double-float-positive-infinity)))
    (define nan
      (coalton++:unsafe
        (lisp (-> F64) ()
          float-features:double-float-nan)))
    (inline)
    (define (nan? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          #+(not allegro)
          (float-features:float-NaN-p x)
          #+allegro
          (cl:and (float-features:float-NaN-p x) cl:t))))
    (inline)
    (define (infinite? x)
      (coalton++:unsafe
        (Lisp (-> Boolean) (x)
          (float-features:float-infinity-p x)))))

  (inline)
  (declare abs ((Ord :a) (AdditiveGroup :a) => :a -> :a))
  (define (abs x)
    "Absolute value of `x`."
    (if (< x zero)
        (negate x)
        x))

  (inline)
  (declare sign ((Ord :a) (Additive :a) (Ring :b) => :a -> :b))
  (define (sign x)
    "The sign of `x`, where `(sign zero) == zero`."
    (cond
      ((positive? x) one)
      ((negative? x) (negate one))
      (True zero)))

  (inline)
  (declare ash (Integer * Integer -> Integer))
  (define (ash x n)
    "Compute the \"arithmetic shift\" of `x` by `n`."
    (coalton++:unsafe
      (lisp (-> Integer) (x n) (cl:ash x n))))

  (inline)
  (declare 1+ ((Semiring :num) => :num -> :num))
  (define (1+ num)
    "Increment `num`."
    (+ num one))

  (inline)
  (declare 1- ((Ring :num) => :num -> :num))
  (define (1- num)
    "Decrement `num`."
    (- num one))

  (inline)
  (declare positive? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (positive? x)
    "Is `x` positive?"
    (> x zero))

  (inline)
  (declare negative? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (negative? x)
    "Is `x` negative?"
    (< x zero))

  (inline)
  (declare nonpositive? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (nonpositive? x)
    "Is `x` not positive?"
    (<= x zero))

  (inline)
  (declare nonnegative? ((Additive :a) (Ord :a) => :a -> Boolean))
  (define (nonnegative? x)
    "Is `x` not negative?"
    (>= x zero))

  (inline)
  (declare zero? ((Eq :a) (Additive :a) => :a -> Boolean))
  (define (zero? x)
    "Is `x` zero?"
    (== x zero))

  (inline)
  (declare nonzero? ((Eq :a) (Additive :a) => :a -> Boolean))
  (define (nonzero? x)
    "Is `x` not zero?"
    (/= x zero)))

(cl:defmacro %define-sign-native (type)
  (cl:let ((sign-spec (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-SIGN"))))
    `(cl:progn
       (coalton-toplevel
         (specialize sign ,sign-spec (,type -> ,type))
         (inline)
         (declare ,sign-spec (,type -> ,type))
         (define (,sign-spec n)
           (coalton++:unsafe
             (lisp (-> ,type) (n)
               (cl:signum n))))))))

(cl:defmacro %define-abs-native (type)
  (cl:let ((abs (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ABS"))))
    `(cl:progn
       (coalton-toplevel
         (specialize abs ,abs (,type -> ,type))
         (inline)
         (declare ,abs (,type -> ,type))
         (define (,abs n)
           (coalton++:unsafe
             (lisp (-> ,type) (n)
               (cl:abs n))))))))

(%define-sign-native Bit)
(%define-sign-native Integer)
(%define-sign-native I8)
(%define-sign-native I16)
(%define-sign-native I32)
(%define-sign-native I64)
(%define-sign-native IFix)
(%define-sign-native U8)
(%define-sign-native U16)
(%define-sign-native U32)
(%define-sign-native U64)
(%define-sign-native UFix)
(%define-sign-native Fraction)
(%define-sign-native F32)
(%define-sign-native F64)

(%define-abs-native Integer)
(%define-abs-native I8)
(%define-abs-native I16)
(%define-abs-native I32)
(%define-abs-native I64)
(%define-abs-native IFix)
(%define-abs-native U8)
(%define-abs-native U16)
(%define-abs-native U32)
(%define-abs-native U64)
(%define-abs-native UFix)
(%define-abs-native Fraction)
(%define-abs-native F32)
(%define-abs-native F64)

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/ARITH")
