;;;; integral.lisp
;;;;
;;;; Integral domains and operations on integers

(coalton/utils::defstdlib-package #:coalton/math/integral
  (:documentation "GCD domains (`GcdDomain`), Euclidean domains (`EuclideanDomain`), integer division and remainder (`Remainder`, `Integral`), greatest common divisors (`gcd`, `lcm`, `extended-gcd`), and integer exponentiation (`^`, `^^`).")
  (:use
   #:coalton
   #:coalton/classes
   #:coalton/builtin
   #:coalton/math/arith)
  (:import-from
   #:coalton/bits #:Bits)
  (:local-nicknames
   (#:bits #:coalton/bits))
  (:export
   #:GcdDomain
   #:Field
   #:unit-part
   #:normal-part
   #:exact-quot
   #:exact-div
   #:EuclideanDomain
   #:euclidean-degree
   #:euclidean-exact-quot
   #:euclidean-gcd
   #:Remainder
   #:Integral
   #:div
   #:mod
   #:divmod
   #:quot
   #:rem
   #:quotrem
   #:to-integer
   #:integral->num
   #:from-nat
   #:lsh
   #:rsh
   #:even?
   #:odd?
   #:^
   #:^^
   #:gcd
   #:lcm
   #:extended-gcd
   #:factorial
   #:isqrt
   #:ilog))


(in-package #:coalton/math/integral)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (define-class (CommutativeRing :a => GcdDomain :a)
    "A commutative domain with canonical unit normalization (`unit-part`, `normal-part`), exact division (`exact-quot`), and greatest common divisors (`gcd`).

Examples include integers $\\mathbb{Z}$ (`Integer`), Gaussian integers $\\mathbb{Z}[i]$ (`Complex Integer`), univariate and multivariate polynomials over a GCD domain such as $\\mathbb{Z}[x]$ (`Polynomial Integer`) and $\\mathbb{Z}[x][y]$ (`Polynomial (Polynomial Integer)`), and fields such as $\\mathbb{Q}$ (`Fraction`).

Laws:
- Unit decomposition: `x == (* (unit-part x) (normal-part x))`
- Normalization idempotence: `(normal-part (normal-part x)) == (normal-part x)`
- Zero normalization: `(normal-part zero) == zero` and `(unit-part zero) == one`
- Exact division: for `b /= zero`, `(exact-quot a b) == (Some q)` iff `a == (* b q)`
- Greatest common divisor: `(gcd a b)` is normal, divides both `a` and `b`, and is divisible by every common divisor of `a` and `b`."
    (unit-part (:a -> :a))
    (normal-part (:a -> :a))
    (exact-quot (:a * :a -> Optional :a))
    (gcd (:a * :a -> :a)))

  (define-class ((DivisionRing :a) (GcdDomain :a) => Field :a)
    "An exact commutative division ring. Its canonical normal form for a
nonzero element is `one`; a nonzero divisor divides every element exactly.")

  (declare exact-div (GcdDomain :a => :a * :a -> :a))
  (define (exact-div a b)
    "Divide `a` by an exact divisor `b`, signaling an error if `b` does not divide `a` or `b == zero`."
    (match (exact-quot a b)
      ((Some q) q)
      ((None) (error "Inexact division or division by zero in exact-div."))))

  (declare lcm ((Eq :a) (GcdDomain :a) => :a * :a -> :a))
  (define (lcm a b)
    "The canonical least common multiple of `a` and `b`."
    (if (or (zero? a) (zero? b))
        zero
        (normal-part (* (normal-part a) (exact-div (normal-part b) (gcd a b))))))

  (define-class (QuotRem :a)
    "Quotient and remainder operations, e.g. truncating division on machine
integers. This does not certify a domain or unbounded intermediate arithmetic."
    (quot (:a * :a -> :a))
    (rem (:a * :a -> :a))
    (quotrem (:a * :a -> :a * :a)))

  (define-class ((GcdDomain :a) (QuotRem :a) => EuclideanDomain :a)
    "A `GcdDomain` equipped with a degree/norm measure and Euclidean division with remainder (`quotrem`, `quot`, `rem`).

Laws:
- Division: for `b /= zero`, `a == (+ (* b (quot a b)) (rem a b))`
- Nonnegativity: for `b /= zero`, `(>= (euclidean-degree b) 0)`
- Remainder bound: `(rem a b) == zero` or `(< (euclidean-degree (rem a b)) (euclidean-degree b))`
- Consistency: `(quotrem a b) == (values (quot a b) (rem a b))`"
    (euclidean-degree (:a -> Integer)))

  (declare euclidean-exact-quot ((Eq :a) (EuclideanDomain :a) => :a * :a -> Optional :a))
  (define (euclidean-exact-quot a b)
    "Default implementation of `exact-quot` for any `EuclideanDomain`."
    (if (zero? b)
        None
        (progn
          (let (values q r) = (quotrem a b))
          (if (zero? r)
              (Some q)
              None))))

  (declare euclidean-gcd ((Eq :a) (EuclideanDomain :a) => :a * :a -> :a))
  (define (euclidean-gcd a b)
    "Default implementation of `gcd` for any `EuclideanDomain`."
    (if (zero? b)
        (normal-part a)
        (euclidean-gcd (normal-part b) (normal-part (rem a b)))))

  (define-class (QuotRem :a => Remainder :a)
    "Quotients and remainders with floored division (`div`, `mod`, `divmod`).
These operations are subject to the type's representable range.

Laws:
- Division: for `b /= zero`, `a == (+ (* b (div a b)) (mod a b))`
- Consistency: `(divmod a b) == (values (div a b) (mod a b))`"
    (div (:a * :a -> :a))
    (mod (:a * :a -> :a))
    (divmod (:a * :a -> :a * :a)))

  (define-class ((Remainder :int) (Num :int) (Ord :int) => Integral :int)
    "An ordered integer type supporting floored (`div`) and truncated (`quot`) division and conversion to `Integer`."
    (to-integer (:int -> Integer)))

  (inline)
  (declare integral->num ((Integral :a) (Ring :b) => :a -> :b))
  (define (integral->num n)
    "Converts any `Integral` `n` into any `Ring`."
    (from-int (to-integer n)))

  (declare rsh ((Integral :n) (Bits :b) => :b * :n -> :b))
  (define (rsh x n)
    "Shift `x` right by `n` bits, or left by $-n$ bits when `n` is negative. This is `(bits:shift (neg (to-integer n)) x)`, so on fixed-width types the result fits the width as described for `bits:Bits`."
    (bits:shift (neg (to-integer n)) x))

  (declare lsh ((Integral :n) (Bits :b) => :b * :n -> :b))
  (define (lsh x n)
    "Shift `x` left by `n` bits, or right by $-n$ bits when `n` is negative. This is `(bits:shift (to-integer n) x)`, so on fixed-width types the result fits the width as described for `bits:Bits`."
    (bits:shift (to-integer n) x))

  (declare even? (Integral :a => :a -> Boolean))
  (define (even? n)
    "Is `n` even?"
    (== 0 (mod n 2)))

  (declare odd? (Integral :a => :a -> Boolean))
  (define (odd? n)
    "Is `n` odd?"
    (== 1 (mod n 2)))

  (declare ^ ((Multiplicative :a) (Integral :int) => (:a * :int -> :a)))
  (define (^ base power)
    "Exponentiate `base` to a non-negative `power`."
    (let (
          ;; (g x n b) = (* (x ^ n) b)
          (g 
            (fn (a n b)
              (cond
                ((even? n) (g (* a a) (quot n 2) b))
                ((> n 1) (g (* a a) (quot n 2) (* a b)))
                (True (* a b)))))
          ;; (f a n) = (a ^ n)
          (f
            (fn (a n)
              (cond
                ((even? n) (f (* a a) (quot n 2)))
                ((> n 1) (g (* a a) (quot n 2) a))
                (True a)))))
      (cond
        ((> power 3) (f base power))
        ((== power 3) (* (* base base) base))
        ((== power 2) (* base base))
        ((== power 1) base)
        ((== power 0) one)
        (True (error "Can't exponentiate with a negative exponent.")))))

  (declare ^^ ((Reciprocable :a) (Integral :int) => (:a * :int -> :a)))
  (define (^^ base power)
    "Exponentiate `base` to a signed `power`."
    (if (< power 0)
        (^ (recip base) (neg power))
        (^ base power)))

  (declare extended-gcd ((Eq :a) (EuclideanDomain :a) => :a * :a -> :a * :a * :a))
  (define (extended-gcd a b)
    "Return `(values g s t)` such that `g == (gcd a b) == (+ (* s a) (* t b))`."
    (rec % ((old-r a) (r b)
            (old-s one) (s zero)
            (old-t zero) (t one))
      (if (zero? r)
          (let ((u (unit-part old-r)))
            (values (normal-part old-r)
                    (quot old-s u)
                    (quot old-t u)))
          (progn
            (let (values q rem-r) = (quotrem old-r r))
            (% r rem-r
               s (- old-s (* q s))
               t (- old-t (* q t)))))))

  (declare factorial ((Integral :int) => :int -> :int))
  (define (factorial n)
    "The factorial $n!$ of a non-negative integer `n`."
    (cond
      ((< n 0)
       (error "Cannot FACTORIAL a negative number."))
      (True
       (rec % ((a n) (acc 1))
         (if (== 0 n)
             acc
             (% (- a 1) (* a acc)))))))

  (declare ilog ((Integral :int) => :int * :int -> :int))
  (define (ilog b x)
    "The floor of the logarithm $\\lfloor \\log_b x \\rfloor$ with base $b > 1$ of $x \\geq 1$."
    ;; See GHC's wordLogBase#
    (let ((ilog-rec 
            (fn (y)
              (if (< x y)
                  (the (Tuple :a :a) (Tuple x 0))
                  (match (ilog-rec (* y y))
                    ((Tuple a b)
                     (if (< a y)
                         (Tuple a (* 2 b))
                         (Tuple (quot a y) (+ (* 2 b) 1)))))))))
      (cond
        ((== x 1) 0)
        ((< x 1) (error "Power of ILOG must be greater than or equal to 1."))
        ((<= b 1) (error "Base of ILOG must be greater than 1."))
        (True (match (ilog-rec b) ((Tuple _ b) b))))))

  (declare isqrt ((Integral :int) => :int -> :int))
  (define (isqrt x)
    "The floor of the square root $\\lfloor \\sqrt{x} \\rfloor$ of $x \\geq 0$."
    (let ((isqrt-rec 
            (fn (x0)
              (let ((x1 (div (+ x0 (div x x0)) 2)))
                (if (<= x0 x1)
                    x0
                    (isqrt-rec x1))))))
      (cond
        ((> x 1) (isqrt-rec (div x 2)))
        ((>= x 0) x)
        (True (error "Cannot take ISQRT of a negative number."))))))

(cl:defmacro %define-remainder-native (type)
  `(coalton-toplevel
     (define-instance (QuotRem ,type)
       (inline)
       (define (quot a n)
         (from-int (lisp (-> Integer) (a n) (cl:truncate a n))))
       (inline)
       (define (rem a n)
         (lisp (-> ,type) (a n) (cl:rem a n)))
       (inline)
       (define (quotrem a n)
         (let (values q r) = (lisp (-> Integer * ,type) (a n)
                               (cl:truncate a n)))
         (values (from-int q) r)))

     (define-instance (Remainder ,type)
       (inline)
       (define (div a n)
         (from-int (lisp (-> Integer) (a n) (cl:floor a n))))
       (inline)
       (define (mod a n)
         (lisp (-> ,type) (a n) (cl:mod a n)))
       (inline)
       (define (divmod a n)
         (let (values d m) = (lisp (-> Integer * ,type) (a n)
                               (cl:floor a n)))
         (values (from-int d) m)))))

(cl:defmacro %define-integral-native (type signed)
  (cl:let ((even? (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-EVEN?")))
           (odd? (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ODD?")))
           (^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^")))
           (^^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^^")))
           (isqrt (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ISQRT"))))
    `(cl:progn 
       (%define-remainder-native ,type)
       
       (coalton-toplevel
         (define-instance (Integral ,type)
           (inline)
           (define (to-integer x) (into x)))

         (specialize even? ,even? (,type -> Boolean))
         (inline)
         (declare ,even? (,type -> Boolean))
         (define (,even? n)
           (coalton++:unsafe
             (lisp (-> Boolean) (n) (to-boolean (cl:evenp n)))))

         (specialize odd? ,odd? (,type -> Boolean))
         (inline)
         (declare ,odd? (,type -> Boolean))
         (define (,odd? n)
           (coalton++:unsafe
             (lisp (-> Boolean) (n) (to-boolean (cl:oddp n)))))

         (specialize ^ ,^ (,type * ,type -> ,type))
         (declare ,^ (,type * ,type -> ,type))
         ,(cl:cond
            (signed
             `(define (,^ base power)
                (if (< power 0)
                    (error "Can't exponentiate with a negative exponent.")
                    (coalton++:unsafe
                      (lisp (-> ,type) (base power) (cl:expt base power))))))
            (cl:t
             `(progn
                (inline)
                (define (,^ base power)
                  (coalton++:unsafe
                    (lisp (-> ,type) (base power) (cl:expt base power)))))))

         (specialize ^^ ,^^ (,type * ,type -> ,type))
         (inline)
         (declare ,^^ (,type * ,type -> ,type))
         (define (,^^ base power)
           (coalton++:unsafe
             (lisp (-> ,type) (base power) (cl:expt base power))))

         (specialize isqrt ,isqrt (,type -> ,type))
         (declare ,isqrt (,type -> ,type))
         ,(cl:cond
            (signed
             `(define (,isqrt a)
                (if (< a 0)
                    (error "Can't take ISQRT of a negative number.")
                    (coalton++:unsafe
                      (lisp (-> ,type) (a) (cl:isqrt a))))))
            (cl:t
             `(progn
                (inline)
                (define (,isqrt a)
                  (coalton++:unsafe
                    (lisp (-> ,type) (a) (cl:isqrt a)))))))))))

(%define-integral-native Integer cl:t)
(%define-integral-native I8 cl:t)
(%define-integral-native I16 cl:t)
(%define-integral-native I32 cl:t)
(%define-integral-native I64 cl:t)
(%define-integral-native IFix cl:t)
(%define-integral-native Bit cl:nil)
(%define-integral-native U8 cl:nil)
(%define-integral-native U16 cl:nil)
(%define-integral-native U32 cl:nil)
(%define-integral-native U64 cl:nil)
(%define-integral-native UFix cl:nil)

(coalton-toplevel
  (define-instance (GcdDomain Integer)
    (inline)
    (define (unit-part x) (if (< x 0) -1 1))
    (inline)
    (define (normal-part x) (abs x))
    (inline)
    (define (exact-quot a b) (euclidean-exact-quot a b))
    (inline)
    (define (gcd a b)
      (coalton++:unsafe
        (lisp (-> Integer) (a b) (cl:gcd a b)))))

  (define-instance (EuclideanDomain Integer)
    (inline)
    (define (euclidean-degree x) (abs x)))

  (specialize lcm integer-lcm (Integer * Integer -> Integer))
  (inline)
  (declare integer-lcm (Integer * Integer -> Integer))
  (define (integer-lcm a b)
    (coalton++:unsafe
      (lisp (-> Integer) (a b) (cl:lcm a b)))))

(cl:defmacro %define-native-expt (type)
  (cl:let ((^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^")))
           (^^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^^"))))

    `(coalton-toplevel
       (specialize ^ ,^ (,type * Integer -> ,type))
       (declare ,^ (,type * Integer -> ,type))
       (define (,^ base power)
         (if (< power 0)
             (error "Can't exponentiate with a negative exponent.")
             (coalton++:unsafe
               (lisp (-> ,type) (base power) (cl:expt base power)))))

       (specialize ^^ ,^^ (,type * Integer -> ,type))
       (inline)
       (declare ,^^ (,type * Integer -> ,type))
       (define (,^^ base power)
         (coalton++:unsafe
           (lisp (-> ,type) (base power) (cl:expt base power)))))))

(%define-native-expt Fraction)
(%define-native-expt F32)
(%define-native-expt F64)

(cl:defmacro %define-field-gcd-domain (type)
  `(coalton-toplevel
     (define-instance (GcdDomain ,type)
       (inline)
       (define (unit-part x)
         (if (zero? x) one x))
       (inline)
       (define (normal-part x)
         (if (zero? x) zero one))
       (inline)
       (define (exact-quot a b)
         (if (zero? b)
             None
             (Some (/ a b))))
       (inline)
       (define (gcd a b)
         (if (and (zero? a) (zero? b))
             zero
             one)))))

(%define-field-gcd-domain Fraction)
(%define-field-gcd-domain Bit)

(coalton-toplevel
  (define-instance (Field Fraction))
  (define-instance (Field Bit))

  (declare from-nat (Semiring :a => UFix -> :a))
  (define (from-nat n)
    "Embed a natural number $n$ into any `Semiring` by repeated addition of `one` ($n \\mapsto \\underbrace{1 + \\cdots + 1}_{n}$)."
    (if (== n 0)
        zero
        (rec % ((k n) (base one) (acc zero))
          (if (== k 1)
              (+ base acc)
              (% (quot k 2)
                 (+ base base)
                 (if (odd? k) (+ base acc) acc)))))))

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/INTEGRAL")
