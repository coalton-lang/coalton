;;;; integral.lisp
;;;;
;;;; Integral domains and operations on integers

(coalton/utils::defstdlib-package #:coalton/math/integral
  (:documentation "Euclidean domains (`UnitNormal`, `EuclideanDomain`), integer division and remainder (`Remainder`, `Integral`), greatest common divisors (`gcd`, `lcm`, `extended-gcd`), and integer exponentiation (`^`, `^^`).")
  (:use
   #:coalton
   #:coalton/classes
   #:coalton/builtin
   #:coalton/math/arith)
  (:import-from
   #:coalton/bits #:Bits)
  (:local-nicknames
   (#:bits #:coalton/bits))
  (:export
   #:UnitNormal
   #:unit-part
   #:normal-part
   #:EuclideanDomain
   #:euclidean-degree
   #:Remainder
   #:Integral
   #:div
   #:mod
   #:divMod
   #:quot
   #:rem
   #:quotRem
   #:toInteger
   #:integral->num
   #:lsh
   #:rsh
   #:even?
   #:odd?
   #:^
   #:^^
   #:gcd
   #:lcm
   #:extended-gcd
   #:factorial
   #:isqrt
   #:ilog))


(in-package #:coalton/math/integral)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (define-class (Num :a => UnitNormal :a)
    "A `Num` where every element decomposes into a unit and a canonical associate.

Laws:
- Decomposition: `x == (* (unit-part x) (normal-part x))`
- Idempotence: `(normal-part (normal-part x)) == (normal-part x)`
- Zero: `(normal-part zero) == zero` and `(unit-part zero) == one`"
    (unit-part (:a -> :a))
    (normal-part (:a -> :a)))

  (define-class (UnitNormal :a => EuclideanDomain :a)
    "A domain with a degree/norm measure and Euclidean division (`quotRem`, `quot`, `rem`).

Laws:
- Division: for `b /= zero`, `a == (+ (* b (quot a b)) (rem a b))`
- Remainder bound: `(rem a b) == zero` or `(< (euclidean-degree (rem a b)) (euclidean-degree b))`
- Consistency: `(quotRem a b) == (values (quot a b) (rem a b))`"
    (euclidean-degree (:a -> UFix))
    (quot (:a * :a -> :a))
    (rem (:a * :a -> :a))
    (quotRem (:a * :a -> :a * :a)))

  (define-class (EuclideanDomain :a => Remainder :a)
    "A `EuclideanDomain` that also provides floored division (`div`, `mod`, `divMod`).

Laws:
- Division: for `b /= zero`, `a == (+ (* b (div a b)) (mod a b))`
- Consistency: `(divMod a b) == (values (div a b) (mod a b))`"
    (div (:a * :a -> :a))
    (mod (:a * :a -> :a))
    (divMod (:a * :a -> :a * :a)))

  (define-class ((Remainder :int) (Num :int) (Ord :int) => Integral :int)
    "An ordered integer type supporting floored (`div`) and truncated (`quot`) division and conversion to `Integer`."
    (toInteger (:int -> Integer)))

  (inline)
  (declare integral->num ((Integral :a) (Ring :b) => :a -> :b))
  (define (integral->num n)
    "Converts any `Integral` `n` into any `Ring`."
    (fromInt (toInteger n)))

  (declare rsh ((Integral :n) (Bits :b) => :b * :n -> :b))
  (define (rsh x n)
    "Shift `x` right by `n` bits, or left by `-n` bits when `n` is negative. This is `(bits:shift (negate (toInteger n)) x)`, so on fixed-width types the result fits the width as described for `bits:Bits`."
    (bits:shift (negate (toInteger n)) x))

  (declare lsh ((Integral :n) (Bits :b) => :b * :n -> :b))
  (define (lsh x n)
    "Shift `x` left by `n` bits, or right by `-n` bits when `n` is negative. This is `(bits:shift (toInteger n) x)`, so on fixed-width types the result fits the width as described for `bits:Bits`."
    (bits:shift (toInteger n) x))

  (declare even? (Integral :a => :a -> Boolean))
  (define (even? n)
    "Is N even?"
    (== 0 (mod n 2)))

  (declare odd? (Integral :a => :a -> Boolean))
  (define (odd? n)
    "Is N odd?"
    (== 1 (mod n 2)))

  (declare ^ ((Multiplicative :a) (Integral :int) => (:a * :int -> :a)))
  (define (^ base power)
    "Exponentiate `base` to a non-negative `power`."
    (let (
          ;; (g x n b) = (* (x ^ n) b)
          (g 
            (fn (a n b)
              (cond
                ((even? n) (g (* a a) (quot n 2) b))
                ((> n 1) (g (* a a) (quot n 2) (* a b)))
                (True (* a b)))))
          ;; (f a n) = (a ^ n)
          (f
            (fn (a n)
              (cond
                ((even? n) (f (* a a) (quot n 2)))
                ((> n 1) (g (* a a) (quot n 2) a))
                (True a)))))
      (cond
        ((> power 3) (f base power))
        ((== power 3) (* (* base base) base))
        ((== power 2) (* base base))
        ((== power 1) base)
        ((== power 0) one)
        (True (error "Can't exponentiate with a negative exponent.")))))

  (declare ^^ ((Reciprocable :a) (Integral :int) => (:a * :int -> :a)))
  (define (^^ base power)
    "Exponentiate `base` to a signed `power`."
    (if (< power 0)
        (^ (reciprocal base) (negate power))
        (^ base power)))

  (declare gcd (EuclideanDomain :a => :a * :a -> :a))
  (define (gcd a b)
    "The canonical greatest common divisor of `a` and `b`."
    (if (== b zero)
        (normal-part a)
        (gcd (normal-part b) (normal-part (rem a b)))))

  (declare lcm (EuclideanDomain :a => :a * :a -> :a))
  (define (lcm a b)
    "The canonical least common multiple of `a` and `b`."
    (if (or (== a zero) (== b zero))
        zero
        (* (normal-part a) (quot (normal-part b) (gcd a b)))))

  (declare extended-gcd (EuclideanDomain :a => :a * :a -> :a * :a * :a))
  (define (extended-gcd a b)
    "Return `(values g s t)` such that `g == (gcd a b) == (+ (* s a) (* t b))`."
    (rec % ((old-r a) (r b)
            (old-s one) (s zero)
            (old-t zero) (t one))
      (if (== r zero)
          (let ((u (unit-part old-r)))
            (values (normal-part old-r)
                    (quot old-s u)
                    (quot old-t u)))
          (progn
            (let (values q rem-r) = (quotRem old-r r))
            (% r rem-r
               s (- old-s (* q s))
               t (- old-t (* q t)))))))

  (declare factorial ((Integral :int) => :int -> :int))
  (define (factorial n)
    "The factorial of N."
    (cond
      ((< n 0)
       (error "Cannot FACTORIAL a negative number."))
      (True
       (rec % ((a n) (acc 1))
         (if (== 0 n)
             acc
             (% (- a 1) (* a acc)))))))

  (declare ilog ((Integral :int) => :int * :int -> :int))
  (define (ilog b x)
    "The floor of the logarithm with base B > 1 of X >= 1."
    ;; See GHC's wordLogBase#
    (let ((ilog-rec 
            (fn (y)
              (if (< x y)
                  (the (Tuple :a :a) (Tuple x 0))
                  (match (ilog-rec (* y y))
                    ((Tuple a b)
                     (if (< a y)
                         (Tuple a (* 2 b))
                         (Tuple (quot a y) (+ (* 2 b) 1)))))))))
      (cond
        ((== x 1) 0)
        ((< x 1) (error "Power of ILOG must be greater than or equal to 1."))
        ((<= b 1) (error "Base of ILOG must be greater than 1."))
        (True (match (ilog-rec b) ((Tuple _ b) b))))))

  (declare isqrt ((Integral :int) => :int -> :int))
  (define (isqrt x)
    "The floor of the square root of N > 0."
    (let ((isqrt-rec 
            (fn (x0)
              (let ((x1 (div (+ x0 (div x x0)) 2)))
                (if (<= x0 x1)
                    x0
                    (isqrt-rec x1))))))
      (cond
        ((> x 1) (isqrt-rec (div x 2)))
        ((>= x 0) x)
        (True (error "Cannot take ISQRT of a negative number."))))))

(cl:defmacro %define-remainder-native (type cl:&optional (signed cl:t))
  `(coalton-toplevel
     (define-instance (UnitNormal ,type)
       (inline)
       (define (unit-part x)
         ,(cl:if signed
                 `(if (< x zero) (negate one) one)
                 `(progn x one)))
       (inline)
       (define (normal-part x)
         ,(cl:if signed
                 `(abs x)
                 `x)))

     (define-instance (EuclideanDomain ,type)
       (inline)
       (define (euclidean-degree x)
         (fromInt (lisp (-> Integer) (x) (cl:values (cl:truncate (cl:abs x))))))
       (inline)
       (define (quot a n)
         (fromInt (lisp (-> Integer) (a n) (cl:truncate a n))))
       (inline)
       (define (rem a n)
         (lisp (-> ,type) (a n) (cl:rem a n)))
       (inline)
       (define (quotRem a n)
         (let (values q r) = (lisp (-> Integer * ,type) (a n)
                               (cl:truncate a n)))
         (values (fromInt q) r)))

     (define-instance (Remainder ,type)
       (inline)
       (define (div a n)
         (fromInt (lisp (-> Integer) (a n) (cl:floor a n))))
       (inline)
       (define (mod a n)
         (lisp (-> ,type) (a n) (cl:mod a n)))
       (inline)
       (define (divMod a n)
         (let (values d m) = (lisp (-> Integer * ,type) (a n)
                               (cl:floor a n)))
         (values (fromInt d) m)))))

(cl:defmacro %define-integral-native (type signed)
  (cl:let ((even? (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-EVEN?")))
           (odd? (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ODD?")))
           (gcd (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-GCD")))
           (^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^")))
           (^^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^^")))
           (lcm (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-LCM")))
           (isqrt (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ISQRT"))))
    `(cl:progn 
       (%define-remainder-native ,type ,signed)
       
       (coalton-toplevel
         (define-instance (Integral ,type)
           (inline)
           (define (toInteger x) (into x)))

         (specialize even? ,even? (,type -> Boolean))
         (inline)
         (declare ,even? (,type -> Boolean))
         (define (,even? n)
           (coalton++:unsafe
             (lisp (-> Boolean) (n) (to-boolean (cl:evenp n)))))

         (specialize odd? ,odd? (,type -> Boolean))
         (inline)
         (declare ,odd? (,type -> Boolean))
         (define (,odd? n)
           (coalton++:unsafe
             (lisp (-> Boolean) (n) (to-boolean (cl:oddp n)))))

         (specialize ^ ,^ (,type * ,type -> ,type))
         (declare ,^ (,type * ,type -> ,type))
         ,(cl:cond
            (signed
             `(define (,^ base power)
                (if (< power 0)
                    (error "Can't exponentiate with a negative exponent.")
                    (coalton++:unsafe
                      (lisp (-> ,type) (base power) (cl:expt base power))))))
            (cl:t
             `(progn
                (inline)
                (define (,^ base power)
                  (coalton++:unsafe
                    (lisp (-> ,type) (base power) (cl:expt base power)))))))

         (specialize ^^ ,^^ (,type * ,type -> ,type))
         (inline)
         (declare ,^^ (,type * ,type -> ,type))
         (define (,^^ base power)
           (coalton++:unsafe
             (lisp (-> ,type) (base power) (cl:expt base power))))

         (specialize gcd ,gcd (,type * ,type -> ,type))
         (inline)
         (declare ,gcd (,type * ,type -> ,type))
         (define (,gcd a b)
           (coalton++:unsafe
             (lisp (-> ,type) (a b) (cl:gcd a b))))

         (specialize lcm ,lcm (,type * ,type -> ,type))
         (inline)
         (declare ,lcm (,type * ,type -> ,type))
         (define (,lcm a b)
           ;; Allow Coalton to handle fixnum overflow
           (fromInt (coalton++:unsafe
                      (lisp (-> Integer) (a b) (cl:lcm a b)))))

         (specialize isqrt ,isqrt (,type -> ,type))
         (declare ,isqrt (,type -> ,type))
         ,(cl:cond
            (signed
             `(define (,isqrt a)
                (if (< a 0)
                    (error "Can't take ISQRT of a negative number.")
                    (coalton++:unsafe
                      (lisp (-> ,type) (a) (cl:isqrt a))))))
            (cl:t
             `(progn
                (inline)
                (define (,isqrt a)
                  (coalton++:unsafe
                    (lisp (-> ,type) (a) (cl:isqrt a)))))))))))

(%define-integral-native Integer cl:t)
(%define-integral-native I8 cl:t)
(%define-integral-native I16 cl:t)
(%define-integral-native I32 cl:t)
(%define-integral-native I64 cl:t)
(%define-integral-native IFix cl:t)
(%define-integral-native Bit cl:nil)
(%define-integral-native U8 cl:nil)
(%define-integral-native U16 cl:nil)
(%define-integral-native U32 cl:nil)
(%define-integral-native U64 cl:nil)
(%define-integral-native UFix cl:nil)
(%define-remainder-native Fraction)
(%define-remainder-native F32)
(%define-remainder-native F64)

(cl:defmacro %define-native-expt (type)
  (cl:let ((^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^")))
           (^^ (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-^^"))))

    `(coalton-toplevel
       (specialize ^ ,^ (,type * Integer -> ,type))
       (declare ,^ (,type * Integer -> ,type))
       (define (,^ base power)
         (if (< power 0)
             (error "Can't exponentiate with a negative exponent.")
             (coalton++:unsafe
               (lisp (-> ,type) (base power) (cl:expt base power)))))

       (specialize ^^ ,^^ (,type * Integer -> ,type))
       (inline)
       (declare ,^^ (,type * Integer -> ,type))
       (define (,^^ base power)
         (coalton++:unsafe
           (lisp (-> ,type) (base power) (cl:expt base power)))))))

(%define-native-expt Fraction)
(%define-native-expt F32)
(%define-native-expt F64)

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/INTEGRAL")
