;;;; fraction.lisp
;;;;
;;;; Reduced ratios of integers

(coalton/utils:defstdlib-package #:coalton/math/fraction
  (:use
   #:coalton
   #:coalton/builtin
   #:coalton/classes
   #:coalton/functions
   #:coalton/math/arith)
  (:export
   #:make-fraction
   #:divide-by-integer
   #:numerator
   #:denominator))

(in-package #:coalton/math/fraction)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  ;; We avoid "Rational" or "Ratio" since those might be a more
  ;; generic concept than a humble fraction of integers. This
  ;; fraction is always assumed to be in reduced terms.

  (inline)
  (declare make-fraction (Integer * Integer -> Fraction))
  (define (make-fraction a b)
    (lisp (-> Fraction) (a b)
      (cl:/ a b)))

  (inline)
  (declare divide-by-integer (RationalScalars :a => :a * Integer -> :a))
  (define (divide-by-integer a n)
    "Divide `a` by a nonzero integer `n` using the central rational scalars."
    (* a (embed-fraction (make-fraction 1 n))))

  (inline)
  (declare numerator (Fraction -> Integer))
  (define (numerator q)
    "The numerator of a fraction."
    (coalton++:unsafe
      (lisp (-> Integer) (q)
        (cl:numerator q))))

  (inline)
  (declare denominator (Fraction -> Integer))
  (define (denominator q)
    "The denominator of a fraction."
    (coalton++:unsafe
      (lisp (-> Integer) (q)
        (cl:denominator q))))

  (define-instance (Eq Fraction)
    (inline)
    (define (== a b)
      (coalton++:unsafe
        (lisp (-> Boolean) (a b)
          (cl:= a b)))))

  (define-instance (Ord Fraction)
    (inline)
    (define (<=> a b)
      (coalton++:unsafe
        (lisp (-> Ordering) (a b)
          (cl:cond
            ((cl:< a b)
             LT)
            ((cl:> a b)
             GT)
            (cl:t
             EQ))))))

  (define-instance (HasAdd Fraction)
    (inline)
    (define (+ p q)
      (coalton++:unsafe
        (lisp (-> Fraction) (p q)
          (cl:+ p q)))))

  (define-instance (Additive Fraction)
    (define zero
      (coalton++:unsafe
        (lisp (-> Fraction) () 0))))

  (define-instance (AdditiveGroup Fraction)
    (inline)
    (define (- p q)
      (coalton++:unsafe
        (lisp (-> Fraction) (p q)
          (cl:- p q))))
    (inline)
    (define (neg q)
      (coalton++:unsafe
        (lisp (-> Fraction) (q)
          (cl:- q)))))

  (define-instance (HasMul Fraction)
    (inline)
    (define (* p q)
      (coalton++:unsafe
        (lisp (-> Fraction) (p q)
          (cl:* p q)))))

  (define-instance (Multiplicative Fraction)
    (define one
      (coalton++:unsafe
        (lisp (-> Fraction) () 1))))

  (define-instance (Semiring Fraction))

  (define-instance (Ring Fraction)
    (inline)
    (define (from-int z)
      (coalton++:unsafe
        (lisp (-> Fraction) (z) z))))

  (define-instance (Num Fraction))
  (define-instance (CommutativeRing Fraction))
  (define-instance (DivisionRing Fraction))
  (define-instance (CharacteristicZero Fraction))
  (define-instance (RationalAlgebra Fraction))
  (define-instance (RationalScalars Fraction)
    (inline)
    (define (embed-fraction q) q))

  (define-instance (Reciprocable Fraction)
    (inline)
    (define (/ a b)
      (lisp (-> Fraction) (a b)
        (cl:/ a b)))
    (inline)
    (define (recip q)
      (lisp (-> Fraction) (q)
        (cl:/ q))))

  (define-instance (Scale Fraction Fraction)
    (inline)
    (define (scale a b) (* a b)))

  (define-instance (Module Fraction Fraction))

  (define-instance (ConjugateRing Fraction)
    (inline)
    (define (conjugate x) x))

  (define-instance (InnerSpace Fraction Fraction))
  (define-instance (HermitianForm Fraction Fraction)
    (inline)
    (define (inner-product a b) (* a b)))

  (define-instance (Dividable Integer Fraction)
    (inline)
    (define (general/ x y)
      (make-fraction x y))))

(coalton-toplevel
  (define-instance (RationalScalars F32)
    (inline)
    (define (embed-fraction q) (general/ (numerator q) (denominator q))))
  (define-instance (RationalScalars F64)
    (inline)
    (define (embed-fraction q) (general/ (numerator q) (denominator q)))))

;;; All integer types representationally are already fractions.
(cl:eval-when (:compile-toplevel :load-toplevel)
  (cl:defmacro define-into-integer-fraction (integer-type)
    `(coalton-toplevel
       (define-instance (Into ,integer-type Fraction)
         (inline)
         (define (into i)
           (coalton++:unsafe
             (lisp (-> Fraction) (i)
               i)))))))

(define-into-integer-fraction Integer)
(define-into-integer-fraction I8)
(define-into-integer-fraction I16)
(define-into-integer-fraction I32)
(define-into-integer-fraction I64)
(define-into-integer-fraction IFix)
(define-into-integer-fraction Bit)
(define-into-integer-fraction U8)
(define-into-integer-fraction U16)
(define-into-integer-fraction U32)
(define-into-integer-fraction U64)
(define-into-integer-fraction UFix)

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/FRACTION")
