;;;; real.lisp
;;;;
;;;; Numbers that exist on the real number line

(coalton/utils::defstdlib-package #:coalton/math/real
    (:use
     #:coalton
     #:coalton/math/arith
     #:coalton/math/fraction
     #:coalton/math/integral
     #:coalton/classes
     #:coalton/functions)
  (:export
   #:Quantizable
   #:proper
   #:floor
   #:ceiling
   #:truncate
   #:round
   #:Approximable
   #:approx
   #:rational-approx
   #:simplest-fraction
   #:Quantization
   #:quantize
   #:round-half-up
   #:round-half-down
   #:safe/
   #:exact/
   #:inexact/
   #:floor/
   #:ceiling/
   #:round/
   #:fromfrac))

(in-package #:coalton/math/real)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (define-class ((Ord :a) (Ring :a) => Quantizable :a)
    "An Archimedean ordered ring whose elements lie between consecutive integers and support rounding to `Integer`.

By the **Archimedean property**, for every element $x$ there exist integers $m, n \\in \\mathbb{Z}$ with $m \\le x \\le n$, so a greatest integer $\\lfloor x \\rfloor$ (`floor`) at most $x$ and a least integer $\\lceil x \\rceil$ (`ceiling`) at least $x$ are well-defined.

Invariants:
- Floor bound: `(<= (from-int (floor x)) x)` and `(< x (from-int (+ (floor x) 1)))`
- Ceiling bound: `(< (from-int (- (ceiling x) 1)) x)` and `(<= x (from-int (ceiling x)))`
- Exact integer agreement: `(<=> (floor x) (ceiling x)) == EQ` iff `x == (from-int (floor x))`
- Proper decomposition: `(proper x) == (values (truncate x) (- x (from-int (truncate x))))` where `(truncate x) == (* (sign x) (floor (abs x)))` and the fractional remainder $r$ satisfies $0 \\le r < 1$ when $x \\ge 0$ and $-1 < r \\le 0$ when $x \\le 0$."
    (proper (:a -> Integer * :a))
    (floor (:a -> Integer))
    (ceiling (:a -> Integer)))

  (define-class (Approximable :a :b)
    "Approximate a value `x` of type `:a` to within $2^{-\\mathtt{bits}}$ in type `:b`.

For scalar numeric types, `(approx bits x)` returns an approximation $y$ satisfying

$$\\vert y - x \\vert \\le 2^{-\\mathtt{bits}}.$$

For composite structures (such as `Complex`, `Dual`, `Polynomial`, `Matrix`, `Quaternion`, or `Multivector`), `approx` approximates each component to within $2^{-\\mathtt{bits}}$."
    (approx (UFix * :a -> :b)))

  (inline)
  (declare rational-approx (Approximable :a Fraction => UFix * :a -> Fraction))
  (define (rational-approx bits x)
    "Approximate `x` as a `Fraction` within $2^{-\\mathtt{bits}}$:

$$\\vert \\text{rational-approx}(\\text{bits}, x) - x \\vert \\le 2^{-\\mathtt{bits}}.$$"
    (approx bits x))

  (inline)
  (declare truncate ((Quantizable :a) => :a -> Integer))
  (define (truncate x)
    "Returns the integer closest/equal to `x` that is within `0` and `x`."
    (let (values t _) = (proper x))
    t)

  (declare round ((Quantizable :a) => :a -> Integer))
  (define (round x)
    "Return the nearest integer to X, with ties breaking towards even numbers."
    (let (values n r) = (proper x))
    (match (<=> (abs (floor r)) (abs (ceiling r)))
      ;; Negative r
      ((GT)
       ;; r <=> -0.5
       (let s = (+ (* (from-int 2) r) one))
       (match (<=> (abs (floor s)) (abs (ceiling s)))
         ((LT) n)
         ((GT) (- n 1))
         ;; r = -0.5
         ((EQ) (if (even? n)
                   n
                   (- n 1)))))
      ;; Positive r
      ((LT)
       ;; r <=> 0.5
       (let s = (- (* (from-int 2) r) one))
       (match (<=> (abs (floor s)) (abs (ceiling s)))
         ((LT) (+ n 1))
         ((GT) n)
         ;; r = 0.5
         ((EQ) (if (even? n)
                   n
                   (+ n 1)))))
      ;; Zero r
      ((EQ) n))))

(cl:defmacro %define-integer-roundings (coalton-type)
  `(coalton-toplevel
     (define-instance (Quantizable ,coalton-type)
       (inline)
       (define (floor x) (from-int (to-integer x)))
       (inline)
       (define (ceiling x) (from-int (to-integer x)))
       (inline)
       (define (proper x)
         (values (from-int (to-integer x)) 0)))

     (define-instance (Approximable ,coalton-type Fraction)
       (inline)
       (define (approx _ x) (from-int (to-integer x))))

     (define-instance (Approximable ,coalton-type F32)
       (inline)
       (define (approx _ x) (from-int (to-integer x))))

     (define-instance (Approximable ,coalton-type F64)
       (inline)
       (define (approx _ x) (from-int (to-integer x))))))

(%define-integer-roundings Bit)
(%define-integer-roundings U8)
(%define-integer-roundings U16)
(%define-integer-roundings U32)
(%define-integer-roundings U64)
(%define-integer-roundings UFix)
(%define-integer-roundings I8)
(%define-integer-roundings I16)
(%define-integer-roundings I32)
(%define-integer-roundings I64)
(%define-integer-roundings IFix)
(%define-integer-roundings Integer)

(cl:defmacro %define-native-rationals (type)
  (cl:let
      ((round (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-ROUND")))
       (trunc (cl:intern (cl:concatenate 'cl:string (cl:symbol-name type) "-TRUNCATE"))))
    `(coalton-toplevel
       (define-instance (Quantizable ,type)
         (inline)
         (define (floor q)
           (coalton++:unsafe
             (lisp (-> Integer) (q)
               (cl:nth-value 0 (cl:floor q)))))
         (inline)
         (define (ceiling q)
           (coalton++:unsafe
             (lisp (-> Integer) (q)
               (cl:nth-value 0 (cl:ceiling q)))))
        (inline)
        (define (proper q)
          (coalton++:unsafe
            (lisp (-> Integer * ,type) (q)
              (cl:truncate q)))))

       (specialize truncate ,trunc (,type -> Integer))
       (inline)
       (declare ,trunc (,type -> Integer))
       (define (,trunc x)
         (coalton++:unsafe
           (lisp (-> Integer) (x)
             (cl:nth-value 0 (cl:truncate x)))))

       (define-instance (Approximable ,type Fraction)
         (inline)
         (define (approx _ x)
           (coalton++:unsafe
             (lisp (-> Fraction) (x)
               (cl:rational x)))))

       (define-instance (Approximable ,type F32)
         (inline)
         (define (approx _ x)
           (lisp (-> F32) (x)
             (cl:coerce x 'cl:single-float))))

       (define-instance (Approximable ,type F64)
         (inline)
         (define (approx _ x)
           (lisp (-> F64) (x)
             (cl:coerce x 'cl:double-float))))

       (specialize round ,round (,type -> Integer))
       (inline)
       (declare ,round (,type -> Integer))
       (define (,round x)
         (coalton++:unsafe
           (lisp (-> Integer) (x)
             (cl:nth-value 0 (cl:round x))))))))

(%define-native-rationals Fraction)
(%define-native-rationals F32)
(%define-native-rationals F64)

(coalton-toplevel
  (declare simplest-fraction (Approximable :a Fraction => UFix * :a -> Fraction))
  (define (simplest-fraction bits x)
    "Return the simplest `Fraction` $p/q$ (minimal positive denominator $q$, then minimal $\\vert p \\vert$) within $2^{-\\mathtt{bits}}$ of `x`:

$$\\left\\vert \\frac{p}{q} - x \\right\\vert \\le 2^{-\\mathtt{bits}}.$$"
    ;; See figure 3 in https://doi.org/10.1145/142675.142726
    ;; Approximate x to 2^-(bits + 1), then find the simplest convergent within 2^-(bits + 1) of q.
    ;; By the triangle inequality, |p/q - x| <= |p/q - q| + |q - x| <= 2^-bits.
    (let q = (the Fraction (approx (+ bits 1) x)))
    (let epsilon = (the Fraction (^^ 2 (neg (+ (to-integer bits) 1)))))
    (let ((approximate-rec
            (fn (e0 p0 q0 e1 p1 q1)
              (cond
                ((and (/= q1 0)
                      (<= (abs (- (make-fraction p1 q1) q)) epsilon))
                 (make-fraction p1 q1))
                ((/= 0 e1)
                 (let r = (floor (/ e0 e1)))
                 (approximate-rec e1 p1 q1
                                  (- e0 (* (from-int r) e1))
                                  (- p0 (* r p1))
                                  (- q0 (* r q1))))
                ;; SBCL cannot prove this branch unreachable for the initial
                ;; p1=1, q1=0 seed; inlining exposes a spurious division by zero.
                (True (noinline (make-fraction p1 q1)))))))
      (approximate-rec q 0 1 -1 1 0)))

  (define-struct (Quantization :a)
    "Represents an integer quantization of `:a`."
    (value       "A value of type `:a`."
                 :a)
    (floor       "The greatest integer less than or equal to a particular value."
                 Integer)
    (floor-rem   "The remainder of the floor operation as type `:a`."
                 :a)
    (ceiling     "The least integer greater than or equal to a particular value."
                 Integer)
    (ceiling-rem "The remainder of the ceiling operation as type `:a`."
                 :a))

  (declare quantize (Quantizable :a => (:a -> (Quantization :a))))
  (define (quantize x)
    "Given X, (QUANTIZE X) will return the least integer greater or equal to X,
and the greatest integer less than or equal to X, along with their respective
remainders expressed as values of type of X."
    (let x-floor = (floor x))
    (let x-ceiling = (ceiling x))
    (let x-rem-floor = (- x (from-int x-floor)))
    (let x-rem-ceiling = (- x (from-int x-ceiling)))
    (Quantization x x-floor x-rem-floor x-ceiling x-rem-ceiling))

  (inline)
  (declare round-half-up (Quantizable :a => :a -> Integer))
  (define (round-half-up x)
    "Return the nearest integer to X, with ties breaking toward positive infinity."
    (ceiling/ (floor (* (from-int 2) x)) 2))

  (inline)
  (declare round-half-down (Quantizable :a => :a -> Integer))
  (define (round-half-down x)
    "Return the nearest integer to X, with ties breaking toward negative infinity."
    (floor/ (ceiling (* (from-int 2) x)) 2))

  (declare safe/ ((Eq :a) (Additive :a) (Dividable :a :b) => (:a * :a -> (Optional :b))))
  (define (safe/ x y)
    "Safely divide X by Y, returning None if Y is zero."
    (if (zero? y)
        None
        (Some (general/ x y))))

  (inline)
  (declare exact/ (Integer * Integer -> Fraction))
  (define (exact/ a b)
    "Exactly divide two integers and produce a fraction."
    (general/ a b))

  (inline)
  (declare inexact/ (Integer * Integer -> F64))
  (define (inexact/ a b)
    "Compute the quotient of integers as a double-precision float.

Note: This does *not* divide double-float arguments."
    (general/ a b))

  (inline)
  (declare floor/ (Integer * Integer -> Integer))
  (define (floor/ a b)
    "Divide two integers and compute the floor of the quotient."
    (lisp (-> Integer) (a b)
      (cl:values (cl:floor a b))))

  (inline)
  (declare ceiling/ (Integer * Integer -> Integer))
  (define (ceiling/ a b)
    "Divide two integers and compute the ceiling of the quotient."
    (lisp (-> Integer) (a b)
      (cl:values (cl:ceiling a b))))

  (inline)
  (declare round/ (Integer * Integer -> Integer))
  (define (round/ a b)
    "Divide two integers and round the quotient."
    (round (exact/ a b)))

  (inline)
  (declare fromfrac (Dividable Integer :a => Fraction -> :a))
  (define (fromfrac q)
    "Converts a fraction to a target type.

Specifically, target types must have an instance of `Dividable Integer :a`.

This conversion may result in loss of fidelity."
    (general/ (numerator q) (denominator q))))

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/REAL")
