;;;; bounded.lisp
;;;;
;;;; Numerical types with fixed bounds

(coalton/utils:defstdlib-package #:coalton/math/bounded
  (:use
   #:coalton
   #:coalton/builtin
   #:coalton/classes
   #:coalton/functions)
  (:export
   #:Bounded #:min-bound #:max-bound))

(in-package #:coalton/math/bounded)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (define-class (Ord :a => Bounded :a)
    "Ordered types with a minimum bound `min-bound` and maximum bound `max-bound`.

Laws:
- For all `x`: `(<= min-bound x)` and `(<= x max-bound)`"
    (min-bound :a)
    (max-bound :a))

  (define-instance (Bounded Bit)
    (define min-bound 0)
    (define max-bound 1))

  (define-instance (Bounded U8)
    (define min-bound 0)                 ; 0
    (define max-bound 255))              ; 2^8-1
    
  (define-instance (Bounded I8)
    (define min-bound -128)              ; -1 * ceiling((2^8-1)/2)
    (define max-bound 127))              ; ceiling((2^8-1)/2)

  (define-instance (Bounded U16)
    (define min-bound 0)                 ; 0
    (define max-bound 65535))            ; 2^16-1

  (define-instance (Bounded I16)
    (define min-bound -32768)            ; -1 * floor((2^16-1)/2)
    (define max-bound 32767))            ; ceiling((2^16-1)/2)

  (define-instance (Bounded U32)
    (define min-bound 0)                 ; 0
    (define max-bound 4294967295))       ; 2^32-1

  (define-instance (Bounded I32)
    (define min-bound -2147483648)       ; -1 * ceiling((2^32-1)/2)
    (define max-bound 2147483647))       ; floor((2^32-1)/2)
    
  (define-instance (Bounded U64)
    (define min-bound 0)                     ; 0
    (define max-bound 18446744073709551615)) ; 2^64-1

  (define-instance (Bounded I64)
    (define min-bound -9223372036854775808) ; -1 * ceiling((2^64-1)/2)
    (define max-bound 9223372036854775807)) ; floor((2^32-1)/2)

  (define-instance (Bounded IFix)
    (define min-bound
      (coalton++:unsafe
        (lisp (-> IFix) ()
          cl:most-negative-fixnum)))
    (define max-bound
      (coalton++:unsafe
        (lisp (-> IFix) ()
          cl:most-positive-fixnum))))

  (define-instance (Bounded UFix)
    (define min-bound 0)
    (define max-bound
      (coalton++:unsafe
        (lisp (-> UFix) ()
          cl:most-positive-fixnum)))))

#+sb-package-locks
(sb-ext:lock-package "COALTON/MATH/BOUNDED")
