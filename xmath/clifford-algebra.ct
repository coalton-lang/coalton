;;;; clifford-algebra.ct
;;;;
;;;; Graded Clifford / Geometric Algebra Cl(V, Q)

(coalton/utils:defstdlib-package #:coalton/xmath/clifford-algebra
  (:documentation "Graded Clifford (geometric) algebras $\\mathrm{Cl}_{p,q,r}(R)$ over a commutative ring or field $R$.

Given an orthogonal basis $e_0, e_1, \\ldots$ with quadratic form $Q(e_i) = e_i^2 = s_i \\in \\mathbb{Z}$, the Clifford algebra $\\mathrm{Cl}(V, Q)$ is the associative algebra generated by the $e_i$ subject to
$$e_i^2 = s_i, \\qquad e_i e_j = -e_j e_i \\quad (i \\neq j).$$
Standard metric signatures (`pqr-signature`) include Euclidean space $\\mathrm{Cl}_{n,0,0}$ ($e_i^2 = +1$, `euclidean-signature`), Lorentz / Minkowski signatures $\\mathrm{Cl}_{p,q,0}$, projective geometric algebra $\\mathrm{Cl}_{p,q,1}$, and the exterior (Grassmann) algebra $\\bigwedge V = \\mathrm{Cl}_{0,0,n}$ ($e_i^2 = 0$, `exterior-signature`).

**Graded blade representation.** A $k$-blade $e_{i_1} \\wedge \\cdots \\wedge e_{i_k}$ ($i_1 < \\cdots < i_k$) of grade $k$ is indexed by the bitmask $B = \\sum_{m=1}^k 2^{i_m}$ with grade $k = \\operatorname{popcount}(B)$ (`blade-grade`). A multivector $A = \\sum_B c_B e_B = \\sum_{k \\ge 0} \\langle A \\rangle_k$ decomposes into homogeneous grade-$k$ components $\\langle A \\rangle_k$ (`grade-project`).

**Products and involutions.**
- **Geometric product (`*`, `geometric-product`):** The associative algebra product $AB$, computed on basis blades from the swap parity between bitmasks $B_1, B_2$ and the metric factors $\\prod_{i \\in B_1 \\cap B_2} s_i$;
- **Exterior (wedge) product (`wedge`):** The metric-independent outer product $A \\wedge B = \\sum_{j,k} \\langle \\langle A \\rangle_j \\langle B \\rangle_k \\rangle_{j+k}$, keeping only disjoint blades ($B_1 \\cap B_2 = \\emptyset$);
- **Left interior contraction (`left-contract`):** $A \\rfloor B = \\sum_{j \\le k} \\langle \\langle A \\rangle_j \\langle B \\rangle_k \\rangle_{k-j}$, keeping blade pairs with $B_1 \\subseteq B_2$;
- **Canonical involutions:** Grade involution $\\hat{A}_k = (-1)^k A_k$ (`grade-involution`), reversion $\\tilde{A}_k = (-1)^{k(k-1)/2} A_k$ (`reversion`, which implements `ConjugateRing`), and Clifford conjugation $\\bar{A}_k = (-1)^{k(k+1)/2} A_k = \\hat{\\tilde{A}}$ (`clifford-conjugate`);
- **Versor sandwich product (`sandwich`):** Orthogonal transformations and rotations $X \\mapsto R X \\tilde{R}$.")
  (:nicknames
   #:coalton/math/clifford-algebra
   #:coalton-library/math/clifford-algebra)
  (:use
   #:coalton
   #:coalton/classes
   #:coalton/functions
   #:coalton/tuple
   #:coalton/math/arith
   #:coalton/math/integral
   #:coalton/math/real)
  (:local-nicknames
   (#:bits #:coalton/bits)
   (#:list #:coalton/list)
   (#:show #:coalton/show))
  (:export
   #:Multivector
   #:CliffordSignature
   #:euclidean-signature
   #:exterior-signature
   #:pqr-signature
   #:signature-from-list
   #:with-clifford-signature
   #:multivector
   #:terms
   #:scalar-part
   #:basis-vector
   #:basis-blade
   #:blade-coeff
   #:blade-grade
   #:grade-project
   #:wedge
   #:left-contract
   #:left-contract-with
   #:geometric-product-with
   #:grade-involution
   #:reversion
   #:clifford-conjugate
   #:sandwich
   #:sandwich-with
   #:norm-squared))

(in-package #:coalton/xmath/clifford-algebra)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (declare %euclidean-sig (UFix -> Integer))
  (define (%euclidean-sig _)
    1)

  (declare %exterior-sig (UFix -> Integer))
  (define (%exterior-sig _)
    0)

  (declare euclidean-signature (Integral :a => :a -> Integer))
  (define (euclidean-signature _)
    "The Euclidean metric signature $e_i^2 = +1$ for all $i$."
    1)

  (declare exterior-signature (Integral :a => :a -> Integer))
  (define (exterior-signature _)
    "The exterior (Grassmann) metric signature $e_i^2 = 0$ for all $i$."
    0)

  (declare pqr-signature (Integral :a => UFix * UFix * UFix -> (:a -> Integer)))
  (define (pqr-signature p q _r)
    "Return the metric signature for $\\text{Cl}(p, q, r)$: $+1$ for $0 \\le i < p$, $-1$ for $p \\le i < p + q$, and $0$ for $i \\ge p + q$."
    (let p-int = (to-integer p))
    (let pq-int = (+ p-int (to-integer q)))
    (fn (i)
      (let idx = (to-integer i))
      (cond
        ((< idx 0) 0)
        ((< idx p-int) 1)
        ((< idx pq-int) -1)
        (True 0))))

  (declare signature-from-list (Integral :a => List Integer -> (:a -> Integer)))
  (define (signature-from-list signs)
    "Construct a metric signature $i \\mapsto e_i^2$ from a list of signs $(s_0, s_1, \\ldots)$ (returning $0$ for indices beyond the list)."
    (fn (i)
      (let idx0 = (to-integer i))
      (if (< idx0 0)
          0
          (rec lookup ((idx idx0) (rest signs))
            (match rest
              ((Nil) 0)
              ((Cons s more)
               (if (== idx 0)
                   s
                   (lookup (- idx 1) more))))))))

  (define-class (CliffordSignature :s)
    "Types that specify a Clifford algebra metric signature $i \\mapsto e_i^2 \\in \\mathbb{Z}$."
    (signature-function (:s -> (UFix -> Integer))))

  (define-instance ((Integral :a) (Integral :b) => CliffordSignature (:a -> :b))
    (define (signature-function f)
      (fn (i)
        (to-integer (f (from-nat i))))))

  (define-instance (Integral :a => CliffordSignature (List :a))
    (define (signature-function signs)
      (signature-from-list (map to-integer signs))))

  (define-instance (Integral :a => CliffordSignature (Tuple3 :a :a :a))
    (define (signature-function (Tuple3 p q r))
      (pqr-signature (integral->num p)
                     (integral->num q)
                     (integral->num r)))))

(cl:defvar *clifford-signature* %euclidean-sig
  "Current dynamic metric signature for `Multivector` multiplication and contraction (defaults to Euclidean $e_i^2 = +1$).")

(coalton-toplevel
  (declare %list-sig (List Integer -> (UFix -> Integer)))
  (define (%list-sig signs)
    (signature-function signs))

  (declare %current-signature (Void -> (UFix -> Integer)))
  (define (%current-signature)
    (lisp (-> (UFix -> Integer)) ()
      (cl:if (cl:listp *clifford-signature*)
             (call-coalton-function %list-sig *clifford-signature*)
             *clifford-signature*)))

  (declare with-clifford-signature
    (forall ((:s Type) (:r Values))
      (CliffordSignature :s => :s * (Void -> :r) -> :r)))
  (define (with-clifford-signature sig thunk)
    "Call `thunk` with `*clifford-signature*` dynamically bound to `sig` (a function `UFix -> Integer`, a `List Integer` of signs, or a `Tuple3 UFix UFix UFix` for $\\text{Cl}(p, q, r)$)."
    (let sig-fn = (signature-function sig))
    (lisp (-> :r) (sig-fn thunk)
      (cl:let ((*clifford-signature* sig-fn))
        (call-coalton-function thunk))))

  ;;
  ;; Multivector representation: sparse terms (Tuple coeff blade-mask) in strictly ascending mask order
  ;;

  (repr :transparent)
  (define-type (Multivector :a)
    "A sparse graded multivector $\\sum_B c_B e_B$ in a Clifford / Geometric Algebra, with basis blades indexed by `UFix` bitmasks in ascending order."
    (%Multivector (List (Tuple :a UFix))))

  (declare %add-terms
    (HasAdd :a => List (Tuple :a UFix) * List (Tuple :a UFix) -> List (Tuple :a UFix)))
  (define (%add-terms xs ys)
    (rec merge ((a xs) (b ys) (acc Nil))
      (match (Tuple a b)
        ((Tuple (Nil) (Nil))
         (list:reverse acc))
        ((Tuple (Nil) (Cons y more-b))
         (merge Nil more-b (Cons y acc)))
        ((Tuple (Cons x more-a) (Nil))
         (merge more-a Nil (Cons x acc)))
        ((Tuple (Cons (Tuple ca ba) more-a) (Cons (Tuple cb bb) more-b))
         (cond
           ((< ba bb)
            (merge more-a b (Cons (Tuple ca ba) acc)))
           ((> ba bb)
            (merge a more-b (Cons (Tuple cb bb) acc)))
           (True
            (merge more-a more-b (Cons (Tuple (+ ca cb) ba) acc))))))))

  (declare %split-terms
    (List (Tuple :a UFix) -> Tuple (List (Tuple :a UFix)) (List (Tuple :a UFix))))
  (define (%split-terms xs)
    (rec loop ((rest xs) (left Nil) (right Nil))
      (match rest
        ((Nil) (Tuple left right))
        ((Cons x (Nil)) (Tuple (Cons x left) right))
        ((Cons x (Cons y more))
         (loop more (Cons x left) (Cons y right))))))

  (declare %sort-merge-terms (Additive :a => List (Tuple :a UFix) -> List (Tuple :a UFix)))
  (define (%sort-merge-terms xs)
    (match xs
      ((Nil) Nil)
      ((Cons _ (Nil)) xs)
      (_
       (let (Tuple left right) = (%split-terms xs))
       (%add-terms (%sort-merge-terms left)
                   (%sort-merge-terms right)))))

  (declare %strip-zeros ((Eq :a) (Additive :a) => List (Tuple :a UFix) -> List (Tuple :a UFix)))
  (define (%strip-zeros xs)
    (rec loop ((rest xs) (acc Nil))
      (match rest
        ((Nil) (list:reverse acc))
        ((Cons (Tuple c b) more)
         (if (zero? c)
             (loop more acc)
             (loop more (Cons (Tuple c b) acc)))))))

  (declare multivector ((Eq :a) (Additive :a) => List (Tuple :a UFix) -> Multivector :a))
  (define (multivector pairs)
    "Construct a `Multivector` from a list of `(Tuple coeff blade-mask)` pairs, sorting by bitmask, summing duplicate blades, and dropping zero coefficients."
    (%Multivector (%strip-zeros (%sort-merge-terms pairs))))

  (declare terms ((Eq :a) (Additive :a) => Multivector :a -> List (Tuple :a UFix)))
  (define (terms (%Multivector xs))
    "Return the canonical list of non-zero `(Tuple coeff blade-mask)` terms in ascending blade-mask order."
    (%strip-zeros xs))

  (declare scalar-mv ((Eq :a) (Additive :a) => :a -> Multivector :a))
  (define (scalar-mv c)
    "Construct the grade-0 scalar multivector $c \\cdot 1$."
    (if (zero? c)
        (%Multivector Nil)
        (%Multivector (Cons (Tuple c 0) Nil))))

  (declare basis-blade (Semiring :a => UFix -> Multivector :a))
  (define (basis-blade mask)
    "Construct the unit basis blade $e_{\\mathtt{mask}}$."
    (%Multivector (Cons (Tuple one mask) Nil)))

  (declare basis-vector (Semiring :a => UFix -> Multivector :a))
  (define (basis-vector i)
    "Construct the $i$-th orthogonal basis vector $e_i$ (with bitmask $2^i$). Signal an error if that bit does not fit in a `UFix`."
    (let mask = (the UFix (lsh 1 i)))
    (when (zero? mask) (error "Clifford basis-vector index exceeds the UFix blade width."))
    (basis-blade mask))

  (declare blade-coeff (Additive :a => Multivector :a * UFix -> :a))
  (define (blade-coeff (%Multivector xs) mask)
    "Return the coefficient of the basis blade with bitmask `mask` in `mv` (`zero` if absent)."
    (rec loop ((rest xs))
      (match rest
        ((Nil) zero)
        ((Cons (Tuple c b) more)
         (cond
           ((== b mask) c)
           ((> b mask) zero)
           (True (loop more)))))))

  (declare scalar-part (Additive :a => Multivector :a -> :a))
  (define (scalar-part mv)
    "Return the grade-0 scalar coefficient of `mv`."
    (blade-coeff mv 0))

  (declare blade-grade (UFix -> UFix))
  (define (blade-grade mask)
    "Return the grade $k = \\text{popcount}(\\mathtt{mask})$ of the basis blade with bitmask `mask`."
    (lisp (-> UFix) (mask)
      (cl:logcount mask)))

  (declare grade-project ((Eq :a) (Additive :a) => UFix * Multivector :a -> Multivector :a))
  (define (grade-project k (%Multivector xs))
    "Project `mv` onto its grade-$k$ component $\\langle A \\rangle_k$."
    (rec loop ((rest xs) (acc Nil))
      (match rest
        ((Nil) (%Multivector (list:reverse acc)))
        ((Cons (Tuple c b) more)
         (if (and (== (blade-grade b) k) (nonzero? c))
             (loop more (Cons (Tuple c b) acc))
             (loop more acc))))))

  ;;
  ;; Blade sign and metric helpers
  ;;

  (declare %blade-swap-parity (UFix * UFix -> Boolean))
  (define (%blade-swap-parity b1 b2)
    "Return `True` if sorting the concatenated basis vectors of `b1` and `b2` into ascending order requires an odd number of transpositions."
    (rec loop ((a (rsh b1 1)) (b b2) (parity 0))
      (if (or (== a 0) (== b 0))
          (/= (bits:and parity 1) 0)
          (let ((next-parity (if (/= (bits:and b 1) 0)
                                 (+ parity (blade-grade a))
                                 parity)))
            (loop (rsh a 1) (rsh b 1) next-parity)))))

  (declare %blade-metric-factor ((UFix -> Integer) * UFix * UFix -> Integer))
  (define (%blade-metric-factor sig b1 b2)
    "Return the signed metric factor $s \\in \\mathbb{Z}$ such that $e_{b_1} e_{b_2} = s\\, e_{b_1 \\oplus b_2}$."
    (let sign = (if (%blade-swap-parity b1 b2) -1 1))
    (let common = (bits:and b1 b2))
    (rec loop ((i 0) (rem common) (acc sign))
      (if (or (== rem 0) (== acc 0))
          acc
          (let ((next-acc (if (/= (bits:and rem 1) 0)
                              (* acc (sig i))
                              acc)))
            (loop (+ i 1) (rsh rem 1) next-acc)))))

  (declare %scale-by-int-factor (Ring :a => Integer * :a -> :a))
  (define (%scale-by-int-factor factor c)
    (cond
      ((== factor 1) c)
      ((== factor -1) (neg c))
      (True (* (from-int factor) c))))

  (declare %product-raw
    (Ring :a =>
     (UFix * UFix -> Boolean) * (UFix -> Integer) * Multivector :a * Multivector :a -> List (Tuple :a UFix)))
  (define (%product-raw keep-pair? sig (%Multivector xs) (%Multivector ys))
    (rec outer ((rest-x xs) (acc Nil))
      (match rest-x
        ((Nil) (%sort-merge-terms acc))
        ((Cons (Tuple cx bx) more-x)
         (let next-acc =
           (rec inner ((rest-y ys) (inner-acc acc))
             (match rest-y
               ((Nil) inner-acc)
               ((Cons (Tuple cy by) more-y)
                (if (keep-pair? bx by)
                    (let ((factor (%blade-metric-factor sig bx by)))
                      (if (== factor 0)
                          (inner more-y inner-acc)
                          (let ((coeff (%scale-by-int-factor factor (* cx cy)))
                                (mask (bits:xor bx by)))
                            (inner more-y (Cons (Tuple coeff mask) inner-acc)))))
                    (inner more-y inner-acc))))))
         (outer more-x next-acc)))))

  ;;
  ;; Involutions: grade involution, reversion, Clifford conjugate
  ;;

  (declare grade-involution (AdditiveGroup :a => Multivector :a -> Multivector :a))
  (define (grade-involution (%Multivector xs))
    "Compute the main grade involution (automophism) $\\hat{A}_k = (-1)^k A_k$."
    (rec loop ((rest xs) (acc Nil))
      (match rest
        ((Nil) (%Multivector (list:reverse acc)))
        ((Cons (Tuple c b) more)
         (let next-c = (if (/= (bits:and (blade-grade b) 1) 0)
                           (neg c)
                           c))
         (loop more (Cons (Tuple next-c b) acc))))))

  (declare reversion (AdditiveGroup :a => Multivector :a -> Multivector :a))
  (define (reversion (%Multivector xs))
    "Compute the reversion anti-automorphism $\\tilde{A}_k = (-1)^{k(k-1)/2} A_k$, reversing the order of basis vectors in each blade."
    (rec loop ((rest xs) (acc Nil))
      (match rest
        ((Nil) (%Multivector (list:reverse acc)))
        ((Cons (Tuple c b) more)
         (let next-c = (if (/= (bits:and (blade-grade b) 2) 0)
                           (neg c)
                           c))
         (loop more (Cons (Tuple next-c b) acc))))))

  (declare clifford-conjugate (AdditiveGroup :a => Multivector :a -> Multivector :a))
  (define (clifford-conjugate (%Multivector xs))
    "Compute the Clifford involution $\\bar{A}_k = (-1)^{k(k+1)/2} A_k = \\hat{\\tilde{A}}$."
    (rec loop ((rest xs) (acc Nil))
      (match rest
        ((Nil) (%Multivector (list:reverse acc)))
        ((Cons (Tuple c b) more)
         (let next-c = (if (/= (bits:and (+ (blade-grade b) 1) 2) 0)
                           (neg c)
                           c))
         (loop more (Cons (Tuple next-c b) acc))))))

  ;;
  ;; Products: exterior (wedge), left contraction, geometric product, sandwich product
  ;;

  (declare wedge ((Eq :a) (Ring :a) => Multivector :a * Multivector :a -> Multivector :a))
  (define (wedge a b)
    "Compute the metric-independent exterior (wedge) product $A \\wedge B$."
    (%Multivector
     (%strip-zeros
      (%product-raw (fn (bx by) (== (bits:and bx by) 0))
                    %exterior-sig
                    a
                    b))))

  (declare %left-contract-fn
    ((Eq :a) (Ring :a) => (UFix -> Integer) * Multivector :a * Multivector :a -> Multivector :a))
  (define (%left-contract-fn sig-fn a b)
    (%Multivector
     (%strip-zeros
      (%product-raw (fn (bx by) (== (bits:and bx by) bx))
                    sig-fn
                    a
                    b))))

  (declare left-contract-with
    ((CliffordSignature :s) (Eq :a) (Ring :a) => :s * Multivector :a * Multivector :a -> Multivector :a))
  (define (left-contract-with sig a b)
    "Compute the left interior contraction $A \\rfloor B$ with explicit metric signature `sig`."
    (%left-contract-fn (signature-function sig) a b))

  (declare left-contract ((Eq :a) (Ring :a) => Multivector :a * Multivector :a -> Multivector :a))
  (define (left-contract a b)
    "Compute the left interior contraction $A \\rfloor B$ under `*clifford-signature*`."
    (%left-contract-fn (%current-signature) a b))

  (declare %geometric-product-fn
    ((Eq :a) (Ring :a) => (UFix -> Integer) * Multivector :a * Multivector :a -> Multivector :a))
  (define (%geometric-product-fn sig-fn a b)
    (%Multivector
     (%strip-zeros
      (%product-raw (fn (_bx _by) True)
                    sig-fn
                    a
                    b))))

  (declare geometric-product-with
    ((CliffordSignature :s) (Eq :a) (Ring :a) => :s * Multivector :a * Multivector :a -> Multivector :a))
  (define (geometric-product-with sig a b)
    "Compute the geometric product $AB$ with explicit metric signature `sig`."
    (%geometric-product-fn (signature-function sig) a b))

  (declare geometric-product ((Eq :a) (Ring :a) => Multivector :a * Multivector :a -> Multivector :a))
  (define (geometric-product a b)
    "Compute the geometric product $AB$ under `*clifford-signature*`."
    (%geometric-product-fn (%current-signature) a b))

  (declare sandwich-with
    ((CliffordSignature :s) (Eq :a) (Ring :a) => :s * Multivector :a * Multivector :a -> Multivector :a))
  (define (sandwich-with sig r x)
    "Compute the versor sandwich product $R X \\tilde{R}$ with explicit metric signature `sig`."
    (let sig-fn = (signature-function sig))
    (%geometric-product-fn sig-fn
                           (%geometric-product-fn sig-fn r x)
                           (reversion r)))

  (declare sandwich ((Eq :a) (Ring :a) => Multivector :a * Multivector :a -> Multivector :a))
  (define (sandwich r x)
    "Compute the versor sandwich product $R X \\tilde{R}$ under `*clifford-signature*`."
    (let sig-fn = (%current-signature))
    (%geometric-product-fn sig-fn
                           (%geometric-product-fn sig-fn r x)
                           (reversion r)))

  (declare norm-squared (Ring :a => Multivector :a -> :a))
  (define (norm-squared mv)
    "Return the scalar part $\\langle \\tilde{A} A \\rangle_0$ of $\\tilde{A} A$ under `*clifford-signature*`."
    (scalar-part (* (reversion mv) mv)))

  ;;
  ;; Type class instances
  ;;

  (define-instance ((Eq :a) (Additive :a) => Eq (Multivector :a))
    (define (== a b)
      (== (terms a) (terms b))))

  (define-instance ((Eq :a) (Additive :a) (show:Show :a) => show:Show (Multivector :a))
    (define (show:show-to f mv)
      (f "(multivector")
      (rec loop ((xs (terms mv)))
        (match xs
          ((Nil) (f ")"))
          ((Cons (Tuple c b) more)
           (f " (Tuple ")
           (show:show-to f c)
           (f " ")
           (show:show-to f b)
           (f ")")
           (loop more))))))

  (define-instance (HasAdd :a => HasAdd (Multivector :a))
    (define (+ (%Multivector xs) (%Multivector ys))
      (%Multivector (%add-terms xs ys))))

  (define-instance (Additive :a => Additive (Multivector :a))
    (define zero
      (%Multivector Nil)))

  (define-instance (AdditiveGroup :a => AdditiveGroup (Multivector :a))
    (define (neg (%Multivector xs))
      (rec loop ((rest xs) (acc Nil))
        (match rest
          ((Nil) (%Multivector (list:reverse acc)))
          ((Cons (Tuple c b) more)
           (loop more (Cons (Tuple (neg c) b) acc))))))
    (define (- a b)
      (+ a (neg b))))

  (define-instance (Ring :a => HasMul (Multivector :a))
    (define (* a b)
      (%Multivector
       (%product-raw (fn (_bx _by) True)
                     (%current-signature)
                     a
                     b))))

  (define-instance (Ring :a => Multiplicative (Multivector :a))
    (define one
      (%Multivector (Cons (Tuple one 0) Nil))))

  (define-instance (Ring :a => Semiring (Multivector :a)))

  (define-instance (Ring :a => Ring (Multivector :a))
    (define (from-int n)
      (if (== n 0)
          zero
          (%Multivector (Cons (Tuple (from-int n) 0) Nil)))))

  (define-instance (Num :a => Num (Multivector :a)))

  (define-instance (Into :a (Multivector :a))
    (inline)
    (define (into c)
      (%Multivector (Cons (Tuple c 0) Nil))))

  (define-instance (ConjugateRing :a => ConjugateRing (Multivector :a))
    (define (conjugate (%Multivector xs))
      (rec loop ((rest xs) (acc Nil))
        (match rest
          ((Nil) (%Multivector (list:reverse acc)))
          ((Cons (Tuple c b) more)
           (let conj-c = (conjugate c))
           (let signed-c = (if (/= (bits:and (blade-grade b) 2) 0)
                               (neg conj-c)
                               conj-c))
           (loop more (Cons (Tuple signed-c b) acc)))))))

  (define-instance (Multiplicative :a => Scale :a (Multivector :a))
    (define (scale k (%Multivector xs))
      (rec loop ((rest xs) (acc Nil))
        (match rest
          ((Nil) (%Multivector (list:reverse acc)))
          ((Cons (Tuple c b) more)
           (loop more (Cons (Tuple (* k c) b) acc)))))))

  (define-instance (Ring :a => Module :a (Multivector :a)))

  (define-instance ((ConjugateRing :a) (DivisionRing :a) => InnerSpace :a (Multivector :a)))
  (define-instance (ConjugateRing :a => HermitianForm :a (Multivector :a))
    (define (inner-product (%Multivector xs) (%Multivector ys))
      (rec loop ((a xs) (b ys) (acc zero))
        (match (Tuple a b)
          ((Tuple (Nil) _) acc)
          ((Tuple _ (Nil)) acc)
          ((Tuple (Cons (Tuple ca ba) more-a) (Cons (Tuple cb bb) more-b))
           (cond
             ((< ba bb) (loop more-a b acc))
             ((> ba bb) (loop a more-b acc))
             (True (loop more-a more-b (+ acc (* cb (conjugate ca)))))))))))

  (define-instance (Approximable :a :b => Approximable (Multivector :a) (Multivector :b))
    (define (approx bits (%Multivector xs))
      ;; The masks are already sorted and unique. Do not elide a component
      ;; by testing approximate equality of the newly converted coefficient.
      (%Multivector (map (fn ((Tuple c b)) (Tuple (approx bits c) b)) xs)))))

#+sb-package-locks
(sb-ext:lock-package "COALTON/XMATH/CLIFFORD-ALGEBRA")
