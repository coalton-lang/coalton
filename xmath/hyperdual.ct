;;;; hyperdual.lisp
;;;;
;;;; An implementation of Hyperdual numbers for computing second-order
;;;; derivatives of compositions of built-in Coalton functions.

(coalton/utils::defstdlib-package #:coalton/xmath/hyperdual
  (:nicknames
   #:coalton/math/hyperdual
   #:coalton-library/math/hyperdual)
  (:use
   #:coalton
   #:coalton/builtin
   #:coalton/classes
   #:coalton/functions
   #:coalton/math/arith
   #:coalton/math/elementary
   #:coalton/math/integral
   #:coalton/math/complex)
  (:import-from
   #:coalton/xmath/dual
   #:AD
   #:make-ad
   #:primal
   #:tangent)
  (:export
   #:Hyperdual
   #:d-x
   #:d-xx
   #:partial-x
   #:partial-y
   #:gradient
   #:partial-xx
   #:partial-xy
   #:partial-yy
   #:laplacian
   #:hessian)
  (:documentation
   "An implementation of hyperdual numbers for second-order and
multivariate automatic differentiation.

 ——————————————————————————————————————————————–

For univariate differentiation of a function $f$ at a point $x$, apply
`f` to `(Hyperdual x 1 1 0)`. The result will be
`(Hyperdual f(x) df/dx(x) df/dx(x) d²f/dx²(x))`.

You may also use the convenience functions `d-x` and `d-xx` to compute
the first and second derivatives as `(d-x f x)` and `(d-xx f x)`.

 ——————————————————————————————————————————————–

For multivariate differentiation of a function $f$ at a point $(x,
y)$, an application of `f` to `(Hyperdual x 1 0 0)` and 
`(Hyperdual y 0 1 0)` will result in  
`(Hyperdual f(x, y) ∂f/∂x(x, y) ∂f/∂y(x, y) ∂²f/∂x∂y(x, y))`. 

Second derivatives of a single argument $x_i$ of $f$ are computed in
the same manner as the univariate case, except the values 
`(Hyperdual xj 0 0 0)` are passed for the remaining arguments, $j \\neq i$.

You may also use the convenience functions `partial-x`, `partial-y`,
`gradient`, `partial-xx`, `partial-xy`, `partial-yy`, `hessian`, and
`laplacian`, to compute partials of bivariate functions.

 ——————————————————————————————————————————————–

The following list of identities describe the theory of hyperdual numbers,
given $\\varepsilon_1\\varepsilon_2 \\neq 0$ and $\\varepsilon_1^2 = \\varepsilon_2^2 = 0$:

$$
\\begin{aligned}
f(a + b\\varepsilon_1 + c\\varepsilon_2 + d\\varepsilon_1\\varepsilon_2)
&= f(a) + b f'(a)\\varepsilon_1 + c f'(a)\\varepsilon_2 + \\bigl(d f'(a) + bc f''(a)\\bigr)\\varepsilon_1\\varepsilon_2, \\\\\\\\
f(x + \\varepsilon_1 + \\varepsilon_2)
&= f(x) + f'(x)\\varepsilon_1 + f'(x)\\varepsilon_2 + f''(x)\\varepsilon_1\\varepsilon_2, \\\\\\\\
f(x + \\varepsilon_1, y + \\varepsilon_2)
&= f(x, y) + \\frac{\\partial f}{\\partial x}(x, y)\\varepsilon_1 + \\frac{\\partial f}{\\partial y}(x, y)\\varepsilon_2 + \\frac{\\partial^2 f}{\\partial x\\partial y}(x, y)\\varepsilon_1\\varepsilon_2.
\\end{aligned}
$$

 ——————————————————————————————————————————————–

 :: equivalently

 (1) (f (Hyperdual a b c d))
      = (Hyperdual
         (f a)
         (* b (f' a))
         (* c (f' a))
         (+ (* d (f' a)) (* (* b c) (f'' a))))

 (2) (f (Hyperdual x 1 1 0))
      = (Hyperdual (f x) (f' x) (f' x) (f'' x))

 (3) (f (Hyperdual a1 b1 c1 d1) (Hyperdual a2 b2 c2 d2))
      = (Hyperdual
         (f a1 a2)
         (+ (* b1 (∂f/∂x a1 a2)) (* b2 (∂f/∂y a1 a2)))
         (+ (* c1 (∂f/∂x a1 a2)) (* c2 (∂f/∂y a1 a2)))
         (+ (+ (* d1 (∂f/∂x a1 a2)) (* d2 (∂f/∂y a1 a2)))
            (+ (* (* b1 c1) (∂²f/∂x² a1 a2)) (* (* b2 c2) (∂²f/∂y² a1 a2)))
            (* (+ (* b1 c2) (* b2 c1)) (∂²f/∂x∂y a1 a2)))

 (4) (f (Hyperdual x 1 1 0) (Hyperdual y 0 0 0))
      = (Hyperdual (f x y) (∂f/∂x x y) (∂f/∂x x y) (∂²f/∂x² x y))

 (5) (f (Hyperdual x 1 0 0) (Hyperdual y 0 1 0))
      = (Hyperdual (f x y) (∂f/∂x x y) (∂f/∂y x y) (∂²f/∂x∂y x y))

 (6) (f (Hyperdual x 0 0 0) (Hyperdual y 1 1 0))
      = (Hyperdual (f x y) (∂f/∂x x y) (∂f/∂x x y) (∂²f/∂x² x y))"))

(in-package #:coalton/xmath/hyperdual)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel

  (define-type-alias (Hyperdual :t)
    (AD (AD :t))
    "A second-order `AD` value $a + b\\varepsilon_1 + c\\varepsilon_2 + d\\varepsilon_1\\varepsilon_2$.
Comparisons and hashing observe $a$; use nested `Dual` for algebraic equality
on all four coefficients.")

  (inline)
  (declare Hyperdual (:t * :t * :t * :t -> Hyperdual :t))
  (define (Hyperdual a b c d)
    "Construct a hyperdual number $a + b\\varepsilon_1 + c\\varepsilon_2 + d\\varepsilon_1\\varepsilon_2$."
    (make-ad (make-ad a b) (make-ad c d)))

  (define-instance (Additive :t => Into :t (Hyperdual :t))
    (inline)
    (define (into x) (Hyperdual x zero zero zero)))

  (define-instance ((ComplexComponent :t) (Into :t (Hyperdual :t)) => Into (Complex :t) (Complex (Hyperdual :t)))
    (inline)
    (define (into z) (complex (into (real-part z)) (into (imag-part z)))))

  ;; functions

  (define-type-alias (UnOp :t) (:t -> :t))
  (define-type-alias (BinOp :t) (:t * :t -> :t))

  (declare d-x (Semiring :t => UnOp (Hyperdual :t) * :t -> :t))
  (define (d-x f x)
    "Compute $f'(x)$."
    (tangent (primal (f (Hyperdual x one one zero)))))

  (declare d-xx (Semiring :t => UnOp (Hyperdual :t) * :t -> :t))
  (define (d-xx f x)
    "Compute $f''(x)$."
    (tangent (tangent (f (Hyperdual x one one zero)))))

  (declare partial-x (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> :t))
  (define (partial-x f x y)
    "Compute $\\frac{\\partial f}{\\partial x}(x, y)$."
    (tangent (primal (f (Hyperdual x one zero zero) (Hyperdual y zero one zero)))))

  (declare partial-y (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> :t))
  (define (partial-y f x y)
    "Compute $\\frac{\\partial f}{\\partial y}(x, y)$."
    (primal (tangent (f (Hyperdual x one zero zero) (Hyperdual y zero one zero)))))

  (declare gradient (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> List :t))
  (define (gradient f x y)
    "Compute the gradient $\\left(\\frac{\\partial f}{\\partial x}, \\frac{\\partial f}{\\partial y}\\right)$ at the point $(x, y)$."
    (let z = (f (Hyperdual x one zero zero) (Hyperdual y zero one zero)))
    [(tangent (primal z)) (primal (tangent z))])

  (declare partial-xx (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> :t))
  (define (partial-xx f x y)
    "Compute $\\frac{\\partial^2 f}{\\partial x^2}(x, y)$."
    (tangent (tangent (f (Hyperdual x one one zero) (Hyperdual y zero zero zero)))))

  (declare partial-xy (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> :t))
  (define (partial-xy f x y)
    "Compute $\\frac{\\partial^2 f}{\\partial x\\partial y}(x, y)$."
    (tangent (tangent (f (Hyperdual x one zero zero) (Hyperdual y zero one zero)))))

  (declare partial-yy (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> :t))
  (define (partial-yy f x y)
    "Compute $\\frac{\\partial^2 f}{\\partial y^2}(x, y)$."
    (tangent (tangent (f (Hyperdual x zero zero zero) (Hyperdual y one one zero)))))

  (declare laplacian (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> :t))
  (define (laplacian f x y)
    "Compute the Laplacian $\\frac{\\partial^2 f}{\\partial x^2} + \\frac{\\partial^2 f}{\\partial y^2}$ at the point $(x, y)$."
    (+ (partial-xx f x y) (partial-yy f x y)))

  (declare hessian (Semiring :t => BinOp (Hyperdual :t) * :t * :t -> List :t))
  (define (hessian f x y)
    "Compute the flat Hessian $\\left(\\frac{\\partial^2 f}{\\partial x^2}, \\frac{\\partial^2 f}{\\partial x\\partial y}, \\frac{\\partial^2 f}{\\partial y\\partial x}, \\frac{\\partial^2 f}{\\partial y^2}\\right)$ at the point $(x, y)$."
    (let ((xx (partial-xx f x y))
          (xy (partial-xy f x y))
          (yx xy)
          (yy (partial-yy f x y)))
      (Cons xx (Cons xy (Cons yx (Cons yy Nil)))))))

#+sb-package-locks
(sb-ext:lock-package "COALTON/XMATH/HYPERDUAL")
