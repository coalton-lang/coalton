;;;; computable-reals.lisp
;;;;
;;;; Reals library using computable-reals (https://github.com/stylewarning/computable-reals)

(defpackage #:coalton/xmath/computable-reals
  (:documentation "Constructive (computable) real numbers (`CReal`) backed by `computable-reals`.

A computable real number $x \\in \\mathbb{R}$ is represented lazily as a function $k \\mapsto a_k \\in \\mathbb{Z}$ producing dyadic approximations $|a_k 2^{-k} - x| \\le 2^{-k}$ on demand to any requested bit precision $k$, supporting exact field and transcendental arithmetic (`Reciprocable`, `Elementary`, `Approximable`). Because exact equality and ordering of computable reals are undecidable in general, `Eq` and `Ord` compare approximations at a configurable bit threshold (`comparison-threshold`, `with-comparison-threshold`).")
  (:nicknames #:coalton/computable-reals
              #:coalton-library/computable-reals)
  (:use #:coalton
        #:coalton-prelude
        #:coalton/math)
  (:local-nicknames (#:cr #:computable-reals)
                    (#:complex #:coalton/math/complex)
                    (#:math #:coalton/math)
                    (#:dyadic #:coalton/xmath/dyadic)
                    (#:bf #:coalton/xmath/big-float)
                    (#:cell #:coalton/cell))
  (:export
   #:CReal
   #:set-comparison-threshold!
   #:comparison-threshold
   #:with-comparison-threshold
   #:rationalize
   #:cr-print))

(in-package #:coalton/xmath/computable-reals)

;; Setting a default comparison threshold for Eq and Ord
(cl:defvar *creal-comparison-threshold* 106)

;;;
;;; Defining the CReal type as a wrapper around computable-reals
;;;


(coalton-toplevel
  
 (repr :native (cl:or cr:creal cl:rational))
 (define-type CReal)

 (declare set-comparison-threshold! (UFix -> Void))
 (define (set-comparison-threshold! k)
   "Sets the global `CReal` comparison threshold to k bits after the 'decimal' point.

See `comparison-threshold` for more details."
   (lisp (-> Void) (k)
     (cl:progn
       (cl:setq *creal-comparison-threshold* k)
       (cl:values))))

 (declare comparison-threshold (Void -> UFix))
 (define (comparison-threshold)
   "Returns the current `CReal` comparison threshold measured as a number
of bits after the 'decimal' point.

This threshold is used to ensure `Eq` and `Ord` instances
terminate. (In general, computable real arithmetic is undecidable.)
Note that if the production of a `CReal` depends on comparison, *there
is no guarantee that the `CReal` will be accurate to any precision*."
   (lisp (-> UFix) ()
     *creal-comparison-threshold*))

 (declare with-comparison-threshold
   (forall ((:a Values)) ((Void -> :a) &key (:bits UFix) -> :a)))
 (define (with-comparison-threshold f &key (bits (comparison-threshold)))
   "Call F with a temporary `CReal` comparison threshold of BITS."
   (lisp (-> :a) (f bits)
     (cl:let ((*creal-comparison-threshold* bits))
       (call-coalton-function f)))))

;;;
;;; Instances
;;;

(coalton-toplevel
  
  (define-instance (Eq CReal)
    (define (== a b)
      (lisp (-> Boolean) (a b)
        (cl:zerop (cr:approx-r (cr:-r a b)
                               *creal-comparison-threshold*))))))

(coalton-toplevel
  
  (define-instance (Additive CReal)
    (inline)
    (define (+ a b)
      (lisp (-> CReal) (a b)
        (cr:+r a b)))
    (define zero
      (lisp (-> CReal) ()
        0)))

  (define-instance (AdditiveGroup CReal)
    (inline)
    (define (- a b)
      (lisp (-> CReal) (a b)
        (cr:-r a b)))
    (inline)
    (define (neg a)
      (lisp (-> CReal) (a)
        (cr:-r a))))

  (define-instance (Multiplicative CReal)
    (inline)
    (define (* a b)
      (lisp (-> CReal) (a b)
        (cr:*r a b)))
    (define one
      (lisp (-> CReal) ()
        1)))

  (define-instance (Semiring CReal))

  (define-instance (Ring CReal)
    (inline)
    (define (from-int x)
      (lisp (-> CReal) (x)
        x)))

  (define-instance (Num CReal)))

(coalton-toplevel
  
  (define-instance (Ord CReal)
    (define (<=> a b)
      (let diff-approxd = (lisp (-> Integer) (a b)
                            (cr:approx-r (cr:-r a b)
                                         *creal-comparison-threshold*)))
      (cond
        ((math:zero? diff-approxd)
         EQ)
        ((math:positive? diff-approxd)
         GT)
        ((math:negative? diff-approxd)
         LT)))))

(coalton-toplevel
  
  (define-instance (Reciprocable CReal)
    (inline)
    (define (/ a b)
      (lisp (-> CReal) (a b)
        (cr:/r a b)))
    (inline)
    (define (math:recip n)
      (lisp (-> CReal) (n)
        (cr:/r n))))

  (define-instance (math:Scale CReal CReal)
    (inline)
    (define (math:scale a b) (* a b)))

  (define-instance (math:Module CReal CReal))
  (define-instance (math:CommutativeRing CReal))

  (define-instance (math:ConjugateRing CReal)
    (inline)
    (define (math:conjugate x) x))

  (define-instance (math:HermitianForm CReal CReal)
    (inline)
    (define (math:inner-product a b) (* a b))))

(coalton-toplevel

  (define-instance (Dividable Integer CReal)
    (inline)
    (define (general/ a b)
      (/ (from-int a) (from-int b)))))

(coalton-toplevel
  
  (define-instance (math:Exponentiable CReal)

    (inline)
    (define (math:exp x)
      (lisp (-> CReal) (x)
        (cr:exp-r x)))

    (inline)
    (define (math:pow x y)
      (lisp (-> CReal) (x y)
        (cr:expt-r x y)))

    (inline)
    (define (math:ln x)
      (lisp (-> CReal) (x)
        (cr:log-r x)))

    (inline)
    (define (math:log b x)
      (lisp (-> CReal) (x b)
        (cr:log-r x b)))))

(coalton-toplevel
  
  (define-instance (math:Radical CReal)

    (inline)
    (define (math:nth-root n x)
      (lisp (-> CReal) (n x)
        (cr:expt-r x (cl:/ n))))

    (inline)
    (define (math:sqrt x)
      (lisp (-> CReal) (x)
        (cr:sqrt-r x)))))

(coalton-toplevel
  
  (define-instance (math:Trigonometric CReal)

    (inline)
    (define (math:sin x)
      (lisp (-> CReal) (x)
        (cr:sin-r x)))

    (inline)
    (define (math:cos x)
      (lisp (-> CReal) (x)
        (cr:cos-r x)))

    (inline)
    (define (math:tan x)
      (lisp (-> CReal) (x)
        (cr:tan-r x)))

    (define (math:asin x)
      (math:atan (/ x (sqrt (- 1 (* x x))))))

    (define (math:acos x)
      (math:atan (/ (sqrt (- 1 (* x x))) x)))

    (inline)
    (define (math:atan x)
      (lisp (-> CReal) (x)
        (cr:atan-r x)))))


(coalton-toplevel

  (define-instance (complex:ComplexComponent CReal)
    (inline)
    (define (complex a b)
      (complex::%Complex a b))

    (inline)
    (define (real-part z)
      (match z
        ((complex::%Complex a _) a)))

    (inline)
    (define (imag-part z)
      (match z
        ((complex::%Complex _ b) b))))

  (overlap)
  (define-instance ((complex:ComplexComponent :a) (Into :a CReal) => (Into (Complex :a) (Complex CReal)))
    (inline)
    (define (Into x)
      (Complex (Into (real-part x))
               (Into (imag-part x)))))

  ;; Resolve the intersection with Into :a :a without rebuilding the number.
  (overlap)
  (define-instance (Into (Complex CReal) (Complex CReal))
    (inline)
    (define (into z) z)))

(coalton-toplevel

  (define-instance (Elementary CReal)
    (define pi
      (lisp (-> CReal) ()
        cr:+pi-r+))
    (define ee (exp 1))))

(coalton-toplevel

  (define-instance (math:Polar CReal)
    (inline)
    (define (phase z)
      (math:atan2 (imag-part z) (real-part z)))
    (inline)
    (define (polar z)
      (values (magnitude z) (phase z)))))

;;;
;;; Into's
;;;

(coalton-toplevel

  (define-instance (Into F32 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        (cl:rational x))))
  
  (define-instance (Into F64 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        (cl:rational x))))
  
  (define-instance (Into Fraction CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (math:RationalScalars CReal)
    (inline)
    (define (math:embed-fraction q) (into q)))

  (define-instance (Into Integer CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into UFix CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into IFix CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into U64 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I64 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (Into U32 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I32 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (Into U16 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I16 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (Into U8 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I8 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x))))

;;;
;;; Other computable-reals utilities
;;;

(coalton-toplevel

  (declare approx-mantissa (CReal * UFix -> Integer))
  (define (approx-mantissa x k)
    "Computes an approximation of the bits of a given
`CReal`. Specifically, given an object of type `CReal` `x` and a
non-negative integer `k`, return an integer $a$ with

$$
\\vert a\\cdot 2^{-\\mathtt{k}} - \\mathtt{x}\\vert \\leq 2^{-\\mathtt{k}}.
$$"
    (lisp (-> Integer) (x k)
      (cr:approx-r x k)))

  (declare creal-rational-approx (CReal * UFix -> Fraction))
  (define (creal-rational-approx x k)
    "Produce a rational approximation of `x` called $r$ such that

$$
\\vert r - \\mathtt{x} \\vert \\le 2^{-\\mathtt{k}}.
$$"
    (lisp (-> Fraction) (x k)
      (cr:rational-approx-r x k)))

  (declare rationalize (CReal * UFix -> Fraction))
  (define (rationalize x k)
    "Return a simple fraction within $2^{-k}$ of `x`. For an oracle, minimize the denominator in a certified inner interval; minimality in the entire tolerance interval is not decidable in general."
    (let q = (lisp (-> Fraction) (x k)
               (cr:rational-approx-r x (cl:1+ k))))
    (let half-eps = (math:make-fraction 1 (math:lsh 2 (to-integer k))))
    (math:simplest-fraction-between (- q half-eps) (+ q half-eps)))

  ;; this is just for testing purposes. Intentionally not exported.
  (define (raw-approx x)
    "Returns an approximation for `CReal`s."
    (lisp (-> Integer) (x)
      (cr:raw-approx-r x)))

  (declare cr-print (CReal * UFix -> Boolean))
  (define (cr-print x k)
    "Prints a real `x` up to `k` bits of precision."
    (lisp (-> Boolean) (x k)
      (cr:print-r x k))))

(coalton-toplevel

  (define-instance (math:Quantizable CReal)
    (inline)
    (define (floor x)
      (lisp (-> Integer) (x)
        (cr:floor-r x)))
    (inline)
    (define (ceiling x)
      (lisp (-> Integer) (x)
        (cr:ceiling-r x)))
    (inline)
    (define (proper x)
      (lisp (-> Integer * CReal) (x)
        (cr:truncate-r x))))

  (define-instance (math:Approximable CReal Fraction)
    (inline)
    (define (approx prec x)
      (creal-rational-approx x prec)))

  (define-instance (math:Approximable CReal dyadic:Dyadic)
    (inline)
    (define (approx prec x)
      (dyadic:Dyadic (approx-mantissa x prec) (neg (to-integer prec)))))

  (define-instance (math:Approximable CReal bf:BigFloat)
    (define (approx prec x)
      (into (the dyadic:Dyadic (approx prec x)))))

  (declare native-approx ((math:Approximable Fraction :f) (math:Approximable :f Fraction)
                          (math:Dividable Integer :f) => UFix * CReal * :f -> :f))
  (define (native-approx bits x largest)
    (match (lisp (-> (Optional Fraction)) (x)
             (cl:if (cl:rationalp x) (Some x) None))
      ((Some q) (approx bits q))
      ((None)
       (let q = (lisp (-> Fraction) (x bits) (cr:rational-approx-r x (cl:+ bits 4))))
       (let eps = (math:make-fraction 1 (math:lsh 1 (to-integer bits))))
       (let limit = (the Fraction (approx 0 largest)))
       (let y = (fromfrac (min limit (max (neg limit) q))))
       ;; A conservative decision terminates even at a closed-ball boundary.
       (unless (<= (+ (abs (- (the Fraction (approx 0 y)) q)) (/ eps 16)) eps)
         (error "Cannot certify the requested native float precision from this CReal enclosure."))
       y)))

  (define-instance (math:Approximable CReal F32)
    (define (approx prec x)
      (native-approx prec x (lisp (-> F32) () cl:most-positive-single-float))))

  (define-instance (math:Approximable CReal F64)
    (define (approx prec x)
      (native-approx prec x (lisp (-> F64) () cl:most-positive-double-float)))))
