;;;; computable-reals.lisp
;;;;
;;;; Reals library using computable-reals (https://github.com/stylewarning/computable-reals)

(defpackage #:coalton/xmath/computable-reals
  (:documentation "Constructive (computable) real numbers (`CReal`) backed by `computable-reals`.

A computable real is a stored rational or an oracle for dyadic approximations. At precision $k$ the oracle returns an integer $a_k$ with $|a_k 2^{-k} - x| \\le 2^{-k}$. Equality and order are undecidable in general: use `compare-at` for a bounded comparison, not `Eq` or `Ord`.")
  (:nicknames #:coalton/computable-reals
              #:coalton-library/computable-reals)
  (:use #:coalton
        #:coalton-prelude
        #:coalton/math)
  (:local-nicknames (#:cr #:computable-reals)
                    (#:complex #:coalton/math/complex)
                    (#:math #:coalton/math)
                    (#:dyadic #:coalton/xmath/dyadic)
                    (#:bf #:coalton/xmath/big-float))
  (:export
   #:CReal
   #:known-fraction
   #:compare-at
   #:floor-at
   #:ceiling-at
   #:truncate-at
   #:round-at
   #:rationalize
   #:cr-print))

(in-package #:coalton/xmath/computable-reals)

;; Separate from zero only to the precision needed for this output digit.
(cl:defun %positive-index-root (n x)
  (cl:labels ((root-away-from-zero (a p)
                (cl:cond
                  ((cl:minusp a)
                   (cl:when (cl:evenp n) (cl:error "Even root of a negative real."))
                   (cr:-r (root-positive (cr:-r x) p)))
                  (cl:t (root-positive x p))))
              (root-positive (v p)
                ;; The backend probes the sign again in sqrt/log, and can reject
                ;; a tiny positive radicand. Shift the proven magnitude away
                ;; from zero first; an even shift preserves exact square roots.
                (cl:let* ((bits (cl:if (cl:= n 2) (cl:* 2 (cl:ceiling p 2)) p))
                          (scaled (cr:ash-r v bits))
                          (r (cl:if (cl:= n 2)
                                    (cr:sqrt-r scaled)
                                    (cr:expt-r scaled (cl:/ n))))
                          (shift (cl:/ bits n)))
                  (cl:if (cl:integerp shift)
                         (cr:ash-r r (cl:- shift))
                         (cr:*r r (cr:expt-r 2 (cl:- shift)))))))
    (cl:cond
      ((cl:= n 1) x)
      ((cl:eql x 0) 0)
      ((cl:rationalp x)
       (cl:let ((p (cl:- (cl:integer-length (cl:denominator x))
                         (cl:integer-length (cl:abs (cl:numerator x))))))
         (root-away-from-zero x (cl:max 0 p))))
      (cl:t
       (cl:let ((root cl:nil))
         (cr:make-real
          (cl:lambda (k)
            (cl:unless root
              (cl:loop :with limit = (cl:* n (cl:1+ k))
                       :for p = 0 :then (cl:min limit (cl:max 1 (cl:* 2 p)))
                       :for a = (cr:approx-r x p)
                       :when (cl:> (cl:abs a) 1)
                         :do (cl:setf root (root-away-from-zero a p)) (cl:return)
                       :until (cl:= p limit)))
            ;; At the limit |x| <= 2 * 2^(-n*(k+1)), so zero is a
            ;; valid k-bit approximation to its nth root.
            (cl:if root (cr:approx-r root k) 0))))))))

(coalton-toplevel
  (repr :native (cl:or cr:creal cl:rational))
  (define-type CReal)

  (declare known-fraction (CReal -> Optional Fraction))
  (define (known-fraction x)
    "Return the stored exact fraction, if any, without querying an oracle. `None` does not imply irrationality."
    (lisp (-> (Optional Fraction)) (x)
      (cl:if (cl:rationalp x) (Some x) None))))

;;;
;;; Instances
;;;

(coalton-toplevel
  
  (define-instance (HasAdd CReal)
    (inline)
    (define (+ a b)
      (lisp (-> CReal) (a b)
        (cr:+r a b))))

  (define-instance (Additive CReal)
    (define zero
      (lisp (-> CReal) ()
        0)))

  (define-instance (AdditiveGroup CReal)
    (inline)
    (define (- a b)
      (lisp (-> CReal) (a b)
        (cr:-r a b)))
    (inline)
    (define (neg a)
      (lisp (-> CReal) (a)
        (cr:-r a))))

  (define-instance (HasMul CReal)
    (inline)
    (define (* a b)
      (lisp (-> CReal) (a b)
        (cr:*r a b))))

  (define-instance (Multiplicative CReal)
    (define one
      (lisp (-> CReal) ()
        1)))

  (define-instance (Semiring CReal))

  (define-instance (Ring CReal)
    (inline)
    (define (from-int x)
      (lisp (-> CReal) (x)
        x))))

(coalton-toplevel
  
  (define-instance (Reciprocable CReal)
    (inline)
    (define (/ a b)
      (lisp (-> CReal) (a b)
        (cr:/r a b)))
    (inline)
    (define (math:recip n)
      (lisp (-> CReal) (n)
        (cr:/r n))))

  (define-instance (math:Scale CReal CReal)
    (inline)
    (define (math:scale a b) (* a b)))

  (define-instance (math:Module CReal CReal))
  (define-instance (math:CommutativeRing CReal))

  (define-instance (math:ConjugateRing CReal)
    (inline)
    (define (math:conjugate x) x))

  (define-instance (math:HermitianForm CReal CReal)
    (inline)
    (define (math:inner-product a b) (* a b))))

(coalton-toplevel

  (define-instance (Dividable Integer CReal)
    (inline)
    (define (general/ a b)
      (/ (from-int a) (from-int b)))))

(coalton-toplevel
  
  (define-instance (math:Exponentiable CReal)
    (define (math:sinh x) (math:canonical-sinh x))
    (define (math:cosh x) (math:canonical-cosh x))
    (define (math:acosh x) (math:canonical-acosh x))
    (define (math:atanh x) (math:canonical-atanh x))
    (define (math:tanh x) (math:canonical-tanh x))
    (define (math:asinh x) (math:canonical-asinh x))

    (inline)
    (define (math:exp x)
      (lisp (-> CReal) (x)
        (cr:exp-r x)))

    (inline)
    (define (math:pow x y)
      (lisp (-> CReal) (x y)
        (cr:expt-r x y)))

    (inline)
    (define (math:ln x)
      (lisp (-> CReal) (x)
        (cr:log-r x)))

    (inline)
    (define (math:log b x)
      (lisp (-> CReal) (x b)
        (cr:log-r x b)))))

(coalton-toplevel
  
  (define-instance (math:Radical CReal)
    (define (math:hypot x y) (math:canonical-hypot x y))

    (inline)
    (define (math:nth-root n x)
      (lisp (-> CReal) (n x)
        (cl:cond
          ((cl:zerop n) (cl:error "A zeroth root is undefined."))
          ((cl:minusp n) (cr:/r (%positive-index-root (cl:- n) x)))
          (cl:t (%positive-index-root n x)))))

    (inline)
    (define (math:sqrt x)
      (lisp (-> CReal) (x)
        (%positive-index-root 2 x)))))

(coalton-toplevel
  
  (define-instance (math:Trigonometric CReal)

    (inline)
    (define (math:sin x)
      (lisp (-> CReal) (x)
        (cr:sin-r x)))

    (inline)
    (define (math:cos x)
      (lisp (-> CReal) (x)
        (cr:cos-r x)))

    (inline)
    (define (math:tan x)
      (lisp (-> CReal) (x)
        (cr:tan-r x)))

    (define (math:asin x)
      (* 2 (math:atan (/ x (+ 1 (sqrt (* (- 1 x) (+ 1 x))))))))

    (define (math:acos x)
      (- (lisp (-> CReal) () cr:+pi/2-r+) (math:asin x)))

    (inline)
    (define (math:atan x)
      (lisp (-> CReal) (x)
        (cr:atan-r x)))))


(coalton-toplevel

  (define-instance (complex:ComplexComponent CReal)
    (inline)
    (define (complex a b)
      (complex::%Complex a b))

    (inline)
    (define (real-part z)
      (match z
        ((complex::%Complex a _) a)))

    (inline)
    (define (imag-part z)
      (match z
        ((complex::%Complex _ b) b))))

  (overlap)
  (define-instance ((complex:ComplexComponent :a) (Into :a CReal) => (Into (Complex :a) (Complex CReal)))
    (inline)
    (define (Into x)
      (Complex (Into (real-part x))
               (Into (imag-part x)))))

  ;; Resolve the intersection with Into :a :a without rebuilding the number.
  (overlap)
  (define-instance (Into (Complex CReal) (Complex CReal))
    (inline)
    (define (into z) z)))

(coalton-toplevel

  (define-instance (Elementary CReal)
    (define (math:atan2 y x) (math:canonical-atan2 y x))
    (define pi
      (lisp (-> CReal) ()
        cr:+pi-r+))
    (define ee (exp 1))))

;;;
;;; Into's
;;;

(coalton-toplevel

  (define-instance (Into F32 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        (cl:rational x))))
  
  (define-instance (Into F64 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        (cl:rational x))))
  
  (define-instance (Into Fraction CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (math:RationalScalars CReal)
    (inline)
    (define (math:embed-fraction q) (into q)))

  (define-instance (Into Integer CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into UFix CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into IFix CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into U64 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I64 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (Into U32 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I32 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (Into U16 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I16 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))
  
  (define-instance (Into U8 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x)))

  (define-instance (Into I8 CReal)
    (inline)
    (define (Into x)
      (Lisp (-> CReal) (x)
        x))))

;;;
;;; Other computable-reals utilities
;;;

(coalton-toplevel

  (declare approx-mantissa (CReal * UFix -> Integer))
  (define (approx-mantissa x k)
    "Computes an approximation of the bits of a given
`CReal`. Specifically, given an object of type `CReal` `x` and a
non-negative integer `k`, return an integer $a$ with

$$
\\vert a\\cdot 2^{-\\mathtt{k}} - \\mathtt{x}\\vert \\leq 2^{-\\mathtt{k}}.
$$"
    (lisp (-> Integer) (x k)
      (cr:approx-r x k)))

  (declare creal-rational-approx (CReal * UFix -> Fraction))
  (define (creal-rational-approx x k)
    "Produce a rational approximation of `x` called $r$ such that

$$
\\vert r - \\mathtt{x} \\vert \\le 2^{-\\mathtt{k}}.
$$"
    (lisp (-> Fraction) (x k)
      (cr:rational-approx-r x k)))

  (declare rationalize (CReal * UFix -> Fraction))
  (define (rationalize x k)
    "Return a simple fraction within $2^{-k}$ of `x`. For an oracle, minimize the denominator in a certified inner interval; minimality in the entire tolerance interval is not decidable in general."
    (let q = (lisp (-> Fraction) (x k)
               (cr:rational-approx-r x (cl:1+ k))))
    (let half-eps = (math:make-fraction 1 (math:lsh 2 (to-integer k))))
    (math:simplest-fraction-between (- q half-eps) (+ q half-eps)))

  (declare cr-print (CReal * UFix -> Boolean))
  (define (cr-print x k)
    "Prints a real `x` up to `k` bits of precision."
    (lisp (-> Boolean) (x k)
      (cr:print-r x k))))

(coalton-toplevel

  (declare enclosure (UFix * CReal -> Fraction * Fraction))
  (define (enclosure bits x)
    (match (known-fraction x)
      ((Some q) (values q q))
      ((None)
       (let a = (approx-mantissa x bits))
       (let d = (math:lsh 1 bits))
       (values (math:make-fraction (1- a) d)
               (math:make-fraction (1+ a) d)))))

  (declare compare-at (UFix * CReal * CReal -> Optional Ordering))
  (define (compare-at bits x y)
    "Compare stored rationals exactly. Otherwise request one enclosure per operand at `bits` binary places. Return `Some LT` or `Some GT` for strictly separated closed enclosures, `Some EQ` only for equal stored rationals, and `None` otherwise."
    (let (values xl xh) = (enclosure bits x))
    (let (values yl yh) = (enclosure bits y))
    (cond
      ((< xh yl) (Some LT))
      ((> xl yh) (Some GT))
      ((and (== xl xh) (== yl yh)) (Some EQ))
      (True None)))

  ;; Integer rounding is monotone: agreement at both closed endpoints
  ;; certifies the result everywhere between them, including at a tie.
  (declare integer-image-at ((Fraction -> Integer) * UFix * CReal -> Optional Integer))
  (define (integer-image-at f bits x)
    (let (values lo hi) = (enclosure bits x))
    (let n = (f lo))
    (if (== n (f hi)) (Some n) None))

  (declare floor-at (UFix * CReal -> Optional Integer))
  (define (floor-at bits x)
    "Return the floor if certified at `bits` binary places; otherwise `None`."
    (integer-image-at floor bits x))

  (declare ceiling-at (UFix * CReal -> Optional Integer))
  (define (ceiling-at bits x)
    "Return the ceiling if certified at `bits` binary places; otherwise `None`."
    (integer-image-at ceiling bits x))

  (declare truncate-at (UFix * CReal -> Optional Integer))
  (define (truncate-at bits x)
    "Truncate toward zero if certified at `bits` binary places; otherwise return `None`."
    (integer-image-at truncate bits x))

  (declare round-at (UFix * CReal -> Optional Integer))
  (define (round-at bits x)
    "Round to nearest, ties to even, if certified at `bits` binary places; otherwise return `None`."
    (integer-image-at round bits x))

  (define-instance (math:Approximable CReal Fraction)
    (inline)
    (define (approx prec x)
      (creal-rational-approx x prec)))

  (define-instance (math:Approximable CReal dyadic:Dyadic)
    (inline)
    (define (approx prec x)
      (dyadic:Dyadic (approx-mantissa x prec) (neg (to-integer prec)))))

  (define-instance (math:Approximable CReal bf:BigFloat)
    (define (approx prec x)
      (into (the dyadic:Dyadic (approx prec x)))))

  (declare native-approx ((math:Approximable Fraction :f) (math:Approximable :f Fraction)
                          (math:Dividable Integer :f) => UFix * CReal * :f -> :f))
  (define (native-approx bits x largest)
    (match (known-fraction x)
      ((Some q) (approx bits q))
      ((None)
       (let q = (lisp (-> Fraction) (x bits) (cr:rational-approx-r x (cl:+ bits 4))))
       (let eps = (math:make-fraction 1 (math:lsh 1 (to-integer bits))))
       (let limit = (the Fraction (approx 0 largest)))
       (let y = (fromfrac (min limit (max (neg limit) q))))
       ;; A conservative decision terminates even at a closed-ball boundary.
       (unless (<= (+ (abs (- (the Fraction (approx 0 y)) q)) (/ eps 16)) eps)
         (error "Cannot certify the requested native float precision from this CReal enclosure."))
       y)))

  (define-instance (math:Approximable CReal F32)
    (define (approx prec x)
      (native-approx prec x (lisp (-> F32) () cl:most-positive-single-float))))

  (define-instance (math:Approximable CReal F64)
    (define (approx prec x)
      (native-approx prec x (lisp (-> F64) () cl:most-positive-double-float)))))
