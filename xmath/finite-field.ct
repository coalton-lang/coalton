;;;; Certified finite fields and type-indexed coefficients

(coalton/utils:defstdlib-package #:coalton/xmath/finite-field
  (:documentation "Prime fields $\\mathbb{F}_p=\\mathbb{Z}/p\\mathbb{Z}$ and finite extensions $K[x]/(f)$. `prime-field` requires a proof of primality, not a probable-prime test. `extension-field` checks irreducibility over the actual coefficient field. If $|K|=q$ and $\\deg f=d$, the new field has $q^d$ elements and the same characteristic as $K$.

A `FieldPresentation` can be used as an explicit quotient context, or associated with a fixed type by `KnownField`. Only the latter gives `FieldElement` a context-free zero, one, and lawful field operations. The enumeration `field-element` differs from the integer embedding `from-int`: in an extension its index is read in base $q$ as the indices of successive polynomial coefficients.

The multiplicative group of $\\mathbb{F}_q$ is cyclic of order $q-1$, so a primitive $n$th root exists exactly when $n>0$ divides $q-1$. `try-root-of-unity` returns a coherent family of such roots. The `RootsOfUnity` method signals an error for unsupported orders; `ntt` and `inverse-ntt` return `None` unless the vector length is also a power of two. Both transforms use the radix-two FFT butterflies, with the forward sign and inverse normalization of `coalton/xmath/fft`.")
  (:use #:coalton #:coalton/builtin #:coalton/classes #:coalton/math/arith #:coalton/math/integral)
  (:import-from #:coalton/functions #:/=)
  (:import-from #:coalton/xmath/quotient #:representative #:from-representative)
  (:local-nicknames
   (#:bits #:coalton/bits)
   (#:factor #:coalton/xmath/integer-factorization)
   (#:fft #:coalton/xmath/fft)
   (#:list #:coalton/list)
   (#:modular #:coalton/xmath/modular)
   (#:opt #:coalton/optional)
   (#:poly #:coalton/xmath/polynomial)
   (#:qr #:coalton/xmath/quotient)
   (#:types #:coalton/types)
   (#:vec #:coalton/vector))
  (:export
   #:FieldPresentation #:prime-field #:extension-field #:as-quotient #:order #:characteristic
   #:residue-at #:KnownField #:presentation #:FieldElement #:Fp #:Extension
   #:P2 #:P3 #:P5 #:P17 #:GF4 #:representative #:from-representative
   #:FiniteField #:field-order #:field-characteristic #:field-element #:irreducible?
   #:residue-root-of-unity #:try-root-of-unity #:ntt #:inverse-ntt))

(in-package #:coalton/xmath/finite-field)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (define-type (FieldPresentation :r)
    "A quotient by a certified prime or irreducible modulus."
    (%Field (qr:QuotientRing :r) Integer Integer (Integer -> :r)))

  (declare as-quotient (FieldPresentation :r -> qr:QuotientRing :r))
  (define (as-quotient (%Field ring _ _ _)) ring)

  (declare characteristic (FieldPresentation :r -> Integer))
  (define (characteristic (%Field _ p _ _)) p)

  (declare order (FieldPresentation :r -> Integer))
  (define (order (%Field _ _ q _)) q)

  (declare index-representative (FieldPresentation :r * Integer -> :r))
  (define (index-representative (%Field _ _ q index) i)
    (index (mod i q)))

  (declare residue-at (FieldPresentation :r * Integer -> qr:Residue :r))
  (define (residue-at field i)
    "Enumerate a dynamic field by index, taken modulo its order."
    (qr:residue (as-quotient field) (index-representative field i)))

  (declare prime-field (Integer -> Optional (FieldPresentation Integer)))
  (define (prime-field p)
    "Construct $\\mathbb{F}_p$ only for a proven prime. `None` includes inconclusive primality results."
    (if (== (factor:primality p) factor:ProvenPrime)
        (map (fn (ring) (%Field ring p p (fn (i) i))) (qr:integer-quotient p))
        None))

  (define-class ((Eq :r) (EuclideanDomain :r) => KnownField :tag :r (:tag -> :r))
    "A type-level name for one certified quotient: `presentation` must be immutable and independent of ambient state. Define a tag and an instance returning a previously constructed `FieldPresentation` to name another field."
    (presentation (types:Proxy :tag -> FieldPresentation :r)))

  ;; A field tag gets its ring from its checked presentation, never from
  ;; an independently chosen KnownQuotient instance for the same user tag.
  (define-type (Certified :tag) %Certified)
  (define-instance (KnownField :tag :r => qr:KnownQuotient (Certified :tag) :r)
    (define (qr:fixed-quotient _) (as-quotient (presentation (the (types:Proxy :tag) types:Proxy)))))

  (define-type-alias (FieldElement :tag :r) (qr:ResidueClass (Certified :tag) :r)
    "A canonical representative of the fixed field named by the phantom type parameter.")

  (define-type-alias (Fp :p) (FieldElement :p Integer)
    "An element of a statically named prime field.")
  (define-type-alias (Extension :tag :k) (FieldElement :tag (poly:Polynomial :k))
    "An element of a statically named extension of the coefficient field.")

  (define-instance (KnownField :tag :r => Reciprocable (FieldElement :tag :r))
    (define (recip a)
      (opt:from-some "Zero has no reciprocal in a field." (qr:unit-inverse a)))
    (define (/ a b) (* a (recip b))))

  (define-instance (KnownField :tag :r => DivisionRing (FieldElement :tag :r)))
  (define-instance (KnownField :tag :r => GcdDomain (FieldElement :tag :r))
    (define (unit-part a) (if (zero? a) one a))
    (define (normal-part a) (if (zero? a) zero one))
    (define (exact-quot a b) (if (zero? b) None (Some (/ a b))))
    (define (gcd a b) (if (and (zero? a) (zero? b)) zero one)))
  (define-instance (KnownField :tag :r => Field (FieldElement :tag :r)))

  (define-class ((Eq :a) (Field :a) => FiniteField :a)
    "An exact field of order $q=p^d$ with a bijection from $[0,q)$ to its elements. The indices zero and one name the corresponding identities."
    (field-characteristic (types:Proxy :a -> Integer))
    (field-order (types:Proxy :a -> Integer))
    (field-element (Integer -> :a)))

  (define-instance (KnownField :tag :r => FiniteField (FieldElement :tag :r))
    (define (field-characteristic _)
      (characteristic (presentation (the (types:Proxy :tag) types:Proxy))))
    (define (field-order _)
      (order (presentation (the (types:Proxy :tag) types:Proxy))))
    (define (field-element i)
      (from-representative (index-representative (presentation (the (types:Proxy :tag) types:Proxy)) i))))

  (declare irreducible? (forall (:k) FiniteField :k => poly:Polynomial :k -> Boolean))
  (define (irreducible? f)
    "Test irreducibility over $\\mathbb{F}_q$. Any reducible polynomial of degree $d$ has an irreducible divisor of degree $1\\le i\\le d/2$, which divides $x^{q^i}-x$. Successive $q$th powers are computed modulo the monic associate of $f$. Constants (including zero) are not irreducible."
    (let d = (poly:degree f))
    (cond
      ((== d 0) False)
      ((== d 1) True)
      (True
       (let m = (normal-part f))
       (let q = (field-order (the (types:Proxy :k) types:Proxy)))
       (let x = poly:poly-var)
       (rec test ((i 1) (h x))
         (let next = (modular:mod-expt h q m))
         (and (== one (euclidean-gcd m (- next x)))
              (or (== i (quot d 2))
                  (test (+ i 1) next)))))))

  (declare extension-field
    (forall (:k) FiniteField :k => poly:Polynomial :k -> Optional (FieldPresentation (poly:Polynomial :k))))
  (define (extension-field f)
    "Construct $K[x]/(f)$ as a field only if $f$ is irreducible over $K$."
    (cond
      ((not (irreducible? f)) None)
      (True
       (let base = (the (types:Proxy :k) types:Proxy))
       (let q = (field-order base))
       (let index =
         (fn (i)
           (poly:polynomial
            (rec digits ((n i) (acc Nil))
              (if (zero? n)
                  (list:reverse acc)
                  (digits (quot n q) (Cons (field-element (mod n q)) acc)))))))
       (map (fn (ring) (%Field ring (field-characteristic base) (^ q (poly:degree f)) index))
            (qr:polynomial-quotient f)))))

  (define-type P2 P2)
  (define-type P3 P3)
  (define-type P5 P5)
  (define-type P17 P17)

  (define field2 (opt:from-some "Expected 2 to be prime." (prime-field 2)))
  (define field3 (opt:from-some "Expected 3 to be prime." (prime-field 3)))
  (define field5 (opt:from-some "Expected 5 to be prime." (prime-field 5)))
  (define field17 (opt:from-some "Expected 17 to be prime." (prime-field 17)))
  (define-instance (KnownField P2 Integer) (define (presentation _) field2))
  (define-instance (KnownField P3 Integer) (define (presentation _) field3))
  (define-instance (KnownField P5 Integer) (define (presentation _) field5))
  (define-instance (KnownField P17 Integer) (define (presentation _) field17))

  (define-type BinaryQuadratic BinaryQuadratic)
  (define-type-alias GF4 (Extension BinaryQuadratic (Fp P2))
    "The binary extension $\\mathbb{F}_2[x]/(x^2+x+1)$.")
  (declare field4 (FieldPresentation (poly:Polynomial (Fp P2))))
  (define field4
    (opt:from-some "Expected x^2+x+1 to be irreducible over F2."
                   (extension-field (poly:polynomial [1 1 1]))))
  (define-instance (KnownField BinaryQuadratic (poly:Polynomial (Fp P2)))
    (define (presentation _) field4)))

(coalton-toplevel
  (declare residue-root-of-unity
    ((Eq :r) (EuclideanDomain :r) => FieldPresentation :r * UFix -> Optional (qr:Residue :r)))
  (define (residue-root-of-unity field n)
    "Return a primitive root of order $n$ in this explicit field, or `None` if the order is impossible. Factors only $n$, not the field order minus one. Finding a non-power by deterministic enumeration can be expensive in large extensions."
    (let ring = (as-quotient field))
    (let size = (- (order field) 1))
    (let n = (to-integer n))
    (cond
      ((or (== n 0) (/= 0 (rem size n))) None)
      ((== n 1) (Some (qr:residue ring one)))
      ((== n 2) (Some (qr:residue ring (neg one))))
      (True
       (let m = (qr:modulus ring))
       (let power = (fn (a e) (qr:reduce-representative ring (modular:mod-expt a e m))))
       (let (factor:Factorization _ powers) =
         (opt:from-some "A positive order has a factorization." (factor:factor-integer-exact n)))
       (rec combine ((factors powers) (w one))
         (match factors
           ((Nil) (Some (qr:residue ring w)))
           ((Cons (Tuple ell e) rest)
            ;; The first ell-th non-power depends only on the field and ell,
            ;; not on n. Its successive ell-power roots are thus compatible.
            (let witness =
              (rec search ((i 2))
                (when (> i size)
                  (error "Finite field enumeration has no non-power."))
                (let a = (index-representative field i))
                (if (/= (power a (quot size ell)) one)
                    a
                    (search (+ i 1)))))
            (let h = (^ ell e))
            ;; w^(n/h) must be witness^((q-1)/h). Combine these independent
            ;; prime-power projections by CRT in the exponents.
            (let weight = (opt:from-some "Distinct prime powers are coprime."
                                         (modular:mod-inv (quot n h) h)))
            (let component = (power witness (* (quot size h) weight)))
            (combine rest (qr:reduce-representative ring (* w component)))))))))

  (declare try-root-of-unity
    (forall (:tag :r) KnownField :tag :r => UFix -> Optional (FieldElement :tag :r)))
  (define (try-root-of-unity n)
    "Return a primitive $n$th root if $n\\mid(q-1)$ and $n>0$. For $d\\mid n$, the $d$th power of the chosen $n$th root is the chosen $(n/d)$th root."
    (let field = (presentation (the (types:Proxy :tag) types:Proxy)))
    (map (fn (a) (from-representative (qr:residue-value a)))
         (residue-root-of-unity field n)))

  (define-instance (KnownField :tag :r => fft:RootsOfUnity (FieldElement :tag :r))
    (define (fft:root-of-unity n)
      (opt:from-some "A finite-field root order must be positive and divide the field order minus one."
                     (try-root-of-unity n))))

  (declare transform
    (forall (:tag :r) KnownField :tag :r =>
     Boolean * vec:Vector (FieldElement :tag :r) -> Optional (vec:Vector (FieldElement :tag :r))))
  (define (transform inverse? xs)
    (let n = (vec:length xs))
    (let q = (field-order (the (types:Proxy (FieldElement :tag :r)) types:Proxy)))
    (cond
      ((or (== n 0) (/= 0 (bits:and n (- n 1))) (/= 0 (rem (- q 1) (to-integer n)))) None)
      ((== n 1) (Some (vec:copy xs)))
      (inverse? (Some (fft:ifft! (vec:copy xs))))
      (True (Some (fft:fft! (vec:copy xs))))))

  (declare ntt
    (KnownField :tag :r => vec:Vector (FieldElement :tag :r) -> Optional (vec:Vector (FieldElement :tag :r))))
  (define (ntt xs)
    "Compute the allocating radix-two number-theoretic transform, or return `None` for an unsupported length."
    (transform False xs))

  (declare inverse-ntt
    (KnownField :tag :r => vec:Vector (FieldElement :tag :r) -> Optional (vec:Vector (FieldElement :tag :r))))
  (define (inverse-ntt xs)
    "Invert `ntt` with the same length preconditions and the normalization $1/n$."
    (transform True xs)))

#+sb-package-locks
(sb-ext:lock-package "COALTON/XMATH/FINITE-FIELD")
