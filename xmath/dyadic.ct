;;; dyadic.lisp
;;;
;;; Dyadic rationals meant for implementing big floats
;;; It is not exported into the math package as it is a niche numeric type

(coalton/utils::defstdlib-package #:coalton/xmath/dyadic
    (:nicknames
     #:coalton/math/dyadic
     #:coalton-library/math/dyadic)
    (:use
     #:coalton
     #:coalton/builtin
     #:coalton/classes
     #:coalton/math/arith
     #:coalton/math/integral
     #:coalton/math/real)
  (:local-nicknames
   (#:bits #:coalton/bits))
  (:export
   #:Dyadic
   #:integer
   #:simplify
   #:simplify-integer
   #:scale
   #:shift))

(in-package #:coalton/xmath/dyadic)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  (define-type Dyadic
    "`(Dyadic n k)` represents the rational $\\mathtt{n}\\cdot 2^{\\mathtt{k}}$."
    (Dyadic Integer Integer))

  (declare exact-ilog (Integer * Integer -> (Optional Integer)))
  (define (exact-ilog b x)
    "Compute `k` such that `x = b^k` when it exists."
    (if (or (<= b 1)
            (<= x 0))
        None
        (rec go ((y x)
                 (k 0))
          (if (== y 1)
              (Some k)
              (if (== 0 (mod y b))
                  (go (quot y b) (+ k 1))
                  None)))))

  (declare dyadic-bit-length (Integer -> Integer))
  (define (dyadic-bit-length n)
    (lisp (-> Integer) (n)
      (cl:integer-length (cl:abs n))))

  (declare dyadic-ctz (Integer -> Integer))
  (define (dyadic-ctz n)
    (lisp (-> Integer) (n)
      (cl:1- (cl:integer-length (cl:logand n (cl:- n))))))

  (declare dyadic-compare
    (forall ((:a Values)) ((Integer * Integer -> :a) * Dyadic * Dyadic -> :a)))
  (define (dyadic-compare f a b)
    "Return the result of a comparision function `f` on two dyadics `a` and
`b`."
    (match (Tuple a b)
      ((Tuple (Dyadic n k)
              (Dyadic m j))
       (cond
         ((or (== n 0) (== m 0))
          (f (sign n) (sign m)))
         ((not (== (< n 0) (< m 0)))
          (f (sign n) (sign m)))
         ((== k j)
          (f n m))
         (True
          (let mag-a = (+ (dyadic-bit-length n) k))
          (let mag-b = (+ (dyadic-bit-length m) j))
          (if (not (== mag-a mag-b))
              (if (> n 0)
                  (f mag-a mag-b)
                  (f mag-b mag-a))
              (if (> j k)
                  (f n (lsh m (- j k)))
                  (f (lsh n (- k j)) m))))))))

  (define-instance (Eq Dyadic)
    (define (== a b)
      (dyadic-compare == a b)))

  (define-instance (Ord Dyadic)
    (define (<=> a b)
      (dyadic-compare <=> a b)))

  (declare dyadic-group ((Integer * Integer -> Integer)
                         * Dyadic * Dyadic -> Dyadic))
  (define (dyadic-group f a b)
    "Apply an operation `f` on `a` and `b` with matching exponents."
    (match (Tuple a b)
      ((Tuple (Dyadic n k)
              (Dyadic m j))
       (cond
         ((== n 0) (Dyadic (f 0 m) j))
         ((== m 0) (Dyadic (f n 0) k))
         ((< k j)
          (Dyadic (f n (lsh m (- j k))) k))
         (True
          (Dyadic (f (lsh n (- k j)) m) j))))))

  (define-instance (Num Dyadic)
    (define (+ a b)
      (dyadic-group + a b))
    (define (- a b)
      (dyadic-group - a b))
    (define (* a b)
      (match (Tuple a b)
        ((Tuple (Dyadic n k)
                (Dyadic m j))
         (if (or (== n 0) (== m 0))
             (Dyadic 0 0)
             (Dyadic (* n m) (+ j k))))))
    (define (fromInt x) (Dyadic x 0)))

  (declare simplify-integer (Integer -> Dyadic))
  (define (simplify-integer n)
    "Finds the simplest dyadic given an integer."
    (if (== n 0)
        (Dyadic 0 0)
        (progn
          (let tz = (dyadic-ctz n))
          (Dyadic (rsh n tz) tz))))

  (declare simplify (Dyadic -> Dyadic))
  (define (simplify d)
    "Simplifies a dyadic by maximizing the absolute value of the exponent."
    (match d
      ((Dyadic m k)
       (if (== m 0)
           (Dyadic 0 0)
           (progn
             (let tz = (dyadic-ctz m))
             (Dyadic (rsh m tz) (+ k tz)))))))

  (define-instance (Into Dyadic Fraction)
    (define (into a)
      (match a
        ((Dyadic n k)
         (cond
           ((or (== n 0) (== k 0)) (fromInt n))
           ((> k 0) (fromInt (lsh n k)))
           (True
            (let tz = (dyadic-ctz n))
            (let shift = (negate k))
            (if (>= tz shift)
                (fromInt (rsh n shift))
                (exact/ (rsh n tz) (lsh 1 (- shift tz))))))))))

  (define-instance (Quantizable Dyadic)
    (define (proper x)
      (match x
        ((Dyadic n k)
         (cond
           ((== n 0) (values 0 (Dyadic 0 0)))
           ((>= k 0) (values (lsh n k) (Dyadic 0 0)))
           (True
            (let shift = (negate k))
            (let abs-n = (abs n))
            (let len = (dyadic-bit-length abs-n))
            (if (<= len shift)
                (values 0 x)
                (progn
                  (let q-abs = (rsh abs-n shift))
                  (let r-abs = (lisp (-> Integer) (abs-n shift)
                                 (cl:ldb (cl:byte shift 0) abs-n)))
                  (if (< n 0)
                      (values (negate q-abs) (Dyadic (negate r-abs) k))
                      (values q-abs (Dyadic r-abs k))))))))))
    (define (floor x)
      (match x
        ((Dyadic n k)
         (cond
           ((== n 0) 0)
           ((>= k 0) (lsh n k))
           ((< (+ (dyadic-bit-length n) k) 0)
            (if (< n 0) -1 0))
           (True (lsh n k))))))
    (define (ceiling x)
      (match x
        ((Dyadic n k)
         (negate (floor (Dyadic (negate n) k)))))))

  (specialize round dyadic-round (Dyadic -> Integer))
  (define (dyadic-round x)
    "Rounds a dyadic to the nearest integer with ties going to even
numbers."
    (match x
      ((Dyadic n k)
       (cond
         ((== n 0) 0)
         ((>= k 0) (lsh n k))
         (True
          (let shift = (negate k))
          (let abs-n = (abs n))
          (let len = (dyadic-bit-length abs-n))
          (if (< len shift)
              0
              (progn
                (let q = (rsh abs-n shift))
                (let half? = (lisp (-> Boolean) (abs-n shift)
                               (cl:logbitp (cl:1- shift) abs-n)))
                (let mag =
                  (if (not half?)
                      q
                      (if (odd? q)
                          (+ q 1)
                          (if (and (> shift 1)
                                   (lisp (-> Boolean) (abs-n shift)
                                     (cl:ldb-test (cl:byte (cl:1- shift) 0) abs-n)))
                              (+ q 1)
                              q))))
                (if (< n 0)
                    (negate mag)
                    mag))))))))

  (define-instance (Real Dyadic)
    (define (real-approx a x)
      (real-approx a (the Fraction (into x)))))

  (define-instance (Rational Dyadic)
    (define (to-fraction x) (into x))
    (define (best-approx x) (into x)))

  (define-instance (Into Integer Dyadic)
    (define into fromInt))

  (declare scale (Dyadic * Integer -> Dyadic))
  (define (scale x j)
    "Scales a dyadic `x` by $2^{\\mathtt{k}}$."
    (match x
      ((Dyadic n k)
       (if (== n 0)
           (Dyadic 0 0)
           (Dyadic n (+ k j))))))

  (declare shift (UFix * Dyadic -> Dyadic))
  (define (shift k a)
    "Shift dyadic `a` to its floor with $\\mathtt{k}+1$ bits of precision."
    (let (Dyadic m e) = a)
    (if (== m 0)
        a
        (progn
          (let j = (- (dyadic-bit-length m) 1))
          (let delta = (- j (toInteger k)))
          (if (<= delta 0)
              a
              (Dyadic (rsh m delta) (+ delta e)))))))

#+sb-package-locks
(sb-ext:lock-package "COALTON/XMATH/DYADIC")
