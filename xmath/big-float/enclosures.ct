;;;; Closed fixed-point enclosures for the portable directed-rounding kernels.
;;;; Both endpoints are integers in units of 2^-w. No BigFloat operation, host
;;;; transcendental, or guard-bit approximation is used to establish a bound.

(in-package #:coalton/xmath/big-float)

(cl:define-condition uncertified-rounding (cl:arithmetic-error)
  ((reason :initarg :reason :reader uncertified-reason))
  (:report (cl:lambda (c s)
             (cl:format s "Cannot certify directed BigFloat ~A: ~A."
                        (cl:arithmetic-error-operation c) (uncertified-reason c)))))

(coalton-toplevel
  (declare cannot-certify (forall (:a) (String * String -> :a)))
  (define (cannot-certify op reason)
    (lisp (-> :a) (op reason)
      (cl:error 'uncertified-rounding :operation op :operands cl:nil :reason reason)))

  (define-type Bounds (Bounds Integer Integer))

  (define (bounds+ (Bounds a b) (Bounds c d))
    (Bounds (+ a c) (+ b d)))

  (define (bounds-times-int (Bounds a b) n)
    (if (< n 0) (Bounds (* n b) (* n a)) (Bounds (* n a) (* n b))))

  (define (bounds- x y) (bounds+ x (bounds-times-int y -1)))

  (define (bounds-div-int (Bounds a b) n)
    ;; n > 0
    (Bounds (floor/ a n) (ceiling/ b n)))

  (declare bounds* (Bounds * Bounds * Integer -> Bounds))
  (define (bounds* (Bounds a b) (Bounds c d) unit)
    (let ac = (* a c))
    (let ad = (* a d))
    (let bc = (* b c))
    (let bd = (* b d))
    (Bounds (floor/ (min (min ac ad) (min bc bd)) unit)
            (ceiling/ (max (max ac ad) (max bc bd)) unit)))

  (define (bounds/ x (Bounds c d) unit)
    (cond
      ((and (<= c 0) (>= d 0)) None)
      (True
       (let u2 = (* unit unit))
       (Some (bounds* x (Bounds (floor/ u2 d) (ceiling/ u2 c)) unit)))))

  (define (bounds-mag (Bounds a b)) (max (abs a) (abs b)))

  (define (bounds-widen (Bounds a b) radius)
    (Bounds (- a radius) (+ b radius)))

  (declare bounds-dyadic (Dyadic * Integer -> Bounds))
  (define (bounds-dyadic (Dyadic m k) w)
    (let shift = (+ k w))
    (let lo = (lsh m shift))
    (let hi = (neg (lsh (neg m) shift)))
    (Bounds lo hi))

  (define (bounds-ratio n d unit)
    (bounds-div-int (Bounds (* n unit) (* n unit)) d))

  (define-type TaylorSeries ExpSeries SinSeries CosSeries)

  (declare taylor-bounds (TaylorSeries * Bounds * Integer -> Bounds))
  (define (taylor-bounds series x unit)
    ;; |x| <= 1. After the first omitted term the ratios of successive
    ;; terms have magnitude <= 1/2, so twice its magnitude bounds the tail.
    (let (Tuple start n) = (match series
                             ((SinSeries) (Tuple x 1))
                             (_ (Tuple (Bounds unit unit) 0))))
    (let step = (match series
                  ((ExpSeries) x)
                  (_ (bounds-times-int (bounds* x x unit) -1))))
    (rec go ((n n) (term start) (sum start))
      (let (Tuple j divisor) = (match series
                                 ((ExpSeries) (Tuple (+ n 1) (+ n 1)))
                                 (_ (Tuple (+ n 2) (* (+ n 1) (+ n 2))))))
      (let next = (bounds-div-int (bounds* term step unit) divisor))
      (let mag = (bounds-mag next))
      (if (<= mag 2)
          (bounds-widen sum (* 2 mag))
          (go j next (bounds+ sum next)))))

  (declare exp-bounds (Dyadic * Integer -> Bounds))
  (define (exp-bounds (Dyadic m k) w)
    (let unit = (lsh 1 w))
    (let s = (max 0 (+ k (lisp (-> Integer) (m) (cl:integer-length (cl:abs m))))))
    (let x = (bounds-dyadic (Dyadic m (- k s)) w))
    (rec go ((i s) (v (taylor-bounds ExpSeries x unit)))
      (if (== i 0) v (go (- i 1) (bounds* v v unit)))))

  (declare odd-series-bounds (Bounds * Integer * Boolean -> Bounds))
  (define (odd-series-bounds x unit alternating?)
    ;; atan or atanh, |x| <= 1/2. Bound the *whole* omitted tail by a
    ;; geometric series of ratio 1/4, including all fixed-point errors.
    (let square = (bounds* x x unit))
    (let step = (if alternating? (bounds-times-int square -1) square))
    (rec go ((j 1) (power x) (sum x))
      (let n = (+ j 2))
      (let next = (bounds* power step unit))
      (let term = (bounds-div-int next n))
      (let mag = (bounds-mag term))
      (if (<= mag 2)
          (bounds-widen sum (* 2 mag))
          (go n next (bounds+ sum term)))))

  (define (pi-bounds w)
    ;; Machin: pi = 16 atan(1/5) - 4 atan(1/239).
    (let unit = (lsh 1 w))
    (let atan-1/n = (fn (n) (odd-series-bounds (bounds-ratio 1 n unit) unit True)))
    (bounds+ (bounds-times-int (atan-1/n 5) 16)
             (bounds-times-int (atan-1/n 239) -4)))

  (define (ln2-bounds w)
    (let unit = (lsh 1 w))
    (bounds-times-int (odd-series-bounds (bounds-ratio 1 3 unit) unit False) 2))

  (declare ln-bounds (Dyadic * Integer -> Bounds))
  (define (ln-bounds (Dyadic m k) w)
    ;; x = 2^e f, 1 <= f < 2.  ln(f) = 2 atanh((f-1)/(f+1)).
    (let j = (lisp (-> Integer) (m) (cl:1- (cl:integer-length m))))
    (let e = (+ k j))
    (let one = (lsh 1 j))
    (let unit = (lsh 1 w))
    (let ln-f = (if (== m one)
                    (Bounds 0 0)
                    (bounds-times-int
                     (odd-series-bounds (bounds-ratio (- m one) (+ m one) unit) unit False) 2)))
    (if (== e 0) ln-f (bounds+ ln-f (bounds-times-int (ln2-bounds w) e))))

  (define (bounds-ln (Bounds a b) w)
    (when (<= a 0) (return None))
    (let (Bounds lo _) = (ln-bounds (Dyadic a (neg w)) w))
    (let (Bounds _ hi) = (ln-bounds (Dyadic b (neg w)) w))
    (Some (Bounds lo hi)))

  (define (bounds-sqrt (Bounds a b) unit)
    ;; Only used where the mathematical argument is known nonnegative.
    (let hi = (isqrt (* b unit)))
    (Bounds (isqrt (* (max 0 a) unit)) (if (== (* hi hi) (* b unit)) hi (+ hi 1))))

  (define-type CircularFunction Sine Cosine Tangent)

  (declare circular-bounds (CircularFunction * Dyadic * Integer -> Optional Bounds))
  (define (circular-bounds op x w)
    (let unit = (lsh 1 w))
    (let a = (bounds-dyadic x w))
    (let (Tuple q r) =
      (cond
        ((<= (bounds-mag a) unit) (Tuple 0 a))
        (True
         (let half-pi = (bounds-div-int (pi-bounds w) 2))
         (let (Bounds l h) = a)
         (let (Bounds p s) = half-pi)
         (let q = (lisp (-> Integer) (l h p s) (cl:values (cl:round (cl:+ l h) (cl:+ p s)))))
         (Tuple q (bounds- a (bounds-times-int half-pi q))))))
    ;; Any integer quadrant is valid, provided its entire residual is in
    ;; the Taylor kernel's domain. The quotient need not be correctly rounded.
    (when (> (bounds-mag r) unit) (return None))
    (let sample = (fn (j)
                    (let series = (if (even? j) SinSeries CosSeries))
                    (bounds-times-int (taylor-bounds series r unit) (if (< (mod j 4) 2) 1 -1))))
    (match op
      ((Sine) (Some (sample q)))
      ((Cosine) (Some (sample (+ q 1))))
      ((Tangent) (bounds/ (sample q) (sample (+ q 1)) unit))))

  (declare angle-bounds (Bounds * Bounds * Boolean * Boolean * Integer -> Optional Bounds))
  (define (angle-bounds y x neg-y? neg-x? w)
    ;; atan2 of known signs, with x,y enclosures of the magnitudes.
    (let unit = (lsh 1 w))
    (let one = (Bounds unit unit))
    (let steep? = (> (bounds-mag y) (bounds-mag x)))
    (do
      (t <- (if steep? (bounds/ x y unit) (bounds/ y x unit)))
      (let transform? = (> (* 2 (bounds-mag t)) unit))
      (u <- (if transform? (bounds/ (bounds- t one) (bounds+ t one) unit) (Some t)))
      (cond
        ((> (* 2 (bounds-mag u)) unit) None)
        (True
         (let a = (odd-series-bounds u unit True))
         ;; Collect quarter turns before enclosing pi, including the reflection
         ;; for a negative argument; never negate an already rounded angle.
         (let s = (if steep? -1 1))
         (let q = (+ (if steep? 2 0) (if transform? s 0)))
         (let quarters = (if neg-x? (- 4 q) q))
         (let offset = (if (== quarters 0) (Bounds 0 0)
                           (bounds-div-int (bounds-times-int (pi-bounds w) quarters) 4)))
         (Some (bounds-times-int (bounds+ offset (bounds-times-int a (if neg-x? (neg s) s)))
                                 (if neg-y? -1 1))))))))
