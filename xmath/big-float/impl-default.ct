;;;; impl-default.ct
;;;;
;;;; Arbitrary precision floats using pure Coalton.

(in-package #:coalton/xmath/big-float)

#+coalton-release
(cl:declaim #.coalton-impl/settings:*coalton-optimize-library*)

(coalton-toplevel
  ;; Rounding modes
  (derive Eq)
  (repr :enum)
  (define-type RoundingMode
    RoundNearAway
    RoundEven
    RoundToZero
    RoundUp
    RoundDown
    RoundFromZero
    RoundFaithful
    RoundDisable))

(cl:defvar *bf-precision* 53)
(cl:defvar *bf-rounding-mode* RoundEven)

(coalton-toplevel

  (declare rndna RoundingMode)
  (define rndna
    "RouND to Nearest Away."
    RoundNearAway)
  (declare rndn RoundingMode)
  (define rndn
    "RouND to Nearest, with the even rounding rule."
    RoundEven)
  (declare rndz RoundingMode)
  (define rndz
    "RouND toward Zero."
    RoundToZero)
  (declare rndu RoundingMode)
  (define rndu
    "RouND Up, toward positive infinity."
    RoundUp)
  (declare rndd RoundingMode)
  (define rndd
    "RouND Down, toward negative infinity."
    RoundDown)
  (declare rnda RoundingMode)
  (define rnda
    "RouND Away from zero."
    RoundFromZero)
  (declare rndf RoundingMode)
  (define rndf
    "Faithful rounding (experimental)."
    RoundFaithful)

  (declare set-precision! (UFix -> Void))
  (define (set-precision! prec-bits)
    "Set the precision of BigFloat arithmetic to PREC-BITS bits."
    (unless (> prec-bits 0)
      (error "Precision must be positive."))
    (lisp (-> Void) (prec-bits)
      (cl:progn
        (cl:setf *bf-precision* prec-bits)
        (cl:values))))

  (declare set-rounding-mode! (RoundingMode -> Void))
  (define (set-rounding-mode! r)
    "Set the global rounding mode for BigFloat operations."
    (lisp (-> Void) (r)
      (cl:progn
        (cl:setf *bf-rounding-mode* r)
        (cl:values))))

  (declare get-precision (Void -> UFix))
  (define (get-precision)
    "Get the current global precision of BigFloat arithmetic"
    (lisp (-> UFix) () *bf-precision*))

  (declare get-rounding-mode (Void -> RoundingMode))
  (define (get-rounding-mode)
    "Get the current rounding-mode of BigFloat arithmetic."
    (lisp (-> RoundingMode) ()
      *bf-rounding-mode*))

  (declare with-precision-rounding
    (forall ((:a Values))
      ((Void -> :a) &key (:precision UFix) (:rounding RoundingMode) -> :a)))
  (define (with-precision-rounding f &key (precision (get-precision)) (rounding (get-rounding-mode)))
    "Call F with a temporary BigFloat PRECISION and ROUNDING mode."
    (unless (> precision 0)
      (error "Precision must be positive."))
    (lisp (-> :a) (f precision rounding)
      (cl:let ((*bf-precision* precision)
               (*bf-rounding-mode* rounding))
        (call-coalton-function f))))

  (declare with-precision
    (forall ((:a Values)) ((Void -> :a) &key (:precision UFix) -> :a)))
  (define (with-precision f &key (precision (get-precision)))
    "Call F with a temporary BigFloat PRECISION."
    (with-precision-rounding f :precision precision))

  (declare with-rounding
    (forall ((:a Values)) ((Void -> :a) &key (:rounding RoundingMode) -> :a)))
  (define (with-rounding f &key (rounding (get-rounding-mode)))
    "Call F with a temporary BigFloat ROUNDING mode."
    (with-precision-rounding f :rounding rounding))

  (inline)
  (declare bit-length (Integer -> Integer))
  (define (bit-length n)
    (lisp (-> Integer) (n)
      (cl:integer-length (cl:abs n))))

  (inline)
  (declare ilog2-abs (Integer -> Integer))
  (define (ilog2-abs x)
    (- (bit-length x) 1))

  (inline)
  (declare low-bits-nonzero? (Integer * Integer -> Boolean))
  (define (low-bits-nonzero? abs-m count)
    "Return True when any of the lowest COUNT bits of ABS-M (> 0) are non-zero."
    (cond
      ((<= count 0) False)
      ((< (bit-length abs-m) (+ count 1)) True)
      (True
       (lisp (-> Boolean) (abs-m count)
         (cl:ldb-test (cl:byte count 0) abs-m)))))

  (inline)
  (declare test-bit? (Integer * Integer -> Boolean))
  (define (test-bit? abs-m bit-index)
    (if (< (bit-length abs-m) (+ bit-index 1))
        False
        (lisp (-> Boolean) (abs-m bit-index)
          (cl:logbitp bit-index abs-m))))

  (inline)
  (declare round-quotient (Integer * Integer -> Integer))
  (define (round-quotient a b)
    (lisp (-> Integer) (a b)
      (cl:values (cl:round a b)))))

(coalton-toplevel

  (define-type NativeFloatRounding
    (NativeFloatZero Boolean)
    (NativeFloatFinite Integer Integer)
    (NativeFloatOverflow Boolean))

  (declare round-scaled-integer (Integer * Integer -> Integer))
  (define (round-scaled-integer n shift)
    (cond
      ((< shift 0)
       (let s = (neg shift))
       (let len = (bit-length n))
       (cond
         ((< len s) 0)
         (True
          (let quo = (rsh n s))
          (let half? = (test-bit? n (- s 1)))
          (cond
            ((not half?) quo)
            ((odd? quo) (+ quo 1))
            ((low-bits-nonzero? n (- s 1)) (+ quo 1))
            (True quo)))))
      (True
       (lsh n shift))))

  (declare dyadic->native-float-exact
           (Integer * Integer * Integer * Integer * Integer -> (Optional (Tuple Integer Integer))))
  (define (dyadic->native-float-exact m k digits min-exp max-exp)
    (cond
      ((== m 0)
       (Some (Tuple 0 0)))
      (True
       (let sign-m = (if (< m 0) -1 1))
       (let n0 = (abs m))
       (let zeros = (- (bit-length (bits:and n0 (neg n0))) 1))
       (let n = (rsh n0 zeros))
       (let e = (+ k zeros))
       (let bits = (bit-length n))
       (if (and (<= bits digits)
                (<= min-exp e)
                (<= (- e (- digits bits)) max-exp))
           (Some (Tuple (* sign-m n) e))
           None))))

  (declare dyadic->native-float-rounded
           (Integer * Integer * Integer * Integer * Integer -> NativeFloatRounding))
  (define (dyadic->native-float-rounded m k digits min-exp max-exp)
    (cond
      ((== m 0)
       (NativeFloatZero False))
      (True
       (let negative? = (< m 0))
       (let n = (abs m))
       (let e0 = (max min-exp (- (+ k (bit-length n)) digits)))
       (let q0 = (round-scaled-integer n (- k e0)))
       (let limit = (lsh 1 digits))
       (let (Tuple q e) = (if (== q0 limit)
                              (Tuple (rsh q0 1) (+ e0 1))
                              (Tuple q0 e0)))
       (cond
         ((== q 0) (NativeFloatZero negative?))
         ((> e max-exp) (NativeFloatOverflow negative?))
         (True (NativeFloatFinite (if negative? (neg q) q) e)))))))

(coalton-toplevel

  (define-type BigFloat
    (BFValue Dyadic)
    BFNegZero
    (BFConst (Void -> BigFloat))
    BFInf
    BFNegInf
    BFNaN)

  (inline)
  (declare resolve (BigFloat -> BigFloat))
  (define (resolve x)
    "Evaluates a lazy BigFloat constant at the current precision and rounding mode."
    (match x
      ((BFConst f) (resolve (f)))
      (_ x)))

  (declare integer->big-float-exact (Integer -> BigFloat))
  (define (integer->big-float-exact n)
    (BFValue (Dyadic n 0)))

  ;; Can compare non-normalized big-floats or big-floats of different precisions.
  (define-instance (Eq BigFloat)
    (define (== a b)
      (match (Tuple (resolve a) (resolve b))
        ((Tuple (BFValue x) (BFValue y))
         (== x y))
        ((Tuple (BFNegZero) (BFNegZero)) True)
        ((Tuple (BFNegZero) (BFValue (Dyadic m _))) (== m 0))
        ((Tuple (BFValue (Dyadic m _)) (BFNegZero)) (== m 0))
        ((Tuple (BFInf) (BFInf)) True)
        ((Tuple (BFNegInf) (BFNegInf)) True)
        (_ False))))

  (define-instance (Ord BigFloat)
    (define (<=> a b)
      (match (Tuple (resolve a) (resolve b))
        ((Tuple (BFValue x) (BFValue y))
         (<=> x y))
        ((Tuple (BFNegZero) (BFNegZero)) EQ)
        ((Tuple (BFNegZero) (BFValue (Dyadic m _))) (<=> 0 m))
        ((Tuple (BFValue (Dyadic m _)) (BFNegZero)) (<=> m 0))
        ((Tuple (BFInf) (BFInf)) EQ)
        ((Tuple (BFNegInf) (BFNegInf)) EQ)
        ((Tuple (BFInf) (BFNegInf)) GT)
        ((Tuple (BFNegInf) (BFInf)) LT)
        ((Tuple (BFNaN) (BFNaN)) EQ)
        ;; When sorting, NaNs will go to the left
        ((Tuple (BFNaN) _) LT)
        ((Tuple _ (BFNaN)) GT)
        ((Tuple (BFInf) _) GT)
        ((Tuple (BFNegInf) _) LT)
        ((Tuple _ (BFInf)) LT)
        ((Tuple _ (BFNegInf)) GT)
        (_ EQ))))

  (declare round-shifted-integer (Integer * Integer * RoundingMode -> Integer))
  (define (round-shifted-integer m shift rnd-mode)
    "Round M * 2^(-SHIFT) (where M /= 0 and SHIFT > 0) to an Integer under RND-MODE."
    (let neg? = (< m 0))
    (let abs-m = (abs m))
    (let len = (bit-length abs-m))
    (let q = (if (< len (+ shift 1)) 0 (rsh abs-m shift)))
    (let half? = (test-bit? abs-m (- shift 1)))
    (let mag =
      (match rnd-mode
        ((RoundToZero) q)
        ((RoundNearAway)
         (if half? (+ q 1) q))
        ((RoundEven)
         (if (not half?)
             q
             (if (odd? q)
                 (+ q 1)
                 (if (low-bits-nonzero? abs-m (- shift 1))
                     (+ q 1)
                     q))))
        ((RoundFaithful)
         (if (not half?)
             q
             (if (odd? q)
                 (+ q 1)
                 (if (low-bits-nonzero? abs-m (- shift 1))
                     (+ q 1)
                     q))))
        ((RoundFromZero)
         (if (or half? (low-bits-nonzero? abs-m (- shift 1)))
             (+ q 1)
             q))
        ((RoundUp)
         (if neg?
             q
             (if (or half? (low-bits-nonzero? abs-m (- shift 1)))
                 (+ q 1)
                 q)))
        ((RoundDown)
         (if neg?
             (if (or half? (low-bits-nonzero? abs-m (- shift 1)))
                 (+ q 1)
                 q)
             q))
        ((RoundDisable)
         (error "RoundDisable cannot be passed to round-shifted-integer."))))
    (if neg? (neg mag) mag))

  (declare normalize-dyadic (Integer * Integer -> BigFloat))
  (define (normalize-dyadic m e)
    "Normalize M * 2^E into a BigFloat using current precision and rounding mode."
    (if (== m 0)
        (BFValue (Dyadic 0 0))
        (match (get-rounding-mode)
          ((RoundDisable) (BFValue (Dyadic m e)))
          (rnd-mode
           (let k = (to-integer (get-precision)))
           (let len = (bit-length m))
           (let delta = (- k len))
           (cond
             ((>= delta 0)
              (BFValue (Dyadic (lsh m delta) (- e delta))))
             (True
              (let shift = (neg delta))
              (let q = (round-shifted-integer m shift rnd-mode))
              (let e-new = (+ e shift))
              (if (> (bit-length q) k)
                  (BFValue (Dyadic (rsh q 1) (+ e-new 1)))
                  (BFValue (Dyadic q e-new)))))))))

  (declare normalize (BigFloat -> BigFloat))
  (define (normalize a)
    "Normalizes a BigFloat using current rounding and precision."
    (match (resolve a)
      ((BFValue (Dyadic m e))
       (normalize-dyadic m e))
      (x x)))

  (declare cap-dyadic-bits (Integer * Integer * Integer -> Dyadic))
  (define (cap-dyadic-bits m e max-bits)
    "Truncate M to at most MAX-BITS bits, preserving a sticky bit at bit 0."
    (let len = (bit-length m))
    (cond
      ((<= len max-bits)
       (Dyadic m e))
      (True
       (let drop = (- len (- max-bits 1)))
       (let abs-m = (abs m))
       (let q = (rsh abs-m drop))
       (let sticky = (if (low-bits-nonzero? abs-m drop) 1 0))
       (let q2 = (+ (lsh q 1) sticky))
       (Dyadic (if (< m 0) (neg q2) q2)
               (- (+ e drop) 1)))))

  (declare add-dyadic (Integer * Integer * Integer * Integer -> BigFloat))
  (define (add-dyadic m1 e1 m2 e2)
    "Add M1 * 2^E1 + M2 * 2^E2 and normalize at current precision and rounding."
    (cond
      ((and (== m1 0) (== m2 0))
       (BFValue (Dyadic 0 0)))
      ((== m1 0)
       (normalize-dyadic m2 e2))
      ((== m2 0)
       (normalize-dyadic m1 e1))
      ((== (get-rounding-mode) RoundDisable)
       (BFValue (+ (Dyadic m1 e1) (Dyadic m2 e2))))
      (True
       (let prec = (to-integer (get-precision)))
       (let len1 = (bit-length m1))
       (let len2 = (bit-length m2))
       (let top1 = (+ e1 len1))
       (let top2 = (+ e2 len2))
       (cond
         ((< top1 top2)
          (add-dyadic m2 e2 m1 e1))
         (True
          (let cut = (- top1 (+ prec 3)))
          (cond
            ((<= top2 (min cut (- e1 1)))
             (let s = (max 1 (+ (- e1 cut) 1)))
             (normalize-dyadic (+ (lsh m1 s) (sign m2)) (- e1 s)))
            (True
             (match (+ (Dyadic m1 e1) (Dyadic m2 e2))
               ((Dyadic sm se)
                (normalize-dyadic sm se))))))))))

  (declare div-dyadic (Integer * Integer * Integer * Integer -> BigFloat))
  (define (div-dyadic m1 e1 m2 e2)
    "Divide (M1 * 2^E1) / (M2 * 2^E2) for non-zero M1, M2 and normalize."
    (let prec = (to-integer (get-precision)))
    (let neg? = (/= (< m1 0) (< m2 0)))
    (let n1 = (abs m1))
    (let n2 = (abs m2))
    (let len1 = (bit-length n1))
    (let len2 = (bit-length n2))
    (let s = (+ (+ prec 3) (- len2 len1)))
    (cond
      ((>= s 0)
       (let (values q r) = (quotrem (lsh n1 s) n2))
       (let q2 = (+ (lsh q 1) (if (== r 0) 0 1)))
       (normalize-dyadic (if neg? (neg q2) q2)
                         (- (- e1 e2) (+ s 1))))
      (True
       (let drop = (neg s))
       (let n1-dropped = (rsh n1 drop))
       (let dropped-sticky? = (low-bits-nonzero? n1 drop))
       (let (values q r) = (quotrem n1-dropped n2))
       (let q2 = (+ (lsh q 1)
                    (if (and (== r 0) (not dropped-sticky?)) 0 1)))
       (normalize-dyadic (if neg? (neg q2) q2)
                         (- (- e1 e2) (+ s 1))))))

  (declare sqrt-dyadic (Integer * Integer -> BigFloat))
  (define (sqrt-dyadic m e)
    "Compute sqrt(M * 2^E) for M > 0 and normalize."
    (let prec = (to-integer (get-precision)))
    (let len = (bit-length m))
    (let s0 = (- (+ (* 2 prec) 6) len))
    (let s = (if (odd? (- e s0)) (+ s0 1) s0))
    (let e-out = (div (- e s) 2))
    (cond
      ((>= s 0)
       (let n = (lsh m s))
       (let q = (isqrt n))
       (let q2 = (+ (lsh q 1) (if (== (* q q) n) 0 1)))
       (normalize-dyadic q2 (- e-out 1)))
      (True
       (let drop = (neg s))
       (let n = (rsh m drop))
       (let dropped-sticky? = (low-bits-nonzero? m drop))
       (let q = (isqrt n))
       (let q2 = (+ (lsh q 1)
                    (if (and (not dropped-sticky?) (== (* q q) n)) 0 1)))
       (normalize-dyadic q2 (- e-out 1)))))

  (specialize negate bf-negate (BigFloat -> BigFloat))
  (define (bf-negate x)
    "Negates a BigFloat"
    (match (resolve x)
      ((BFValue (Dyadic n k))
       (if (== n 0)
           BFNegZero
           (BFValue (Dyadic (neg n) k))))
      ((BFConst f) (bf-negate (f)))
      ((BFNegZero) (BFValue (Dyadic 0 0)))
      ((BFInf) BFNegInf)
      ((BFNegInf) BFInf)
      ((BFNaN) BFNaN)))

  (declare bf-negative-sign? (BigFloat -> Boolean))
  (define (bf-negative-sign? x)
    (match (resolve x)
      ((BFNegZero) True)
      ((BFNegInf) True)
      ((BFValue (Dyadic m _)) (< m 0))
      (_ False)))

  (declare bf-zero? (BigFloat -> Boolean))
  (define (bf-zero? x)
    (match (resolve x)
      ((BFNegZero) True)
      ((BFValue (Dyadic m _)) (== m 0))
      (_ False)))

  (define-instance (HasAdd BigFloat)
    (define (+ a b)
      (match (Tuple (resolve a) (resolve b))
        ((Tuple (BFNaN) _) BFNaN)
        ((Tuple _ (BFNaN)) BFNaN)
        ((Tuple (BFInf) (BFNegInf)) BFNaN)
        ((Tuple (BFNegInf) (BFInf)) BFNaN)
        ((Tuple (BFInf) _) BFInf)
        ((Tuple _ (BFInf)) BFInf)
        ((Tuple (BFNegInf) _) BFNegInf)
        ((Tuple _ (BFNegInf)) BFNegInf)
        ((Tuple (BFNegZero) (BFNegZero)) BFNegZero)
        ((Tuple (BFNegZero) x) (normalize x))
        ((Tuple x (BFNegZero)) (normalize x))
        ((Tuple (BFValue (Dyadic m1 e1)) (BFValue (Dyadic m2 e2)))
         (add-dyadic m1 e1 m2 e2))
        (_ BFNaN))))

  (define-instance (Additive BigFloat)
    (define zero (normalize-dyadic 0 0)))

  (define-instance (AdditiveGroup BigFloat)
    (inline)
    (define (- a b)
      (+ a (bf-negate b)))
    (inline)
    (define (neg x)
      (bf-negate x)))

  (define-instance (HasMul BigFloat)
    (define (* a b)
      (let ra = (resolve a))
      (let rb = (resolve b))
      (cond
        ((or (nan? ra) (nan? rb)) BFNaN)
        ((or (and (bf-zero? ra) (infinite? rb))
             (and (infinite? ra) (bf-zero? rb)))
         BFNaN)
        ((or (infinite? ra) (infinite? rb))
         (if (== (bf-negative-sign? ra) (bf-negative-sign? rb))
             BFInf
             BFNegInf))
        ((or (bf-zero? ra) (bf-zero? rb))
         (if (== (bf-negative-sign? ra) (bf-negative-sign? rb))
             (BFValue (Dyadic 0 0))
             BFNegZero))
        (True
         (match (Tuple ra rb)
           ((Tuple (BFValue (Dyadic m1 e1)) (BFValue (Dyadic m2 e2)))
            (normalize-dyadic (* m1 m2) (+ e1 e2)))
           (_ BFNaN))))))

  (define-instance (Multiplicative BigFloat)
    (define one (normalize-dyadic 1 0)))

  (define-instance (Semiring BigFloat))

  (define-instance (Ring BigFloat)
    (inline)
    (define (from-int x)
      (normalize-dyadic x 0)))

  (define-instance (Num BigFloat))
  (define-instance (CommutativeRing BigFloat))

  (define-instance (coalton/math/arith:Scale BigFloat BigFloat)
    (inline)
    (define (coalton/math/arith:scale a b) (* a b)))

  (define-instance (Module BigFloat BigFloat))

  (define-instance (ConjugateRing BigFloat)
    (inline)
    (define (conjugate x) x))

  (define-instance (Reciprocable BigFloat)
    (define (recip x)
      (match (resolve x)
        ((BFValue (Dyadic 0 _)) BFInf)
        ((BFNegZero) BFNegInf)
        ((BFValue (Dyadic m k))
         (div-dyadic 1 0 m k))
        ((BFInf) (BFValue (Dyadic 0 0)))
        ((BFNegInf) BFNegZero)
        ((BFNaN) BFNaN)
        (_ BFNaN)))
    (define (/ a b)
      (let ra = (resolve a))
      (let rb = (resolve b))
      (cond
        ((or (nan? ra) (nan? rb)) BFNaN)
        ((and (infinite? ra) (infinite? rb)) BFNaN)
        ((and (bf-zero? ra) (bf-zero? rb)) BFNaN)
        ((bf-zero? rb)
         (if (== (bf-negative-sign? ra) (bf-negative-sign? rb))
             BFInf
             BFNegInf))
        ((infinite? ra)
         (if (== (bf-negative-sign? ra) (bf-negative-sign? rb))
             BFInf
             BFNegInf))
        ((or (infinite? rb) (bf-zero? ra))
         (if (== (bf-negative-sign? ra) (bf-negative-sign? rb))
             (BFValue (Dyadic 0 0))
             BFNegZero))
        (True
         (match (Tuple ra rb)
           ((Tuple (BFValue (Dyadic m1 e1)) (BFValue (Dyadic m2 e2)))
            (div-dyadic m1 e1 m2 e2))
           (_ BFNaN))))))

  (define-instance (HermitianForm BigFloat BigFloat)
    (inline)
    (define (inner-product a b) (* a b)))

  (define-instance (Dividable Integer BigFloat)
    (define (general/ a b)
      (cond
        ((and (== a 0) (== b 0)) BFNaN)
        ((== b 0) (if (> a 0) BFInf BFNegInf))
        ((== a 0) (if (> b 0) (BFValue (Dyadic 0 0)) BFNegZero))
        (True (div-dyadic a 0 b 0)))))

  (define-instance (Into F32 BigFloat)
    (define (into a)
      (cond
        ((== a infinity) BFInf)
        ((== a negative-infinity) BFNegInf)
        ((nan? a) BFNaN)
        (True
         (lisp (-> BigFloat) (a)
           (cl:multiple-value-bind (n k s)
               (cl:integer-decode-float a)
             (cl:if (cl:and (cl:zerop n) (cl:minusp (cl:float-sign a)))
                    BFNegZero
                    (BFValue (Dyadic (cl:* s n) k)))))))))

  (define-instance (Into F64 BigFloat)
    (define (into a)
      (cond
        ((== a infinity) BFInf)
        ((== a negative-infinity) BFNegInf)
        ((nan? a) BFNaN)
        (True
         (lisp (-> BigFloat) (a)
           (cl:multiple-value-bind (n k s)
               (cl:integer-decode-float a)
             (cl:if (cl:and (cl:zerop n) (cl:minusp (cl:float-sign a)))
                    BFNegZero
                    (BFValue (Dyadic (cl:* s n) k)))))))))

  (define-big-float-try-into-float F32 cl:single-float -0.0f0
                                  cl:least-positive-single-float
                                  cl:most-positive-single-float)
  (define-big-float-try-into-float F64 cl:double-float -0.0d0
                                  cl:least-positive-double-float
                                  cl:most-positive-double-float)

  (define-big-float-round-to-float round-to-f32 F32 cl:single-float -0.0f0
                                   cl:least-positive-single-float
                                   cl:most-positive-single-float)
  (define-big-float-round-to-float round-to-f64 F64 cl:double-float -0.0d0
                                   cl:least-positive-double-float
                                   cl:most-positive-double-float)

  (define-instance (Into Integer BigFloat)
    (inline)
    (define (into a)
      (integer->big-float-exact a)))

  (define-big-float-primitive-conversions)

  (define-instance (Into Fraction BigFloat)
    (inline)
    (define (into a)
      (general/ (numerator a) (denominator a))))

  (define-instance (RationalScalars BigFloat)
    (inline)
    (define (embed-fraction q) (into q)))

  (define-instance (TryInto BigFloat Fraction)
    (define (try-into x)
      (match (resolve x)
        ((BFValue d) (Some (into d)))
        ((BFNegZero) (Some 0))
        (_ None))))

  (define-instance (Approximable BigFloat Dyadic)
    (define (approx _ x)
      (match (resolve x)
        ((BFValue d) d)
        ((BFNegZero) (Dyadic 0 0))
        (_ (error "Cannot approximate a non-finite BigFloat.")))))

  (define-instance (Approximable BigFloat Fraction)
    (define (approx bits x) (into (the Dyadic (approx bits x)))))

  (define-instance (Rationalizable BigFloat)
    (define (simplest-fraction bits x)
      (simplest-fraction bits (the Dyadic (approx bits x)))))

  (define-instance (Approximable BigFloat BigFloat)
    (define (approx _ x)
      (let y = (resolve x))
      (unless (finite? y) (error "Cannot approximate a non-finite BigFloat."))
      y))

  (define-instance (Approximable BigFloat F32)
    (inline)
    (define (approx bits x)
      (match (resolve x)
        ((BFNegZero) -0f0)
        (v (approx bits (the Dyadic (approx bits v)))))))

  (define-instance (Approximable BigFloat F64)
    (inline)
    (define (approx bits x)
      (match (resolve x)
        ((BFNegZero) -0d0)
        (v (approx bits (the Dyadic (approx bits v)))))))

  (define-instance (Approximable Fraction BigFloat)
    (define (approx bits q)
      (BFValue (approx bits q))))

  (define-instance (Approximable Integer BigFloat)
    (define (approx _ n) (integer->big-float-exact n)))

  (define-instance (Into Dyadic BigFloat)
    (inline)
    (define (into d) (BFValue d)))

  (define-instance (Approximable Dyadic BigFloat)
    (define (approx _ d) (BFValue d)))

  (define-instance (Approximable F32 BigFloat)
    (define (approx _ x)
      (unless (finite? x) (error "Cannot approximate a non-finite float."))
      (into x)))

  (define-instance (Approximable F64 BigFloat)
    (define (approx _ x)
      (unless (finite? x) (error "Cannot approximate a non-finite float."))
      (into x)))

  (define-instance (Quantizable BigFloat)
    (define (proper x)
      (match (resolve x)
        ((BFValue d)
         (let (values n d) = (proper d))
         (values n (BFValue d)))
        ((BFNegZero) (values 0 BFNegZero))
        (_ (error "Cannot truncate a non-finite BigFloat."))))
    (define (floor x)
      (match (resolve x)
        ((BFValue d) (floor d))
        ((BFNegZero) 0)
        ((BFInf) (error "Cannot floor Inf"))
        ((BFNegInf) (error "Cannot floor -Inf"))
        ((BFNaN) (error "Cannot floor NaN"))
        (_ (error "Cannot floor non-finite BigFloat"))))
    (define (ceiling x)
      (match (resolve x)
        ((BFValue d) (ceiling d))
        ((BFNegZero) 0)
        ((BFInf) (error "Cannot ceiling Inf"))
        ((BFNegInf) (error "Cannot ceiling -Inf"))
        ((BFNaN) (error "Cannot ceiling NaN"))
        (_ (error "Cannot ceiling non-finite BigFloat")))))

  (define-instance (Transfinite BigFloat)
    (define infinity BFInf)
    (define (infinite? x)
      (match (resolve x)
        ((BFInf) True)
        ((BFNegInf) True)
        (_ False)))
    (define (finite? x)
      (match (resolve x)
        ((BFValue _) True)
        ((BFNegZero) True)
        (_ False))))

  (define-instance (IEEEFloat BigFloat)
    (define nan BFNaN)
    (define (nan? x)
      (match (resolve x)
        ((BFNaN) True)
        (_ False))))

  (specialize negative-infinity bf-neg-inf BigFloat)
  (define bf-neg-inf BFNegInf)

  (define (scale x n)
    "Scales a BigFloat X=a*2^k to a*2^(+ k n)."
    (match (resolve x)
      ((BFValue d) (BFValue (dyadic:scale d n)))
      ((BFNegZero) BFNegZero)
      ((BFInf) BFInf)
      ((BFNegInf) BFNegInf)
      ((BFNaN) BFNaN)
      (_ BFNaN)))

  (define (reciprocal-sqrt a)
    "Reciprocal of the square root of A."
    (match (resolve a)
      ((BFValue (Dyadic m j))
       (cond
         ((< m 0) BFNaN)
         ((== m 0) BFInf)
         (True (recip (sqrt-dyadic m j)))))
      ((BFNegZero) BFNegInf)
      ((BFInf) (BFValue (Dyadic 0 0)))
      (_ BFNaN))))

(complex::%define-standard-complex-instances BigFloat)

(coalton-toplevel
  ;; SeriesSplit/SeriesResult could be extended to any ring (e.g. polynomials)
  (define-type SeriesSplit
    "An nth element of series (SeriesSplit a(n) p(n) b(n) q(n)).
See `binary-split` step 1."
    (SeriesSplit Integer Integer Integer Integer))

  (define-type SeriesResult
    "An intermediary result of binary splitting series (SeriesResult P Q B T).
See `binary-split` step 2."
    (SeriesResult Integer Integer Integer Integer))

  (define-instance (Semigroup SeriesResult)
    (define (<> a b)
      "Combine binary split results. See `binary-split` step 3."
      (match (Tuple a b)
        ((Tuple (SeriesResult ap aq ab at)
                (SeriesResult bp bq bb bt))
         (SeriesResult (* ap bp) (* aq bq) (* ab bb)
                       (+ (* (* bb bq) at) (* (* ab ap) bt)))))))

  (declare make-result (SeriesSplit -> SeriesResult))
  (define (make-result b)
    "Calculations the current intermediary result for a given element of the series.
See `binary-split`."
    (match b
      ((SeriesSplit a p q b)
       (SeriesResult p q b (* a p)))))

  (declare eval-result ((Dividable Integer :a) => SeriesResult -> :a))
  (define (eval-result r)
    "Evaluates the final result of a SeriesResult. See `binary-split` step 4."
    (match r
      ((SeriesResult _ q b t)
       (general/ t (* b q)))))

  (declare recip-result ((Dividable Integer :a) => SeriesResult -> :a))
  (define (recip-result r)
    "Evaluates the reciprocal of `make-result`."
    (match r
      ((SeriesResult _ q b t)
       (general/ (* b q) t))))

  (declare binary-split ((UFix -> SeriesSplit) * UFix * UFix -> SeriesResult))
  (define (binary-split s n1 n2)
    "Implements a binary splitting algorithm described by. In short,
 1) Given a series S(n) = Σ^n_i=0 a(i)p(0)...p(i)/b(i)q(0)...q(i)
 2) Split P(n1,n2)=p(n1)...p(n2−1), Q(n1,n2)=q(n1)...q(n2−1), B(n1,n2)=b(n1)...b(n2−1), and T=BQS
 3) Recombined as P(a,c)=P(a,b)P(b,c),Q(a,c)=Q(a,b)Q(b,c),B(a,c)=B(a,b)B(b,c)
                 T(a,c)=B(b,c)Q(b,c)T(a,b)+B(a,b)P(a,b)T(b,c)
 4) With S(n) = T(0,n)/(B(0,n)Q(0,n))

Source: https://www.ginac.de/CLN/binsplit.pdf
"
    (let n = (- n2 n1))
    (cond
      ((<= n 0) (make-result (s n1)))
      ((== n 1)
       (<> (make-result (s n1))
           (make-result (s (+ 1 n1)))))
      ((== n 2)
       (<> (make-result (s n1))
           (<> (make-result (s (+ 1 n1)))
               (make-result (s (+ 2 n1))))))
      ((== n 3)
       (<> (<> (make-result (s n1))
               (make-result (s (+ 1 n1))))
           (<> (make-result (s (+ 2 n1)))
               (make-result (s (+ 3 n1))))))
      ((== n 4)
       (<> (<>
            (<> (make-result (s n1))
                (make-result (s (+ 1 n1))))
            (<> (make-result (s (+ 2 n1)))
                (make-result (s (+ 3 n1)))))
           (make-result (s (+ 4 n1)))))
      ((== n 5)
       (<> (<>
            (<> (make-result (s n1))
                (make-result (s (+ 1 n1))))
            (<> (make-result (s (+ 2 n1)))
                (make-result (s (+ 3 n1)))))
           (<> (make-result (s (+ 4 n1)))
               (make-result (s (+ 5 n1))))))
      (True
       (let nm = (div n 2))
       (let n3 = (+ n1 nm))
       (<> (binary-split s n1 n3)
           (binary-split s (+ n3 1) n2)))))

  (declare eval-series (SeriesSplit * (UFix -> SeriesSplit) * UFix -> SeriesResult))
  (define (eval-series x f n)
    (<> (make-result x)
        (binary-split f 1 n)))

  (declare make-results ((Dividable Integer :a) => Ufix * SeriesSplit * (Integer -> SeriesSplit) -> :a))
  (define (make-results n start f)
    "For a binary-split series, given an initial SeriesSPlit X and a function that
returns the nth SeriesSplit, return the series evaluated to the Nth element."
    (eval-result
     (eval-series start ƒm.(f (to-integer m)) n)))

  (declare make-recip-results ((Dividable Integer :a) => Ufix * SeriesSplit * (Integer -> SeriesSplit) -> :a))
  (define (make-recip-results n start f)
    "Reciprocal of `make-result`."
    (recip-result
     (eval-series start ƒm.(f (to-integer m)) n))))

;;; High-water caches for fundamental constants (stored atomically as (Tuple prec Dyadic) with 32 extra guard bits)
(cl:defvar *cached-pi* (Tuple 0 (Dyadic 0 0)))
(cl:defvar *cached-ln2* (Tuple 0 (Dyadic 0 0)))
(cl:defvar *cached-ee* (Tuple 0 (Dyadic 0 0)))

(coalton-toplevel

  (declare dyadic->fixed (Dyadic * Integer -> Integer))
  (define (dyadic->fixed d scale-bits)
    "Convert Dyadic D to floor(D * 2^SCALE-BITS)."
    (match d
      ((Dyadic m k)
       (if (== m 0)
           0
           (let ((s (+ k scale-bits)))
             (cond
               ((>= s 0) (lsh m s))
               ((< (+ (bit-length m) s) 0)
                (if (< m 0) -1 0))
               (True (lsh m s))))))))

  (declare compute-pi-dyadic (Integer -> Dyadic))
  (define (compute-pi-dyadic work-prec)
    "Compute pi as a Dyadic at scale 2^(-WORK-PREC) using Chudnovsky binary splitting."
    (let a = (* 12 13591409))
    (let b = (* 12 545140134))
    (let c = 640320)
    (let j = (div (^ c 3) 24))
    (let n-terms = (from-int (+ (div work-prec 47) 2)))
    (let (SeriesResult _ q b-prod t) =
      (eval-series
       (SeriesSplit a 1 1 1)
       (fn (m)
         (let n = (to-integer m))
         (let 2n = (* 2 n))
         (let 6n = (* 3 2n))
         (let n2 = (* n n))
         (SeriesSplit
          (+ a (* b n))
          (neg (* (* (- 6n 5) (- 2n 1)) (- 6n 1)))
          (* j (* n2 n)) 1))
       n-terms))
    (let sqrt-c = (isqrt (lsh c (* 2 work-prec))))
    (let pi-fixed = (div (* (* b-prod q) (* c sqrt-c)) t))
    (Dyadic pi-fixed (neg work-prec)))

  (declare trim-cached-dyadic (Dyadic * Integer -> Dyadic))
  (define (trim-cached-dyadic d prec)
    (match d
      ((Dyadic m e)
       (cap-dyadic-bits m e (+ prec 64)))))

  (declare raw-pi (Integer -> Dyadic))
  (define (raw-pi prec)
    "Return a cached Dyadic approximation of pi accurate to at least PREC + 32 bits."
    (let (Tuple cached-prec cached-d) = (lisp (-> (Tuple Integer Dyadic)) () *cached-pi*))
    (cond
      ((<= prec cached-prec)
       (trim-cached-dyadic cached-d prec))
      (True
       (let target = (max (+ prec 64) (* 2 cached-prec)))
       (let d = (compute-pi-dyadic (+ target 32)))
       (lisp (-> Void) (target d)
         (cl:progn
           (cl:setf *cached-pi* (Tuple target d))
           (cl:values)))
       (trim-cached-dyadic d prec))))

  (declare fixed-atanh-recip (Integer * Integer -> Integer))
  (define (fixed-atanh-recip k scale-bits)
    "Compute atanh(1/K) * 2^SCALE-BITS for integer K >= 2."
    (let k2 = (* k k))
    (let t0 = (div (lsh 1 scale-bits) k))
    (rec % ((j 3)
            (term (div t0 k2))
            (acc t0))
      (let step = (div term j))
      (if (== step 0)
          acc
          (% (+ j 2) (div term k2) (+ acc step)))))

  (declare compute-ln2-dyadic (Integer -> Dyadic))
  (define (compute-ln2-dyadic work-prec)
    "Compute ln(2) = 18*atanh(1/26) - 2*atanh(1/4801) + 8*atanh(1/8749)."
    (let w = (+ work-prec 16))
    (let a1 = (fixed-atanh-recip 26 w))
    (let a2 = (fixed-atanh-recip 4801 w))
    (let a3 = (fixed-atanh-recip 8749 w))
    (let sum = (+ (- (* 18 a1) (* 2 a2)) (* 8 a3)))
    (Dyadic (rsh sum 16) (neg work-prec)))

  (declare raw-ln2 (Integer -> Dyadic))
  (define (raw-ln2 prec)
    "Return a cached Dyadic approximation of ln(2) accurate to at least PREC + 32 bits."
    (let (Tuple cached-prec cached-d) = (lisp (-> (Tuple Integer Dyadic)) () *cached-ln2*))
    (cond
      ((<= prec cached-prec)
       (trim-cached-dyadic cached-d prec))
      (True
       (let target = (max (+ prec 64) (* 2 cached-prec)))
       (let d = (compute-ln2-dyadic (+ target 32)))
       (lisp (-> Void) (target d)
         (cl:progn
           (cl:setf *cached-ln2* (Tuple target d))
           (cl:values)))
       (trim-cached-dyadic d prec))))

  (declare bf-pi (Void -> BigFloat))
  (define (bf-pi)
    "Return the value of pi to the currently set precision."
    (match (raw-pi (to-integer (get-precision)))
      ((Dyadic m e) (normalize-dyadic m e))))

  (declare bf-ln2 (Void -> BigFloat))
  (define (bf-ln2)
    "Return the value of (ln 2) to the currently set precision."
    (match (raw-ln2 (to-integer (get-precision)))
      ((Dyadic m e) (normalize-dyadic m e))))

  (declare reduce-mod-pi-half (Integer * Integer * Integer -> (Tuple Integer (Tuple Integer Integer))))
  (define (reduce-mod-pi-half m k base-prec)
    "Reduce M * 2^K modulo pi/2 with Ziv retry when near a multiple of pi/2.
Returns (Tuple q (Tuple r-fixed work-prec))."
    (let x-mag = (+ (bit-length m) k))
    (let init-prec = (+ (+ base-prec 36) (abs x-mag)))
    (rec % ((work-prec init-prec))
      (let pi-half-fixed = (dyadic->fixed (dyadic:scale (raw-pi work-prec) -1) work-prec))
      (let x-fixed = (dyadic->fixed (Dyadic m k) work-prec))
      (let q = (round-quotient x-fixed pi-half-fixed))
      (let r-fixed = (- x-fixed (* q pi-half-fixed)))
      (let r-bits = (bit-length r-fixed))
      (let qb = (bit-length q))
      (if (and (/= q 0)
               (< r-bits (+ (+ base-prec 28) qb)))
          (% (+ work-prec (+ (- (+ (+ base-prec 36) qb) r-bits) 16)))
          (Tuple q (Tuple r-fixed work-prec)))))

  (declare sincos-reduced (Integer * Integer * Integer -> (Tuple Dyadic Dyadic)))
  (define (sincos-reduced m k prec)
    "Reduce X = M * 2^K modulo pi/2 and return (Tuple sin(X) cos(X)) as Dyadics."
    (let (Tuple q (Tuple r-fixed work-prec)) = (reduce-mod-pi-half m k prec))
    (let r-mag = (- (bit-length r-fixed) work-prec))
    (let s = (max 4 (isqrt (+ prec 32))))
    (let w2 = (+ (+ (+ prec 36) (max 0 (neg r-mag))) s))
    (let r0 = (lsh r-fixed (- (- w2 s) work-prec)))
    (let neg-r0? = (< r0 0))
    (let abs-r0 = (abs r0))
    (let r0-sq = (rsh (* abs-r0 abs-r0) w2))
    (let one = (lsh 1 w2))
    (let abs-sin-r0 =
      (rec % ((j 2)
              (term abs-r0)
              (sub? True)
              (acc abs-r0))
        (let next-term = (quot (rsh (* term r0-sq) w2) (* j (+ j 1))))
        (if (== next-term 0)
            acc
            (% (+ j 2)
               next-term
               (not sub?)
               (if sub? (- acc next-term) (+ acc next-term))))))
    (let sin-r0 = (if neg-r0? (neg abs-sin-r0) abs-sin-r0))
    (let cos-r0 =
      (rec % ((j 1)
              (term one)
              (sub? True)
              (acc one))
        (let next-term = (quot (rsh (* term r0-sq) w2) (* j (+ j 1))))
        (if (== next-term 0)
            acc
            (% (+ j 2)
               next-term
               (not sub?)
               (if sub? (- acc next-term) (+ acc next-term))))))
    (let (Tuple sin-r cos-r) =
      (rec % ((i 0)
              (sv sin-r0)
              (cv cos-r0))
        (if (>= i s)
            (Tuple sv cv)
            (% (+ i 1)
               (rsh (* sv cv) (- w2 1))
               (rsh (- (* cv cv) (* sv sv)) w2)))))
    (let neg-w2 = (neg w2))
    (let q-mod = (mod q 4))
    (cond
      ((== q-mod 0) (Tuple (Dyadic sin-r neg-w2) (Dyadic cos-r neg-w2)))
      ((== q-mod 1) (Tuple (Dyadic cos-r neg-w2) (Dyadic (neg sin-r) neg-w2)))
      ((== q-mod 2) (Tuple (Dyadic (neg sin-r) neg-w2) (Dyadic (neg cos-r) neg-w2)))
      (True         (Tuple (Dyadic (neg cos-r) neg-w2) (Dyadic sin-r neg-w2)))))

  (declare atan-dyadic (Integer * Integer * Integer -> Dyadic))
  (define (atan-dyadic m k work-prec)
    "Compute atan(M * 2^K) as a Dyadic with at least WORK-PREC bits of relative precision."
    (cond
      ((== m 0)
       (Dyadic 0 0))
      (True
       (let neg? = (< m 0))
       (let abs-m = (abs m))
       (let len-m = (bit-length abs-m))
       (let x-mag = (+ len-m k))
       (let eff-prec = (max work-prec (+ len-m 4)))
       (cond
         ((< x-mag (neg (+ eff-prec 4)))
          (let s = (+ (- eff-prec len-m) 4))
          (let mp = (- (lsh abs-m s) 1))
          (Dyadic (if neg? (neg mp) mp) (- k s)))
         ((> x-mag (+ eff-prec 4))
          (let pi-half = (dyadic->fixed (dyadic:scale (raw-pi (+ eff-prec 16)) -1) eff-prec))
          (let ans = (- pi-half 1))
          (Dyadic (if neg? (neg ans) ans) (neg eff-prec)))
         ((and (<= k 0) (== abs-m (lsh 1 (neg k))))
          (let pi-q = (dyadic->fixed (dyadic:scale (raw-pi (+ eff-prec 16)) -2) eff-prec))
          (Dyadic (if neg? (neg pi-q) pi-q) (neg eff-prec)))
         (True
          (let recip? = (> (Dyadic abs-m k) (Dyadic 1 0)))
          (let small-guard = (if recip? 0 (max 0 (neg x-mag))))
          (let s = (max 4 (isqrt work-prec)))
          (let w2 = (+ (+ work-prec small-guard) (+ s 8)))
          (let t0 =
            (if recip?
                (div (lsh 1 (- w2 k)) abs-m)
                (dyadic->fixed (Dyadic abs-m k) w2)))
          (let one = (lsh 1 w2))
          (let one-sq = (lsh 1 (* 2 w2)))
          (let t-red =
            (rec % ((i 0)
                    (t t0))
              (if (>= i s)
                  t
                  (% (+ i 1)
                     (div (lsh t w2)
                          (+ one (isqrt (+ one-sq (* t t)))))))))
          (let t2 = (rsh (* t-red t-red) w2))
          (let atan-red =
            (rec % ((j 3)
                    (term (rsh (* t-red t2) w2))
                    (sub? True)
                    (acc t-red))
              (let step = (quot term j))
              (if (== step 0)
                  acc
                  (% (+ j 2)
                     (rsh (* term t2) w2)
                     (not sub?)
                     (if sub? (- acc step) (+ acc step))))))
          (let atan-abs = (lsh atan-red s))
          (let atan-final =
            (if recip?
                (- (dyadic->fixed (dyadic:scale (raw-pi w2) -1) w2) atan-abs)
                atan-abs))
          (Dyadic (if neg? (neg atan-final) atan-final)
                  (neg w2)))))))

  (define-instance (Trigonometric BigFloat)
    (define (sin x)
      (match (resolve x)
        ((BFValue (Dyadic m k))
         (cond
           ((== m 0)
            (BFValue (Dyadic 0 0)))
           (True
            (let prec = (to-integer (get-precision)))
            (let len-m = (bit-length m))
            (let x-mag = (+ len-m k))
            (cond
              ((< x-mag (neg (+ (div (max prec len-m) 2) 4)))
               (let s = (+ (- (max prec len-m) len-m) 4))
               (let mp = (- (lsh (abs m) s) 1))
               (normalize-dyadic (if (< m 0) (neg mp) mp) (- k s)))
              (True
               (match (sincos-reduced m k prec)
                 ((Tuple (Dyadic sv se) _)
                  (normalize-dyadic sv se))))))))
        ((BFNegZero) BFNegZero)
        (_ BFNaN)))
    (define (cos x)
      (match (resolve x)
        ((BFValue (Dyadic m k))
         (cond
           ((== m 0)
            (normalize-dyadic 1 0))
           (True
            (let prec = (to-integer (get-precision)))
            (let x-mag = (+ (bit-length m) k))
            (if (< x-mag (neg (+ (div prec 2) 4)))
                (normalize-dyadic (- (lsh 1 (+ prec 4)) 1)
                                  (neg (+ prec 4)))
                (match (sincos-reduced m k prec)
                  ((Tuple _ (Dyadic cv ce))
                   (normalize-dyadic cv ce)))))))
        ((BFNegZero) (normalize-dyadic 1 0))
        (_ BFNaN)))
    (define (tan x)
      (match (resolve x)
        ((BFValue (Dyadic m k))
         (cond
           ((== m 0)
            (BFValue (Dyadic 0 0)))
           (True
            (let prec = (to-integer (get-precision)))
            (let len-m = (bit-length m))
            (let x-mag = (+ len-m k))
            (cond
              ((< x-mag (neg (+ (div (max prec len-m) 2) 4)))
               (let s = (+ (- (max prec len-m) len-m) 4))
               (let mp = (+ (lsh (abs m) s) 1))
               (normalize-dyadic (if (< m 0) (neg mp) mp) (- k s)))
              (True
               (match (sincos-reduced m k prec)
                 ((Tuple (Dyadic sv se) (Dyadic cv ce))
                  (div-dyadic sv se cv ce))))))))
        ((BFNegZero) BFNegZero)
        (_ BFNaN)))
    (define (atan x)
      (let prec = (to-integer (get-precision)))
      (match (resolve x)
        ((BFValue (Dyadic m k))
         (if (== m 0)
             (BFValue (Dyadic 0 0))
             (match (atan-dyadic m k (+ prec 36))
               ((Dyadic am ae) (normalize-dyadic am ae)))))
        ((BFNegZero) BFNegZero)
        ((BFInf)
         (match (raw-pi (+ prec 32))
           ((Dyadic pm pe) (normalize-dyadic pm (- pe 1)))))
        ((BFNegInf)
         (match (raw-pi (+ prec 32))
           ((Dyadic pm pe) (normalize-dyadic (neg pm) (- pe 1)))))
        (_ BFNaN)))
    (define (asin x)
      (let prec = (to-integer (get-precision)))
      (match (resolve x)
        ((BFNegZero) BFNegZero)
        ((BFValue (Dyadic m k))
         (cond
           ((== m 0)
            (BFValue (Dyadic 0 0)))
           (True
            (let len-m = (bit-length m))
            (let x-mag = (+ len-m k))
            (cond
              ((< x-mag (neg (+ (div (max prec len-m) 2) 4)))
               (let s = (+ (- (max prec len-m) len-m) 4))
               (let mp = (+ (lsh (abs m) s) 1))
               (normalize-dyadic (if (< m 0) (neg mp) mp) (- k s)))
              (True
               (let abs-d = (Dyadic (abs m) k))
               (match (<=> abs-d (Dyadic 1 0))
                 ((GT) BFNaN)
                 ((EQ)
                  (match (raw-pi (+ prec 32))
                    ((Dyadic pm pe)
                     (normalize-dyadic (if (< m 0) (neg pm) pm) (- pe 1)))))
                 ((LT)
                  (let w = (+ prec 36))
                  (let (Dyadic dm de) = (* (- (Dyadic 1 0) abs-d)
                                           (+ (Dyadic 1 0) abs-d)))
                  (let s0 = (- (+ (* 2 w) 4) (bit-length dm)))
                  (let s = (if (odd? (- de s0)) (+ s0 1) s0))
                  (let sqrt-m = (isqrt (lsh dm s)))
                  (let sqrt-e = (div (- de s) 2))
                  (let shift = (+ (+ w 4) (- (bit-length sqrt-m) len-m)))
                  (let q = (if (>= shift 0)
                               (div (lsh m shift) sqrt-m)
                               (div (rsh m (neg shift)) sqrt-m)))
                  (let qe = (- (- k sqrt-e) shift))
                  (match (atan-dyadic q qe w)
                    ((Dyadic am ae) (normalize-dyadic am ae))))))))))
        (_ BFNaN)))
    (define (acos x)
      (let prec = (to-integer (get-precision)))
      (match (resolve x)
        ((BFNegZero)
         (match (raw-pi (+ prec 32))
           ((Dyadic pm pe) (normalize-dyadic pm (- pe 1)))))
        ((BFValue (Dyadic m k))
         (cond
           ((== m 0)
            (match (raw-pi (+ prec 32))
              ((Dyadic pm pe) (normalize-dyadic pm (- pe 1)))))
           (True
            (let x-mag = (+ (bit-length m) k))
            (cond
              ((< x-mag (neg (+ prec 4)))
               (match (raw-pi (+ prec 32))
                 ((Dyadic pm pe)
                  (normalize-dyadic (- (lsh pm 1) (sign m)) (- pe 2)))))
              (True
               (let abs-d = (Dyadic (abs m) k))
               (match (<=> abs-d (Dyadic 1 0))
                 ((GT) BFNaN)
                 ((EQ)
                  (if (> m 0)
                      (BFValue (Dyadic 0 0))
                      (bf-pi)))
                 ((LT)
                  ;; Use cancellation-free identity:
                  ;; For x > 0: acos(x) = 2 * atan(sqrt((1 - x) / (1 + x)))
                  ;; For x < 0: acos(x) = pi - 2 * atan(sqrt((1 + x) / (1 - x)))
                  (let w = (+ prec 36))
                  (let (Dyadic num-m num-e) = (- (Dyadic 1 0) abs-d))
                  (let (Dyadic den-m den-e) = (+ (Dyadic 1 0) abs-d))
                  (let div-shift = (+ (+ (* 2 w) 6) (- (bit-length den-m) (bit-length num-m))))
                  (let ratio-e0 = (- (- num-e den-e) div-shift))
                  (let adj-shift = (if (odd? ratio-e0) (+ div-shift 1) div-shift))
                  (let ratio-q =
                    (if (>= adj-shift 0)
                        (div (lsh num-m adj-shift) den-m)
                        (div (rsh num-m (neg adj-shift)) den-m)))
                  (let sqrt-m = (isqrt ratio-q))
                  (let sqrt-e = (div (- (- num-e den-e) adj-shift) 2))
                  (let half-angle = (atan-dyadic sqrt-m sqrt-e w))
                  (let two-atan = (dyadic:scale half-angle 1))
                  (if (> m 0)
                      (match two-atan
                        ((Dyadic rm re) (normalize-dyadic rm re)))
                      (match (- (raw-pi (+ w 16)) two-atan)
                        ((Dyadic rm re) (normalize-dyadic rm re)))))))))))
        (_ BFNaN)))))

(coalton-toplevel

  (declare exp-dyadic (Integer * Integer * Integer -> Dyadic))
  (define (exp-dyadic m k prec)
    "Compute exp(M * 2^K) as a Dyadic with at least PREC + 32 bits of precision."
    (cond
      ((== m 0)
       (Dyadic 1 0))
      (True
       (let x-mag = (+ (bit-length m) k))
       (cond
         ((< x-mag (neg (+ prec 4)))
          (Dyadic (+ (lsh 1 (+ prec 5)) (sign m))
                  (neg (+ prec 5))))
         (True
          (let work-prec = (+ (+ prec 36) (max 0 x-mag)))
          (let ln2-d = (raw-ln2 work-prec))
          (let x-fixed = (dyadic->fixed (Dyadic m k) work-prec))
          (let ln2-fixed = (dyadic->fixed ln2-d work-prec))
          (let q = (round-quotient x-fixed ln2-fixed))
          (let r-fixed = (- x-fixed (* q ln2-fixed)))
          (let s = (max 4 (isqrt (+ prec 32))))
          (let w2 = (+ (+ prec 36) s))
          (let r0 = (lsh r-fixed (- (- w2 s) work-prec)))
          (let neg-r0? = (< r0 0))
          (let abs-r0 = (abs r0))
          (let one = (lsh 1 w2))
          (let exp-r0 =
            (rec % ((j 1)
                    (term abs-r0)
                    (sub? neg-r0?)
                    (acc (if neg-r0? (- one abs-r0) (+ one abs-r0))))
              (cond
                ((== term 0) acc)
                (True
                 (let next-term = (quot (rsh (* term abs-r0) w2) (+ j 1)))
                 (let next-sub? = (if neg-r0? (not sub?) False))
                 (% (+ j 1)
                    next-term
                    next-sub?
                    (if next-sub? (- acc next-term) (+ acc next-term)))))))
          (let exp-r =
            (rec % ((i 0)
                    (y exp-r0))
              (if (>= i s)
                  y
                  (% (+ i 1) (rsh (* y y) w2)))))
          (Dyadic exp-r (- q w2)))))))

  (declare raw-ee (Integer -> Dyadic))
  (define (raw-ee prec)
    "Return a cached Dyadic approximation of e = exp(1) accurate to at least PREC + 32 bits."
    (let (Tuple cached-prec cached-d) = (lisp (-> (Tuple Integer Dyadic)) () *cached-ee*))
    (cond
      ((<= prec cached-prec)
       (trim-cached-dyadic cached-d prec))
      (True
       (let target = (max (+ prec 64) (* 2 cached-prec)))
       (let d = (exp-dyadic 1 0 target))
       (lisp (-> Void) (target d)
         (cl:progn
           (cl:setf *cached-ee* (Tuple target d))
           (cl:values)))
       (trim-cached-dyadic d prec))))

  (declare ln-dyadic (Integer * Integer * Integer -> Dyadic))
  (define (ln-dyadic m k prec)
    "Compute ln(M * 2^K) for M > 0 as a Dyadic with at least PREC + 32 bits of precision."
    (let len = (bit-length m))
    (let p2-exp = (+ k (- len 1)))
    (cond
      ((== m (lsh 1 (- len 1)))
       (cond
         ((== p2-exp 0)
          (Dyadic 0 0))
         (True
          (let w = (+ (+ prec 36) (bit-length p2-exp)))
          (match (raw-ln2 w)
            ((Dyadic lm le) (Dyadic (* p2-exp lm) le))))))
      (True
       (let e0 = (+ k len))
       ;; Check if m / 2^len < 11/16 (~ sqrt(1/2)) to center f near 1
       (let top4 = (if (>= len 4) (rsh m (- len 4)) (lsh m (- 4 len))))
       (let e = (if (< top4 11) (- e0 1) e0))
       (let extra-guard =
         (if (== e 0)
             (match (- (Dyadic m k) (Dyadic 1 0))
               ((Dyadic dm dk)
                (max 0 (neg (+ (bit-length dm) dk)))))
             0))
       (cond
         ((> extra-guard (+ prec 4))
          (match (- (Dyadic m k) (Dyadic 1 0))
            ((Dyadic dm dk)
             (let len-dm = (bit-length dm))
             (let s = (+ (- (max prec len-dm) len-dm) 4))
             (Dyadic (- (lsh dm s) 1) (- dk s)))))
         (True
          (let work-prec = (+ (+ prec 36) (+ (bit-length e) extra-guard)))
          (let s = (max 4 (isqrt (+ prec 32))))
          (let w2 = (+ work-prec s))
          (let f-init = (dyadic->fixed (Dyadic m (- k e)) w2))
          (let f0 =
            (rec % ((i 0)
                    (f f-init))
              (if (>= i s)
                  f
                  (% (+ i 1) (isqrt (lsh f w2))))))
          (let one = (lsh 1 w2))
          (let u = (quot (lsh (- f0 one) w2) (+ f0 one)))
          (let neg-u? = (< u 0))
          (let abs-u = (abs u))
          (let u2 = (rsh (* abs-u abs-u) w2))
          (let abs-atanh-u =
            (rec % ((j 3)
                    (term (rsh (* abs-u u2) w2))
                    (acc abs-u))
              (let step = (quot term j))
              (if (== step 0)
                  acc
                  (% (+ j 2) (rsh (* term u2) w2) (+ acc step)))))
          (let atanh-u = (if neg-u? (neg abs-atanh-u) abs-atanh-u))
          (let ln-f = (lsh atanh-u (+ s 1)))
          (let ln2-fixed =
            (if (== e 0)
                0
                (dyadic->fixed (raw-ln2 w2) w2)))
          (let total = (+ ln-f (* e ln2-fixed)))
          (Dyadic total (neg w2)))))))

  (declare pow-dyadic-int (Dyadic * Integer * Integer -> Dyadic))
  (define (pow-dyadic-int base exp-int max-bits)
    "Raise Dyadic BASE to non-negative integer EXP-INT, capping intermediates to MAX-BITS."
    (rec % ((b base)
            (n exp-int)
            (acc (Dyadic 1 0)))
      (cond
        ((<= n 0) acc)
        (True
         (let next-acc =
           (if (odd? n)
               (match (* acc b)
                 ((Dyadic pm pe) (cap-dyadic-bits pm pe max-bits)))
               acc))
         (if (== n 1)
             next-acc
             (match (* b b)
               ((Dyadic sm se)
                (% (cap-dyadic-bits sm se max-bits)
                   (quot n 2)
                   next-acc))))))))

  (declare integer-root (Integer * Integer -> Integer))
  (define (integer-root n a)
    "Floor of the positive nth root of a positive integer."
    (cond
      ((== n 1) a)
      ((== n 2) (isqrt a))
      (True
       (rec go ((r (lsh 1 (ceiling/ (bit-length a) n))))
         (let s = (quot (+ (* (- n 1) r) (quot a (^ r (- n 1)))) n))
         (if (>= s r) r (go s))))))

  (declare round-rational-root (Integer * Integer * Integer * Integer * Boolean -> BigFloat))
  (define (round-rational-root n num den e negative?)
    "Round the signed nth root of (num/den)*2^e with exact guard and sticky bits."
    (let estimate = (- (bit-length num) (bit-length den)))
    (let mag = (+ e (if (< (Dyadic num 0) (Dyadic den estimate)) (- estimate 1) estimate)))
    (let unit = (- (div mag n) (to-integer (get-precision))))
    (let shift = (- e (* n unit)))
    (let (values a r) = (quotrem (lsh num (max 0 shift)) (lsh den (max 0 (neg shift)))))
    (let q = (integer-root n a))
    (let exact? = (and (== r 0) (== (^ q n) a)))
    (let sticky = (+ (lsh q 1) (if exact? 0 1)))
    (normalize-dyadic (if negative? (neg sticky) sticky) (- unit 1)))

  (declare exact-binary-root (Dyadic * Integer -> Optional Dyadic))
  (define (exact-binary-root d depth)
    ;; For odd m > 1, each exact square root at least halves its bit length.
    (let (Dyadic m e) = (dyadic:simplify d))
    (cond
      ((and (/= e 0) (> depth (bit-length e))) None)
      ((and (> m 1) (> depth (bit-length (bit-length m)))) None)
      ((/= e (lsh (rsh e depth) depth)) None)
      (True
       (rec go ((m m) (k depth))
         (cond
           ((or (== k 0) (== m 1)) (Some (Dyadic m (rsh e depth))))
           (True
            (let s = (isqrt m))
            (if (== (* s s) m) (go s (- k 1)) None)))))))

  (declare bounded-algebraic-power (Dyadic * Dyadic -> Optional BigFloat))
  (define (bounded-algebraic-power x y)
    (let (Dyadic a k) = (dyadic:simplify y))
    (let depth = (max 0 (neg k)))
    (let mag-a = (+ (bit-length a) (max 0 k)))
    (cond
      ((and (<= depth 6) (<= mag-a 7) (<= (lsh (abs a) (max 0 k)) 64))
       ;; Modest reduced numerator and denominator: round the algebraic
       ;; value itself, including non-perfect roots next to a boundary.
       (let p = (lsh a (max 0 k)))
       (let (Dyadic m e) = (dyadic:simplify x))
       (let m^p = (^ m (abs p)))
       (Some (round-rational-root (lsh 1 depth)
                                  (if (> p 0) m^p 1) (if (> p 0) 1 m^p)
                                  (* e p) False)))
      (True
       ;; A dyadic result or halfway case requires a perfect 2^depth-th
       ;; root and at most precision+1 significant bits in the final power.
       (match (exact-binary-root x depth)
         ((Some (Dyadic root e))
          (let budget = (+ 1 (to-integer (get-precision))))
          (cond
            ((and (<= mag-a (bit-length budget))
                  (<= (* (- (bit-length root) 1) (lsh (abs a) (max 0 k))) budget))
             (let p = (lsh a (max 0 k)))
             (let m^p = (^ root (abs p)))
             (Some (if (> p 0)
                       (normalize-dyadic m^p (* e p))
                       (div-dyadic 1 (* e p) m^p 0))))
            (True None)))
         ((None) None)))))

  (declare bf-hyperbolic (BigFloat * Boolean -> BigFloat))
  (define (bf-hyperbolic x tanh?)
    (let prec = (to-integer (get-precision)))
    (match (resolve x)
      ((BFInf) (if tanh? one BFInf))
      ((BFNegInf) (if tanh? (neg one) BFNegInf))
      ((BFNegZero) BFNegZero)
      ((BFValue (Dyadic m e))
       (let mag = (+ e (bit-length m)))
       (let a = (BFValue (Dyadic (abs m) e)))
       (cond
         ((== m 0) a)
         ((< (* 2 mag) (neg (+ 4 (max prec (bit-length m)))))
          ;; Both functions approach x from the side nearer zero. The
          ;; cubic correction is smaller than the input and output grids.
          (let s = (max 3 (- (+ prec 3) (bit-length m))))
          (normalize-dyadic (* (sign m) (- (lsh (abs m) s) 1)) (- e s)))
         ((and tanh? (> (Dyadic (abs m) e) (Dyadic (+ prec 2) 0)))
          (let p = (+ prec 3))
          (normalize-dyadic (* (sign m) (- (lsh 1 p) 1)) (neg p)))
         (True
          (normalize
           (with-precision-rounding
             (fn ()
               (let v = (cond
                          (tanh?
                           (let t = (exp (bf-negate (scale a 1))))
                           (/ (- one t) (+ one t)))
                          (True (ln (+ a (sqrt (+ one (* a a))))))))
               (if (< m 0) (bf-negate v) v))
             :precision (from-int (+ (+ prec 16) (max 0 (neg mag))))
             :rounding RoundEven)))))
      (_ BFNaN)))

  (define-instance (Exponentiable BigFloat)
    (define (tanh x) (bf-hyperbolic x True))
    (define (asinh x) (bf-hyperbolic x False))
    (define (exp x)
      (let prec = (to-integer (get-precision)))
      (match (resolve x)
        ((BFValue (Dyadic m k))
         (match (exp-dyadic m k prec)
           ((Dyadic em ee-exp) (normalize-dyadic em ee-exp))))
        ((BFNegZero) (normalize-dyadic 1 0))
        ((BFInf) BFInf)
        ((BFNegInf) (BFValue (Dyadic 0 0)))
        (_ BFNaN)))
    (define (ln x)
      (let prec = (to-integer (get-precision)))
      (match (resolve x)
        ((BFValue (Dyadic m k))
         (cond
           ((< m 0) BFNaN)
           ((== m 0) BFNegInf)
           (True
            (match (ln-dyadic m k prec)
              ((Dyadic lm le) (normalize-dyadic lm le))))))
        ((BFNegZero) BFNegInf)
        ((BFInf) BFInf)
        (_ BFNaN)))
    (define (pow x y)
      (let rx = (resolve x))
      (let ry = (resolve y))
      (let prec = (to-integer (get-precision)))
      (cond
        ((or (nan? rx) (nan? ry)) BFNaN)
        ((and (bf-zero? rx) (bf-zero? ry)) BFNaN)
        ((< rx 0) BFNaN)
        ((bf-zero? rx)
         (if (< ry 0)
             BFInf
             (BFValue (Dyadic 0 0))))
        ((bf-zero? ry)
         (if (infinite? rx)
             BFNaN
             (normalize-dyadic 1 0)))
        ((== rx 1)
         (if (infinite? ry)
             BFNaN
             (normalize-dyadic 1 0)))
        ((or (infinite? rx) (infinite? ry))
         (exp (* ry (ln rx))))
        (True
         (match (Tuple rx ry)
           ((Tuple (BFValue (Dyadic mx kx)) (BFValue (Dyadic my ky)))
            (let len-x = (bit-length mx))
            (let x-pow2? = (== mx (lsh 1 (- len-x 1))))
            (let p2-exp = (+ kx (- len-x 1)))
            (let tz-y = (lisp (-> Integer) (my)
                          (cl:1- (cl:integer-length (cl:logand my (cl:- my))))))
            (let y-int? = (>= (+ ky tz-y) 0))
            (let y-mag = (+ (bit-length my) ky))
            (match (bounded-algebraic-power (Dyadic mx kx) (Dyadic my ky))
              ((Some v) (return v))
              ((None) (values)))
            (cond
              (x-pow2?
               (let prod-d = (Dyadic (* p2-exp my) ky))
               (let q = (round prod-d))
               (let (Dyadic rm re) = (- prod-d (Dyadic q 0)))
               (cond
                 ((== rm 0)
                  (normalize-dyadic 1 q))
                 (True
                  (let w = (+ prec 36))
                  (let (Dyadic lm le) = (raw-ln2 w))
                  (let (Dyadic exp-m exp-e) = (exp-dyadic (* rm lm) (+ re le) prec))
                  (normalize-dyadic exp-m (+ exp-e q)))))
              ((and y-int? (<= y-mag 20))
               (let n-int = (lsh my ky))
               (let (Dyadic pm pe) = (pow-dyadic-int (Dyadic mx kx) (abs n-int) (+ prec 48)))
               (if (>= n-int 0)
                   (normalize-dyadic pm pe)
                   (div-dyadic 1 0 pm pe)))
              ((and (== (+ ky tz-y) -1) (<= y-mag 20))
               ;; Half-integer exponent y = odd-y / 2: compute via exact/high-precision sqrt
               (let odd-y = (rsh my tz-y))
               (match (with-precision-rounding
                        (fn () (sqrt-dyadic mx kx))
                        :precision (from-int (+ prec 48))
                        :rounding RoundEven)
                 ((BFValue sqrt-d)
                  (let (Dyadic pm pe) = (pow-dyadic-int sqrt-d (abs odd-y) (+ prec 48)))
                  (if (>= odd-y 0)
                      (normalize-dyadic pm pe)
                      (div-dyadic 1 0 pm pe)))
                 (_ BFNaN)))
              (True
               (let w = (+ (+ prec 36) (max 0 y-mag)))
               (let (Dyadic lnm lne) = (ln-dyadic mx kx w))
               (let prod-m = (* my lnm))
               (let prod-e = (+ ky lne))
               (let prod-mag = (+ (bit-length prod-m) prod-e))
               (let (Dyadic cm ce) = (cap-dyadic-bits prod-m prod-e (+ (+ prec 44) (max 0 prod-mag))))
               (match (exp-dyadic cm ce prec)
                 ((Dyadic em ee-exp) (normalize-dyadic em ee-exp))))))
           (_ BFNaN)))))
    (define (log b x)
      (normalize
       (with-precision-rounding
         (fn () (/ (ln x) (ln b)))
         :precision (+ (get-precision) 16)
         :rounding RoundEven))))

  (declare bf-ee (Void -> BigFloat))
  (define (bf-ee)
    "Return the value of ee = exp(1) to the currently set precision."
    (match (raw-ee (to-integer (get-precision)))
      ((Dyadic m e) (normalize-dyadic m e))))

  (define-instance (Radical BigFloat)
    (define (hypot x y)
      (if (or (infinite? x) (infinite? y)) BFInf (canonical-hypot x y)))
    (define (sqrt x)
      (match (resolve x)
        ((BFValue (Dyadic m e))
         (cond
           ((< m 0) BFNaN)
           ((== m 0) (BFValue (Dyadic 0 0)))
           (True (sqrt-dyadic m e))))
        ((BFNegZero) BFNegZero)
        ((BFInf) BFInf)
        (_ BFNaN)))
    (define (nth-root n x)
      (cond
        ((== n 0) BFNaN)
        ((bf-zero? x)
         (let neg? = (and (odd? n) (bf-negative-sign? x)))
         (cond ((> n 0) (if neg? BFNegZero (BFValue (Dyadic 0 0))))
               (True (if neg? BFNegInf BFInf))))
        ((and (bf-negative-sign? x) (even? n)) BFNaN)
        ((infinite? x)
         (cond ((> n 0) (resolve x))
               (True (if (bf-negative-sign? x) BFNegZero (BFValue (Dyadic 0 0))))))
        ((nan? x) BFNaN)
        ((== n 1) (normalize x))
        ((== n 2) (sqrt x))
        ((<= (abs n) 64)
         (let (Dyadic m e) = (the Dyadic (approx 0 x)))
         (round-rational-root (abs n) (if (> n 0) (abs m) 1) (if (> n 0) 1 (abs m))
                              (if (> n 0) e (neg e)) (< m 0)))
        ((bf-negative-sign? x)
         (let mode = (match (get-rounding-mode)
                       ((RoundUp) RoundDown)
                       ((RoundDown) RoundUp)
                       (r r)))
         (bf-negate (with-rounding (fn () (nth-root n (bf-negate x))) :rounding mode)))
        ((< n 0)
         (normalize
          (with-precision-rounding
            (fn () (recip (nth-root (neg n) x)))
            :precision (+ (get-precision) 16)
            :rounding RoundEven)))
        (True
         (match (resolve x)
           ((BFNegZero) BFNegZero)
           ((BFInf) BFInf)
           ((BFValue (Dyadic m k))
            (cond
              ((< m 0) BFNaN)
              ((== m 0) (BFValue (Dyadic 0 0)))
              (True
               (let prec = (to-integer (get-precision)))
               (let len = (bit-length m))
               (let p2-exp = (+ k (- len 1)))
               (let (values q-exp r-exp) = (divmod p2-exp n))
               (cond
                 ((and (== m (lsh 1 (- len 1))) (== r-exp 0))
                  (normalize-dyadic 1 q-exp))
                 (True
                  (let k-red = (- r-exp (- len 1)))
                  (let w = (+ prec 36))
                  (let (Dyadic lnm lne) = (ln-dyadic m k-red w))
                  (let shift = (+ (+ w 8) (- (bit-length n) (bit-length lnm))))
                  (let div-m =
                    (if (>= shift 0)
                        (quot (lsh lnm shift) n)
                        (quot (rsh lnm (neg shift)) n)))
                  (let div-e = (- lne shift))
                  (let (Dyadic em ee-exp) = (exp-dyadic div-m div-e prec))
                  (let (Dyadic m-odd k-odd) = (dyadic:simplify (Dyadic m k)))
                  (let (values q-odd r-odd) = (divmod k-odd n))
                  (cond
                    ((== r-odd 0)
                     (let cand = (round (Dyadic em (- (+ ee-exp q-exp) q-odd))))
                     (if (and (> cand 0) (== (^ cand n) m-odd))
                         (normalize-dyadic cand q-odd)
                         (normalize-dyadic em (+ ee-exp q-exp))))
                    (True
                     (normalize-dyadic em (+ ee-exp q-exp)))))))))
           (_ BFNaN))))))

  (define-instance (Elementary BigFloat)
    (define pi (BFConst bf-pi))
    (define ee (BFConst bf-ee)))

  (define-instance (Polar BigFloat)
    (define (phase z)
      (let x = (real-part z))
      (let y = (imag-part z))
      (match (Tuple (<=> x 0) (<=> y 0))
        ((Tuple (GT) _)    (atan (/ y x)))
        ((Tuple (LT) (LT)) (- (atan (/ y x)) pi))
        ((Tuple (LT) _)    (+ (atan (/ y x)) pi))
        ((Tuple (EQ) (GT)) (/ pi 2))
        ((Tuple (EQ) (LT)) (/ pi -2))
        ((Tuple (EQ) (EQ)) 0)))
    (define (polar z)
      (values (magnitude z) (phase z))))

  (declare scale-fraction-10 (Fraction * Integer -> Integer))
  (define (scale-fraction-10 frac scale-10)
    (if (>= scale-10 0)
        (round (* frac (^ 10 scale-10)))
        (round (/ frac (^ 10 (neg scale-10))))))

  (define (big-float->string x)
    "Returns a BigFloat in scientific notation."
    (match (resolve x)
      ((BFValue (Dyadic 0 _)) "0.0e+0")
      ((BFValue (Dyadic m k))
       (let neg? = (< m 0))
       (let abs-frac = (the Fraction (into (Dyadic (abs m) k))))
       (let digits = (max 1 (to-integer (ilog 10 (lsh 2 (get-precision))))))
       (let bit-exp = (+ (- (bit-length m) 1) k))
       (let e10-est = (floor/ (* bit-exp 30103) 100000))
       (let scale-10 = (- digits e10-est))
       (let ten-pow = (^ 10 digits))
       (let ten-pow-next = (* 10 ten-pow))
       (let (Tuple z e10) =
         (rec % ((e e10-est)
                 (zv (scale-fraction-10 abs-frac scale-10)))
           (cond
             ((>= zv ten-pow-next)
              (let next-e = (+ e 1))
              (let next-z = (scale-fraction-10 abs-frac (- digits next-e)))
              (if (< next-z ten-pow)
                  (Tuple ten-pow next-e)
                  (% next-e next-z)))
             ((< zv ten-pow)
              (let next-e = (- e 1))
              (let next-z = (scale-fraction-10 abs-frac (- digits next-e)))
              (if (>= next-z ten-pow-next)
                  (Tuple ten-pow e)
                  (% next-e next-z)))
             (True
              (Tuple zv e)))))
       (lisp (-> String) (neg? z digits ten-pow e10)
         (cl:multiple-value-bind (lead rem) (cl:truncate z ten-pow)
           (cl:format nil "~:[~;-~]~d.~v,'0de~@d"
                      neg? lead digits (cl:abs rem) e10))))
      ((BFNegZero) "-0.0e+0")
      ((BFInf) "Inf")
      ((BFNegInf) "-Inf")
      ((BFNaN) "NaN")
      (_ "NaN"))))

(cl:defmethod cl:print-object ((obj bigfloat/bfvalue) out)
  (cl:write-string (big-float->string obj) out))
(cl:defmethod cl:print-object ((obj bigfloat/bfnegzero) out)
  (cl:write-string (big-float->string obj) out))
(cl:defmethod cl:print-object ((obj bigfloat/bfconst) out)
  (cl:write-string (big-float->string obj) out))
(cl:defmethod cl:print-object ((obj bigfloat/bfinf) out)
  (cl:write-string (big-float->string obj) out))
(cl:defmethod cl:print-object ((obj bigfloat/bfneginf) out)
  (cl:write-string (big-float->string obj) out))
(cl:defmethod cl:print-object ((obj bigfloat/bfnan) out)
  (cl:write-string (big-float->string obj) out))

#+sb-package-locks
(sb-ext:lock-package "COALTON/BIG-FLOAT")
