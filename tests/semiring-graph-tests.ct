(in-package #:coalton-native-tests)

(coalton-toplevel
  ;; Enumerate walks one outgoing edge at a time, independently of matrix powering.
  (declare enumerate-walks (List (sg:Edge Integer) * UFix * UFix * UFix -> Integer))
  (define (enumerate-walks edges i j k)
    (if (== k 0)
        (if (== i j) 1 0)
        (fold (fn (total (sg:Edge source target w))
                (if (== source i)
                    (+ total (* w (enumerate-walks edges target j (- k 1))))
                    total))
              0 edges)))

  (declare tropical-cycle-graph ((Integer -> :w) -> sg:Graph :w))
  (define (tropical-cycle-graph cost)
    (sg:graph 6 [(sg:Edge 0 1 (cost 5)) (sg:Edge 1 2 (cost 4))
                 (sg:Edge 2 1 (cost -6)) (sg:Edge 2 3 (cost 3))
                 (sg:Edge 0 4 (cost 1)) (sg:Edge 4 3 (cost 20))
                 (sg:Edge 4 4 (cost 2)) (sg:Edge 3 3 (cost 0))]))

  (declare enumerate-runs (List (sg:Transition Char Integer) * UFix * List Char * Vector Integer -> Integer))
  (define (enumerate-runs transitions state word final)
    (match word
      ((Nil) (vector:index-unsafe state final))
      ((Cons a rest)
       (fold (fn (total (sg:Transition i b j w))
               (if (and (== state i) (== a b))
                   (+ total (* w (enumerate-runs transitions j rest final)))
                   total))
             0 transitions))))

  ;; Upper triangular 2x2 matrices over counts saturated at 2. Addition is
  ;; not idempotent and multiplication is not commutative. No Eq or Ring.
  (define-type RunCounts (RunCounts UFix UFix UFix))

  (declare capped-counts (UFix * UFix * UFix -> RunCounts))
  (define (capped-counts a b c)
    (RunCounts (min 2 a) (min 2 b) (min 2 c)))

  (declare counts (RunCounts -> List UFix))
  (define (counts (RunCounts a b c)) [a b c])

  (define-instance (Additive RunCounts)
    (define (+ (RunCounts a b c) (RunCounts x y z))
      (capped-counts (+ a x) (+ b y) (+ c z)))
    (define zero (RunCounts 0 0 0)))

  (define-instance (Multiplicative RunCounts)
    (define (* (RunCounts a b c) (RunCounts x y z))
      (capped-counts (* a x) (+ (* a y) (* b z)) (* c z)))
    (define one (RunCounts 1 0 1)))

  (define-instance (Semiring RunCounts))
  (define-instance (sg:ClosedSemiring RunCounts)
    (define (sg:star (RunCounts a b c))
      ;; An off-diagonal walk crosses once, with loops on either side.
      (let left = (if (== a 0) 1 2))
      (let right = (if (== c 0) 1 2))
      (capped-counts left (* left (* b right)) right))))

(define-test test-semiring-graph-walks ()
  (let edges = [(sg:Edge 0 1 1) (sg:Edge 0 1 1) (sg:Edge 0 2 1)
                (sg:Edge 1 2 1) (sg:Edge 2 2 1) (sg:Edge 2 1 1)])
  (let graph = (sg:graph 4 edges))
  (for ((k 0 (1+ k))) :while (< k 6)
    (let walks = (sg:walks-of-length k graph))
    (for ((i 0 (1+ i))) :while (< i 4)
      (for ((j 0 (1+ j))) :while (< j 4)
        (is (== (mat:entry walks i j) (enumerate-walks edges i j k))))))

  (let reach = (sg:graph 4 (map (fn ((sg:Edge i j _)) (sg:Edge i j sg:Reachable)) edges)))
  (let yes = sg:Reachable)
  (let no = sg:Unreachable)
  (is (== (mat:to-rows (sg:all-pairs-closure reach))
          [[yes yes yes no] [no yes yes no] [no yes yes no] [no no no yes]]))
  (let double-loop = (sg:graph 1 [(sg:Edge 0 0 (the Integer 1)) (sg:Edge 0 0 1)]))
  (is (== (mat:entry (sg:walks-of-length 128 double-loop) 0 0) (^ 2 128))))

(define-test test-semiring-graph-tropical-cycles ()
  ;; 0->1->2->3 can use a negative cycle; 0->4->3 a positive one.
  ;; Both can loop at 3 for zero cost without improving either extremum.
  (let graph = (tropical-cycle-graph sg:MinFinite))
  (let shortest = (sg:all-pairs-closure graph))
  (let low = sg:MinUnbounded)
  (let inf = sg:MinNoPath)
  (is (== (mat:row shortest 0) [(sg:MinFinite 0) low low low (sg:MinFinite 1) inf]))
  (is (== (mat:row shortest 4) [inf inf inf (sg:MinFinite 20) (sg:MinFinite 0) inf]))
  (is (== (mat:entry shortest 5 5) (sg:MinFinite 0)))
  (is (== (mat:entry (sg:walks-of-length 5 graph) 0 3) (sg:MinFinite 10)))

  (let longest = (sg:all-pairs-closure (tropical-cycle-graph sg:MaxFinite)))
  (let high = sg:MaxUnbounded)
  (let missing = sg:MaxNoPath)
  (is (== (mat:row longest 0) [(sg:MaxFinite 0) (sg:MaxFinite 5) (sg:MaxFinite 9)
                               high high missing]))
  (is (== (mat:row longest 2) [missing (sg:MaxFinite -6) (sg:MaxFinite 0)
                               (sg:MaxFinite 3) missing missing])))

(define-test test-semiring-graph-word-weights ()
  (let transitions = [(sg:Transition 0 #\a 0 2) (sg:Transition 0 #\a 1 1)
                      (sg:Transition 0 #\a 1 3) (sg:Transition 1 #\b 0 4)
                      (sg:Transition 1 #\b 1 2)])
  (let final = [7 5])
  (let machine = (sg:automaton [2 3] transitions final))
  (let ends = (into final))
  ;; Compare every word of length 0..4 against a depth-first enumeration of runs.
  (let ((check (fn (word remaining)
                 (is (== (sg:word-weight machine word)
                         (+ (* 2 (enumerate-runs transitions 0 word ends))
                            (* 3 (enumerate-runs transitions 1 word ends)))))
                 (when (> remaining 0)
                   (check (Cons #\a word) (- remaining 1))
                   (check (Cons #\b word) (- remaining 1))))))
    (check [] (the UFix 4)))
  (is (== (sg:word-weight machine [#\z]) 0)))

(define-test test-semiring-graph-ordered-products ()
  (let left = (RunCounts 1 0 0))
  (let cross = (RunCounts 0 1 0))
  (let right = (RunCounts 0 0 1))
  (let graph = (sg:graph 3 [(sg:Edge 0 1 left) (sg:Edge 1 1 cross) (sg:Edge 1 2 right)]))
  ;; Only the walk using the self-loop exactly once has nonzero weight from 0 to 2.
  (is (== (counts (mat:entry (sg:walks-of-length 2 graph) 0 2)) [0 0 0]))
  (is (== (counts (mat:entry (sg:walks-of-length 3 graph) 0 2)) [0 1 0]))
  (let closure = (sg:all-pairs-closure graph))
  (is (== (counts (mat:entry closure 0 2)) [0 1 0]))
  (is (== (counts (mat:entry closure 1 1)) [1 1 1]))
  (let machine = (sg:automaton [left] [(sg:Transition 0 #\a 0 cross)
                                       (sg:Transition 0 #\b 0 right)] [right]))
  (is (== (counts (sg:word-weight machine [#\a #\b])) [0 1 0]))
  (is (== (counts (sg:word-weight machine [#\b #\a])) [0 0 0]))
  (is (== (counts (sg:word-weight machine [])) [0 0 0])))

(define-test test-semiring-graph-state-bounds ()
  (let empty = (the (sg:Graph sg:Reachability) (sg:graph 0 [])))
  (is (== (mat:rows (sg:walks-of-length 0 empty)) 0))
  (is (== (mat:cols (sg:all-pairs-closure empty)) 0))
  (let no-states = (the (sg:Automaton Char Integer) (sg:automaton [] [] [])))
  (is (== (sg:word-weight no-states []) 0))
  (is (catch (progn (sg:graph 2 [(sg:Edge 2 0 sg:Reachable)]) False)
        ((the Panic _) True)))
  (is (catch (progn (sg:automaton [1] [(sg:Transition 0 #\a 1 2)] [3]) False)
        ((the Panic _) True)))
  (is (catch (progn (the (sg:Automaton Char Integer) (sg:automaton [1] [] [])) False)
        ((the Panic _) True))))
