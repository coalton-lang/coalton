(in-package #:coalton-native-tests)

(coalton-toplevel
  (declare reconstruct-polynomial
    (coalton/classes:Semiring :a => :a * List (Tuple (poly:Polynomial :a) UFix) -> poly:Polynomial :a))
  (define (reconstruct-polynomial scalar factors)
    (fold (fn (f (Tuple g i)) (* f (^ g i))) (into scalar) factors)))

(define-test finite-polynomial-factorization ()
  ;; Both cubics are irreducible over F_2. They occur in the same square-free
  ;; layer: separating factors by degree alone would not split them.
  (let x = (the (poly:Polynomial (ff:Fp ff:P2)) poly:poly-var))
  (let g = (+ (+ (^ x 3) x) 1))
  (let h = (+ (+ (^ x 3) (^ x 2)) 1))
  (let f = (* (^ (* g h) 3) (^ (+ x 1) 4)))
  (let (values _ layers) = (factor:square-free-finite f))
  (is (== layers [(Tuple (* g h) 3) (Tuple (+ x 1) 4)]))
  (let (values scalar factors) = (factor:factor-finite f))
  (is (== (reconstruct-polynomial scalar factors) f))
  (is (== (list:length factors) 3))
  (is (list:all (fn ((Tuple a _)) (ff:irreducible? a)) factors))
  (is (list:member (Tuple g 3) factors))
  (is (list:member (Tuple h 3) factors))
  (is (list:member (Tuple (+ x 1) 4) factors)))

(define-test extension-field-polynomial-factorization ()
  (let x = (the (poly:Polynomial ff:GF4) poly:poly-var))
  (let u = (the ff:GF4 (ff:field-element 2)))
  (let g = (+ x (into u)))
  (let h = (+ x (into (* u u))))
  ;; The two roots are outside the prime subfield.
  (let (values c factors) = (factor:factor-finite (* g h)))
  (is (== (reconstruct-polynomial c factors) (* g h)))
  (is (== (list:length factors) 2))
  (is (list:member (Tuple g 1) factors))
  (is (list:member (Tuple h 1) factors))
  (is (list:all (fn ((Tuple a _)) (ff:irreducible? a)) factors))
  ;; A zero derivative is not a square-free certificate. Reading off every
  ;; second coefficient without taking its square root would yield h, not g.
  (let square = (math:scale u (^ g 2)))
  (is (== (poly:differentiate square) zero))
  (let (values unit powers) = (factor:factor-finite square))
  (is (== unit u))
  (is (== powers [(Tuple g 2)]))
  (is (== (reconstruct-polynomial unit powers) square)))

(define-test integer-polynomial-recombination ()
  ;; Mod 2 has repeated factors; mod 3 the quadratics coincide; mod 5 the
  ;; four linear factors must be lifted and recombined into two quadratics.
  (let x = (the (poly:Polynomial Integer) poly:poly-var))
  (let g = (+ (^ x 2) 1))
  (let h = (+ (^ x 2) 4))
  (let f = (math:scale -6 (^ (* g h) 2)))
  (let (values scalar factors) = (factor:factor-integer f))
  (is (== scalar -6))
  (is (== (reconstruct-polynomial scalar factors) f))
  (is (== (list:length factors) 2))
  (is (list:member (Tuple g 2) factors))
  (is (list:member (Tuple h 2) factors))
  ;; Independent irreducibility certificates: degree-preserving reductions
  ;; of both monic factors are irreducible modulo 3.
  (is (list:all (fn ((Tuple a _))
                  (ff:irreducible? (the (poly:Polynomial (ff:Fp ff:P3))
                                     (poly:polynomial (map coalton/classes:from-int (poly:coefficients a))))))
                factors))
  ;; Positive, nonunit leading coefficients on *both* integral factors.
  (let ga = (+ (+ (* 3 (^ x 2)) x) 1))
  (let ha = (+ (+ (* 5 (^ x 2)) x) 1))
  (let (values c nonmonic) = (factor:factor-integer (* ga ha)))
  (is (== (reconstruct-polynomial c nonmonic) (* ga ha)))
  (is (list:member (Tuple ga 1) nonmonic))
  (is (list:member (Tuple ha 1) nonmonic)))

(define-test polynomial-bad-primes-and-constants ()
  (let x = (the (poly:Polynomial Integer) poly:poly-var))
  ;; Each of the configured primes divides the leading coefficient. This
  ;; must not cause either a loop or a false declaration of irreducibility.
  (let g = (+ (* 510 x) 1))
  (let h = (+ x 1))
  (let (values scalar factors) = (factor:factor-integer (* g h)))
  (is (== (reconstruct-polynomial scalar factors) (* g h)))
  (is (list:member (Tuple g 1) factors))
  (is (list:member (Tuple h 1) factors))
  (let irreducible = (+ (* 510 (^ x 2)) 1))
  (let (values _ singleton) = (factor:factor-integer irreducible))
  (is (== singleton [(Tuple irreducible 1)]))
  ;; The same fallback must separate nonlinear factors, not just find roots.
  (let other = (+ (^ x 2) 1))
  (let (values c quadratics) = (factor:factor-integer (* irreducible other)))
  (is (== (reconstruct-polynomial c quadratics) (* irreducible other)))
  (is (list:member (Tuple irreducible 1) quadratics))
  (is (list:member (Tuple other 1) quadratics))
  (let (values z zf) = (factor:factor-integer 0))
  (is (== (Tuple z zf) (Tuple 0 Nil)))
  (let (values c cf) = (factor:factor-integer -42))
  (is (== (Tuple c cf) (Tuple -42 Nil)))
  (let (values u uf) = (factor:factor-finite (the (poly:Polynomial (ff:Fp ff:P3)) 2)))
  (is (== (Tuple u uf) (Tuple 2 Nil))))

(define-test rational-polynomial-factorization ()
  ;; Neither quadratic has a rational root (negative discriminants).
  (let x = (the (poly:Polynomial Fraction) poly:poly-var))
  (let g = (+ (+ (^ x 2) (math:scale 1/2 x)) 1))
  (let h = (+ (+ (^ x 2) (math:scale 1/3 x)) (into (the Fraction 1/3))))
  (let f = (math:scale -7/12 (* (^ g 2) h)))
  (let (values unit factors) = (factor:factor-rational f))
  (is (== unit -7/12))
  (is (== (reconstruct-polynomial unit factors) f))
  (is (== (list:length factors) 2))
  (is (list:member (Tuple g 2) factors))
  (is (list:member (Tuple h 1) factors))
  (is (not (factor:irreducible-rational? (* g h))))
  (is (not (factor:irreducible-rational? (^ g 2))))
  (is (factor:irreducible-rational? (math:scale -2/3 g))))

(define-test algebraic-number-field-arithmetic ()
  (let x = (the (poly:Polynomial Fraction) poly:poly-var))
  (let f = (- (^ x 4) 2)) ; Eisenstein at 2.
  (is (== (nfield:number-field 0) None))
  (is (== (nfield:number-field 3) None))
  (is (== (nfield:number-field (* (+ (^ x 2) 1) (+ (^ x 2) 4))) None))
  (let k = (unwrap (nfield:number-field f)))
  (is (== (nfield:number-field (math:scale -1/2 f)) (Some k)))
  (let a = (nfield:generator k))
  (let b = (unwrap (nfield:multiply a a)))
  (let c = (nfield:element k (+ x 1)))
  (let e = (nfield:element k 1))
  (let z = (nfield:element k 0))
  (is (== (nfield:element k (^ x 4)) (nfield:element k 2)))
  (is (== (nfield:multiply b b) (Some (nfield:element k 2))))
  (is (== (nfield:inverse a) (Some (nfield:element k (math:scale 1/2 (^ x 3))))))
  (is (== (nfield:multiply a (unwrap (nfield:inverse a))) (Some e)))
  (is (== (nfield:multiply c (unwrap (nfield:add a b)))
          (nfield:add (unwrap (nfield:multiply c a)) (unwrap (nfield:multiply c b)))))
  (is (== (nfield:subtract c a) (Some e)))
  (is (== (nfield:add c (nfield:negate c)) (Some z)))
  (is (== (nfield:divide b a) (Some a)))
  (is (== (nfield:inverse z) None))
  (is (== (nfield:divide e z) None))
  (let l = (unwrap (nfield:number-field (- (^ x 2) 2))))
  (is (/= b (nfield:generator l)))
  (is (== (nfield:multiply b (nfield:generator l)) None))
  (is (== (nfield:divide b (nfield:generator l)) None))
  ;; The ambient field has degree 4, but a^2 generates a quadratic subfield.
  (is (== (nfield:minimal-polynomial a) f))
  (let mb = (nfield:minimal-polynomial b))
  (is (== mb (- (^ x 2) 2)))
  (is (== (nfield:element k (poly:compose mb (nfield:representative b))) z))
  (is (factor:irreducible-rational? mb))
  (is (== (nfield:trace a) 0))
  (is (== (nfield:norm a) -2))
  (is (== (nfield:norm b) (* (nfield:norm a) (nfield:norm a))))
  (let s = (nfield:element k (into (the Fraction 3/2))))
  (is (== (nfield:minimal-polynomial s) (- x (into (the Fraction 3/2)))))
  (is (== (nfield:trace s) 6))
  (is (== (nfield:norm s) 81/16))
  (is (== (nfield:trace (unwrap (nfield:add s a))) (+ (nfield:trace s) (nfield:trace a)))))
