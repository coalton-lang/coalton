(in-package #:coalton-native-tests)

(define-test test-prime-field-evidence ()
  (matches (None) (ff:prime-field 561))
  ;; A strong probable-prime result alone must never construct a field.
  (matches (None) (ff:prime-field (- (^ 2 127) 1)))
  (let field = (unwrap (ff:prime-field 19)))
  (let ring = (ff:as-quotient field))
  (let a = (qr:residue ring -3))
  (is (== (qr:residue-inverse a) (Some (qr:residue ring 6))))
  (let b = (the (ff:Fp ff:P5) -2))
  (is (== (ff:representative b) 3))
  (is (== (/ 1 b) 2))
  (is (== (math:exact-quot b 0) None)))

(define-test test-finite-extension-arithmetic ()
  (let x = (the (poly:Polynomial (ff:Fp ff:P2)) poly:poly-var))
  (let f = (+ (+ (^ x 2) x) 1))
  (is (ff:irreducible? f))
  (is (not (ff:irreducible? (^ f 2))))
  (matches (None) (ff:extension-field (* x f)))
  (matches (None) (ff:extension-field (- f f)))
  (let a = (the ff:GF4 (ff:from-representative x)))
  (is (== (* a a) (+ a 1)))
  (is (== (math:recip a) (+ a 1)))
  (is (== (^ a 3) 1))
  (is (== 0 (the ff:GF4 2)))
  (is (== a (ff:field-element 2)))
  (is (== (ff:field-characteristic (types:proxy-of a)) 2))
  ;; y^2 + y + 1 splits over F4, but y^2 + y + a does not.
  (let y = (the (poly:Polynomial ff:GF4) poly:poly-var))
  (let g = (+ (^ y 2) y))
  (is (not (ff:irreducible? (+ g 1))))
  (let ext = (unwrap (ff:extension-field (+ g (into a)))))
  (is (== (ff:order ext) 16))
  (let r = (ff:as-quotient ext))
  (let b = (qr:residue r y))
  (is (== (qr:residue-power b 4) (qr:residue r (+ y 1))))
  (is (== (qr:residue-power b 16) b)))

(define-test test-coherent-field-roots ()
  ;; Check mixed (not only radix-two) orders by restriction in F13.
  (let field = (unwrap (ff:prime-field 13)))
  (let root = (fn (n) (unwrap (ff:residue-root-of-unity field n))))
  (is (== (qr:residue-power (root 12) 3) (root 4)))
  (is (== (qr:residue-power (root 12) 2) (root 6)))
  (is (== (qr:residue-power (root 6) 2) (root 3)))
  (is (/= (root 3) (root 1)))
  (is (== (qr:residue-power (root 4) 2) (qr:residue (ff:as-quotient field) -1)))
  (let a = (the ff:GF4 (fft:root-of-unity 3)))
  (is (/= a 1))
  (is (== (^ a 3) 1))
  (is (== (the (Optional ff:GF4) (ff:try-root-of-unity 2)) None))
  (is (== (ff:residue-root-of-unity field 0) None)))

(define-test test-number-theoretic-transform ()
  (let xs = (the (vector:Vector (ff:Fp ff:P17)) [1 2 3 4]))
  (let ys = (unwrap (ff:ntt xs)))
  ;; Independent DFT values, not just an inverse-pair test.
  (is (== ys [10 7 15 6]))
  (is (== (ff:inverse-ntt ys) (Some xs)))
  ;; A cyclic convolution is pointwise multiplication in transform space.
  (is (== (ff:inverse-ntt (map (fn (x) (* x x)) ys))
          (Some [9 11 9 3])))
  (let single = (the (vector:Vector ff:GF4) [1]))
  (is (== (ff:ntt single) (Some single)))
  (is (== (ff:ntt (the (vector:Vector ff:GF4) [0 1])) None))
  (is (== (ff:ntt (the (vector:Vector (ff:Fp ff:P17)) [])) None))
  (is (== (ff:ntt (the (vector:Vector (ff:Fp ff:P17)) [1 2 3])) None)))
