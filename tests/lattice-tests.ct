(in-package #:coalton-native-tests)

(define-test normal-form-integer-witnesses ()
  ;; A dependent row and a negative entry above a negative pivot.
  (let a = (the (mat:Matrix Integer)
             (mat:from-rows [[-2 4 0 2] [0 -6 6 0] [-4 2 6 4]])))
  (let (values h u pivots) = (nf:hermite-normal-form a))
  (is (== pivots [0 1]))
  (is (== h (mat:from-rows [[2 2 -6 -2] [0 6 -6 0] [0 0 0 0]])))
  (is (== h (* u a)))
  (is (== (abs (mat:det u)) 1))
  (let (values d l r factors) = (nf:smith-normal-form a))
  (is (== factors [2 6]))
  (is (== d (mat:from-rows [[2 0 0 0] [0 6 0 0] [0 0 0 0]])))
  (is (== d (* l (* a r))))
  (is (== (abs (mat:det l)) 1))
  (is (== (abs (mat:det r)) 1))
  (is (== (mat:mat-vec-mul a (mat:col r 2)) [0 0 0]))
  (is (== (mat:mat-vec-mul a (mat:col r 3)) [0 0 0]))
  ;; Image membership differs from membership in the rational span.
  (let (values images _ _) = (nf:hermite-normal-form (mat:transpose a)))
  (let av = (* a r))
  (let (values basis _ _) =
    (nf:hermite-normal-form (mat:from-rows [(mat:col av 0) (mat:col av 1)])))
  (is (== (mat:to-rows basis) [(mat:row images 0) (mat:row images 1)]))
  ;; A diagonal matrix need not be in Smith form.
  (let diag = (the (mat:Matrix Integer) (mat:diagonal-matrix [0 -6 10])))
  (let (values ds us vs fs) = (nf:smith-normal-form diag))
  (is (== fs [2 30]))
  (is (== ds (mat:diagonal-matrix [2 30 0])))
  (is (== ds (* (* us diag) vs)))
  (is (== (abs (mat:det us)) 1))
  (is (== (abs (mat:det vs)) 1)))

(define-test normal-form-polynomial-witnesses ()
  (let x = (the (poly:Polynomial Fraction) poly:poly-var))
  (let f = (+ x 1))
  (let a = (mat:from-rows [[(* -2 x) (* -2 (+ 1 (* x f)))] [0 f]]))
  (let (values h u pivots) = (nf:hermite-normal-form a))
  (is (== pivots [0 1]))
  (is (== h (mat:from-rows [[x 1] [0 f]])))
  (is (== h (* u a)))
  (is (== (math:normal-part (mat:det u)) 1))
  (let (values d l r factors) = (nf:smith-normal-form a))
  (is (== factors [1 (* x f)]))
  (is (== d (mat:diagonal-matrix factors)))
  (is (== (* (* l a) r) d))
  (is (== (math:normal-part (mat:det l)) 1))
  (is (== (math:normal-part (mat:det r)) 1)))

(define-test normal-form-and-lll-empty-shapes ()
  (for ((rs (the (List UFix) [0 3 0 2]) (list:cdr rs))
        (cs (the (List UFix) [3 0 0 4]) (list:cdr cs)))
       :while (not (list:null? rs))
    (let r = (list:car rs))
    (let c = (list:car cs))
    (let a = (the (mat:Matrix Integer) (mat:zero-matrix r c)))
    (let (values h u pivots) = (nf:hermite-normal-form a))
    (is (== h a))
    (is (== u (mat:identity-matrix r)))
    (is (== pivots []))
    (let (values d l v factors) = (nf:smith-normal-form a))
    (is (== d a))
    (is (== l (mat:identity-matrix r)))
    (is (== v (mat:identity-matrix c)))
    (is (== factors []))
    (let (values b transform rank) = (lattice:lll a))
    (is (== b a))
    (is (== transform (mat:identity-matrix r)))
    (is (== rank 0))))

(coalton-toplevel
  ;; An independent exact check: construct the orthogonal vectors explicitly
  ;; instead of using the implementation's triangular Gram/LDL data.
  (declare lattice-test-dot (List Fraction * List Fraction -> Fraction))
  (define (lattice-test-dot x y)
    (list:sum (list:zipwith * x y)))

  (declare lattice-test-reduced? (mat:Matrix Integer * UFix * Fraction -> Boolean))
  (define (lattice-test-reduced? b rank delta)
    (let stars = (vector:new))
    (let norms = (vector:new))
    (for ((i 0 (1+ i))) :while (< i rank)
      (let row = (map from-int (mat:row b i)))
      (let star =
        (for ((j 0 (1+ j))
              (v row
                 (let ((s (vector:index-unsafe j stars))
                       (d (vector:index-unsafe j norms))
                       (mu (/ (lattice-test-dot row s) d)))
                   (when (> (abs mu) 1/2) (return False))
                   (list:zipwith (fn (x y) (- x (* mu y))) v s))))
             :returns v :while (< j i)))
      (let norm = (lattice-test-dot star star))
      (unless (> norm 0) (return False))
      (when (> i 0)
        (let d = (vector:index-unsafe (1- i) norms))
        (let mu = (/ (lattice-test-dot row (vector:index-unsafe (1- i) stars)) d))
        (when (< norm (* (- delta (* mu mu)) d)) (return False)))
      (vector:push! star stars)
      (vector:push! norm norms))
    (for ((i rank (1+ i))) :while (< i (mat:rows b))
      (unless (list:all zero? (mat:row b i)) (return False)))
    True))

(define-test lll-reduced-bases-and-witnesses ()
  (let n = (^ (the Integer 2) 85))
  (let full = (mat:from-rows [[(1+ n) n 0 0 1]
                              [n (1- n) 0 0 1]
                              [2 (+ n 2) 1 1 0]
                              [1 0 0 0 0]]))
  (let (values b u rank) = (lattice:lll full :delta 99/100))
  (is (== rank 4))
  (is (== (abs (mat:det u)) 1))
  (is (== b (* u full)))
  (is (lattice-test-reduced? b rank 99/100))
  (let dependent = (the (mat:Matrix Integer)
                     (mat:from-rows [[6 12 0 0] [10 20 0 0] [3 0 9 0] [0 0 0 0]])))
  (let (values b u rank) = (lattice:lll dependent))
  (is (== rank 2))
  (is (== b (* u dependent)))
  (is (== (abs (mat:det u)) 1))
  (is (lattice-test-reduced? b rank 3/4))
  (let tall = (the (mat:Matrix Integer) (mat:from-rows [[6] [-10] [0]])))
  (let (values b u rank) = (lattice:lll tall))
  (is (== rank 1))
  (is (== (abs (mat:entry b 0 0)) 2))
  (is (== b (* u tall)))
  (is (== (abs (mat:det u)) 1))
  (is (lattice-test-reduced? b rank 3/4)))

(define-test lattice-invalid-parameters ()
  (is (lisp (-> Boolean) ()
        (cl:every (cl:lambda (delta)
                    (cl:handler-case
                        (cl:progn (coalton (lattice:lll (mat:identity-matrix 2)
                                                        :delta (lisp (-> Fraction) () delta)))
                                  cl:nil)
                      (cl:error () cl:t)))
                  '(-1 1/4 1 2))))
  (is (lisp (-> Boolean) ()
        (cl:handler-case
            (cl:progn (coalton (pslq:pslq [(the Integer 1) 2] :max-coefficient 0)) cl:nil)
          (cl:error () cl:t)))))

(define-test pslq-exact-relations ()
  (match (pslq:pslq [(the Fraction 3/7) 5/11] :max-coefficient 35)
    ((pslq:ExactRelation c) (is (== c [35 -33])))
    (_ (is False)))
  ;; Discover a polynomial of the exact algebraic number 1 + sqrt(2).
  (let x = (+ 1 (sqrt (the ra:RealAlgebraic 2))))
  (match (pslq:pslq [1 x (* x x)] :bits 80 :max-coefficient 4)
    ((pslq:ExactRelation c) (is (== c [1 2 -1])))
    (_ (is False)))
  (match (pslq:pslq [(the Integer 12) 0 18])
    ((pslq:ExactRelation c) (is (== c [0 1 0])))
    (_ (is False)))
  (matches (pslq:NoRelation) (pslq:pslq (the (List Fraction) [])))
  (matches (pslq:NoRelation) (pslq:pslq [(the Fraction 1/3)])))

(define-test pslq-independent-verification ()
  (let a = (sqrt (the creal:CReal 2)))
  (let b = (sqrt (the creal:CReal 3)))
  (let c = (+ (* 5 a) (* 7 b)))
  (let inputs = (the (List creal:CReal) [a b c]))
  ;; A zero coefficient need not inspect its oracle; nonzero coefficients
  ;; require stored rationals for an exact certificate.
  (is (== (pslq:exact-dot-zero? [3 -1 0] [(into 1/3) 1 a]) (Some True)))
  (is (== (pslq:exact-dot-zero? [1 -1] [a a]) None))
  (for ((scales (the (List Fraction) [1 (^^ 2 -210) (^ 2 190)]) (list:cdr scales)))
       :while (not (list:null? scales))
    (let scale = (list:car scales))
    (let scaled = (map (fn (x) (* (into scale) x)) inputs))
    (match (pslq:pslq scaled :bits 96 :max-coefficient 7)
      ((pslq:RelationCandidate cs bound)
       (is (== cs [5 7 -1]))
       (is (< bound (* scale (^^ 2 -130)))))
      (_ (is False))))
  ;; Same working mantissas as the true relation, but distinguishable at
  ;; verification precision. The exact rational version is closer still.
  (let epsilon = (the Fraction (^^ 2 -100)))
  (matches (pslq:PrecisionExhausted)
           (pslq:pslq [a b (+ c (into epsilon))] :bits 64 :max-coefficient 7))
  (matches (pslq:PrecisionExhausted)
           (pslq:pslq [(the Fraction 1) (+ 1 (^^ 2 -500))] :bits 96))
  (matches (pslq:PrecisionExhausted)
           (pslq:pslq [a (* a (into (the Fraction (^^ 2 -200))))] :bits 64))
  (matches (pslq:CoefficientLimit) (pslq:pslq [(the Integer 2) 3] :max-coefficient 2))
  (matches (pslq:IterationLimit) (pslq:pslq [a b (sqrt 5)] :max-iterations 0))
  (matches (pslq:PrecisionExhausted) (pslq:pslq inputs :bits 12)))
