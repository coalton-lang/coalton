(in-package #:coalton-native-tests)

(coalton-toplevel
  (define-type Mod12 Mod12)
  (define ring12 (unwrap (qr:integer-quotient 12)))
  (define-instance (qr:KnownQuotient Mod12 Integer)
    (define (qr:fixed-quotient _) ring12)))

(define-test test-fixed-residue-ring ()
  (let a = (the (qr:ZMod Mod12) 8))
  (is (== (* a 3) 0))
  (is (== (qr:unit-inverse a) None))
  (is (== (qr:unit-inverse (- a 3)) (Some 5)))
  (is (== (poly:evaluate (poly:polynomial [1 2 3]) a) 5)))

(define-test test-integer-residue-units ()
  (let r = (unwrap (qr:integer-quotient 12)))
  (let a = (qr:residue r -7))
  (let b = (qr:residue r 8))
  (is (== (qr:residue-value a) 5))
  (is (== (qr:residue-inverse a) (Some a)))
  (is (== (qr:residue-inverse b) None))
  (is (== (qr:residue* b (qr:residue r 3)) (Some (qr:residue r 0))))
  (let other = (qr:residue (unwrap (qr:integer-quotient 7)) 5))
  (is (/= other a))
  (is (== (qr:residue+ a other) None))
  (is (== (qr:integer-quotient 0) None)))

(define-test test-polynomial-residue-contexts ()
  (let x = (the (poly:Polynomial Fraction) poly:poly-var))
  (let f = (- (^ x 2) 1))
  (let r = (unwrap (qr:polynomial-quotient f)))
  (let associate = (unwrap (qr:polynomial-quotient (* -2 f))))
  (let a = (qr:residue r (+ x 1)))
  (let b = (qr:residue associate (- x 1)))
  (is (== (qr:residue* a b) (Some (qr:residue r 0))))
  (is (== (qr:residue-inverse a) None))
  (is (== (qr:residue-inverse (qr:residue r x)) (Some (qr:residue r x))))
  (is (== (qr:residue-power (qr:residue r x) 11) (qr:residue r x)))
  (let other = (unwrap (qr:polynomial-quotient (+ (^ x 2) 1))))
  (is (== (qr:residue* a (qr:residue other x)) None)))
