(in-package #:coalton-native-tests)

(define-test test-rounding ()
  (is (== 0 (floor 0.1)))
  (is (== 1 (ceiling 0.1)))
  (is (== 0 (round 0.1)))
  (is (== 0 (math:round-half-up 0.1)))
  (is (== 0 (math:round-half-down 0.1)))
  (is (== 0 (math:truncate 0.1)))

  (is (== -1 (floor -0.1)))
  (is (== 0 (ceiling -0.1)))
  (is (== 0 (round -0.1)))
  (is (== 0 (math:round-half-up -0.1)))
  (is (== 0 (math:round-half-down -0.1)))
  (is (== 0 (math:truncate -0.1)))
  
  (is (== 0 (floor 0.0)))
  (is (== 0 (ceiling 0.0)))
  (is (== 0 (round 0.0)))
  (is (== 0 (math:round-half-up 0.0)))
  (is (== 0 (math:round-half-down 0.0)))
  (is (== 0 (math:truncate 0.0)))

  (is (== 1 (math:round-half-up 0.5)))
  (is (== 0 (math:round-half-down 0.5)))
  (is (== 0 (math:round-half-up -0.5)))
  (is (== -1 (math:round-half-down -0.5)))

  (is (== (lisp (-> Integer) () (cl:round 2.5)) (round 2.5)))
  (is (== (lisp (-> Integer) ()  (cl:round -2.5)) (round -2.5)))
  (is (== (lisp (-> Integer) ()  (cl:round 1.5)) (round 1.5)))
  (is (== (lisp (-> Integer) ()  (cl:round -1.5)) (round -1.5)))
  (is (== (lisp (-> Integer) ()  (cl:round 0.5)) (round 0.5)))
  (is (== (lisp (-> Integer) ()  (cl:round -0.5)) (round -0.5))))

(define-test test-integer-division-quotients ()
  (let ((cases (make-list (Tuple 7 2) (Tuple -7 2) (Tuple 7 -2) (Tuple -7 -2)
                          (Tuple 6 3) (Tuple -6 3) (Tuple 0 5) (Tuple 1 1)
                          (Tuple (^ 10 40) 3) (Tuple (negate (^ 10 40)) 7)
                          (Tuple 12345 (^ 2 70)) (Tuple (negate 12345) (^ 2 70)))))
    (for ((xs cases (list:cdr xs)))
      :until (list:null? xs)
      (match (list:car xs)
        ((Tuple a b)
         (is (== (math:floor/ a b) (floor (math:exact/ a b))))
         (is (== (math:ceiling/ a b) (ceiling (math:exact/ a b))))
         (is (== (math:floor/ a b) (math:div a b))))))))

(coalton-toplevel
  ;; 1. Vector space without Multiplicative or Num
  (derive Eq)
  (define-struct TestVec2
    (vx F64)
    (vy F64))

  (define-instance (Additive TestVec2)
    (define (+ (TestVec2 x1 y1) (TestVec2 x2 y2))
      (TestVec2 (+ x1 x2) (+ y1 y2)))
    (define zero (TestVec2 0.0d0 0.0d0)))

  (define-instance (AdditiveGroup TestVec2)
    (define (- (TestVec2 x1 y1) (TestVec2 x2 y2))
      (TestVec2 (- x1 x2) (- y1 y2)))
    (define (negate (TestVec2 x y))
      (TestVec2 (negate x) (negate y))))

  (define-instance (math:Scale F64 TestVec2)
    (define (math:scale c (TestVec2 x y))
      (TestVec2 (* c x) (* c y))))

  (define-instance (math:Module F64 TestVec2))
  (define-instance (math:VectorSpace F64 TestVec2))

  (define-instance (math:InnerSpace F64 TestVec2)
    (define (math:inner-product (TestVec2 x1 y1) (TestVec2 x2 y2))
      (+ (* x1 x2) (* y1 y2))))

  ;; 2. Multiplicative monoid without Additive (2x2 integer matrix)
  (derive Eq)
  (define-struct Mat2x2
    (m00 Integer) (m01 Integer)
    (m10 Integer) (m11 Integer))

  (define-instance (Multiplicative Mat2x2)
    (define (* (Mat2x2 a00 a01 a10 a11) (Mat2x2 b00 b01 b10 b11))
      (Mat2x2 (+ (* a00 b00) (* a01 b10)) (+ (* a00 b01) (* a01 b11))
              (+ (* a10 b00) (* a11 b10)) (+ (* a10 b01) (* a11 b11))))
    (define one (Mat2x2 1 0 0 1)))

  ;; 3. Tropical min-plus Semiring (no AdditiveGroup)
  (derive Eq)
  (define-type TropicalMin
    TropInf
    (TropVal Integer))

  (define-instance (Additive TropicalMin)
    (define (+ a b)
      (match (Tuple a b)
        ((Tuple (TropInf) x) x)
        ((Tuple x (TropInf)) x)
        ((Tuple (TropVal x) (TropVal y)) (TropVal (min x y)))))
    (define zero TropInf))

  (define-instance (Multiplicative TropicalMin)
    (define (* a b)
      (match (Tuple a b)
        ((Tuple (TropInf) _) TropInf)
        ((Tuple _ (TropInf)) TropInf)
        ((Tuple (TropVal x) (TropVal y)) (TropVal (+ x y)))))
    (define one (TropVal 0)))

  (define-instance (Semiring TropicalMin))

  ;; 4. Ring without Eq
  (define-type NoEqRing
    (NoEqRing Integer))

  (define-ring NoEqRing
    (define (+ (NoEqRing a) (NoEqRing b)) (NoEqRing (+ a b)))
    (define (- (NoEqRing a) (NoEqRing b)) (NoEqRing (- a b)))
    (define (* (NoEqRing a) (NoEqRing b)) (NoEqRing (* a b)))
    (define (fromInt n) (NoEqRing n)))

  (declare unwrap-noeq (NoEqRing -> Integer))
  (define (unwrap-noeq (NoEqRing n)) n))

(define-test test-algebraic-hierarchy ()
  ;; Additive, AdditiveGroup, VectorSpace, InnerSpace on TestVec2
  (let ((u (TestVec2 1.0d0 2.0d0))
        (v (TestVec2 3.0d0 -1.0d0)))
    (is (== (+ u v) (TestVec2 4.0d0 1.0d0)))
    (is (== (- u v) (TestVec2 -2.0d0 3.0d0)))
    (is (== (negate u) (TestVec2 -1.0d0 -2.0d0)))
    (is (== (sum (make-list u v)) (TestVec2 4.0d0 1.0d0)))
    (is (== (sum (the (List TestVec2) Nil)) zero))
    (is (== (math:scale 2.5d0 u) (TestVec2 2.5d0 5.0d0)))
    (is (== (math:inner-product u v) 1.0d0)))

  ;; Multiplicative binary exponentiation (^) and product on 2x2 matrices
  (let ((fib-mat (Mat2x2 1 1 1 0)))
    (is (== (^ fib-mat 0) one))
    (is (== (^ fib-mat 1) fib-mat))
    (is (== (^ fib-mat 10) (Mat2x2 89 55 55 34)))
    (is (== (product (make-list fib-mat fib-mat fib-mat)) (^ fib-mat 3))))

  ;; Tropical Semiring
  (let ((a (TropVal 5))
        (b (TropVal 3)))
    (is (== (+ a b) (TropVal 3)))
    (is (== (+ a zero) a))
    (is (== (* a b) (TropVal 8)))
    (is (== (* a one) a))
    (is (== (* a zero) zero))
    (is (== (^ a 4) (TropVal 20)))
    (is (== (math:fromNat 0) TropInf))
    (is (== (math:fromNat 5) (TropVal 0))))

  ;; Ring without Eq
  (let ((r1 (the NoEqRing (fromInt 7)))
        (r2 (the NoEqRing (fromInt 3))))
    (is (== (unwrap-noeq (+ r1 r2)) 10))
    (is (== (unwrap-noeq (- r1 r2)) 4))
    (is (== (unwrap-noeq (* r1 r2)) 21))
    (is (== (unwrap-noeq (negate r1)) -7))
    (is (== (unwrap-noeq (the NoEqRing zero)) 0))
    (is (== (unwrap-noeq (the NoEqRing one)) 1)))

  ;; EuclideanDomain and extended-gcd on Integer and Gaussian integers (Complex Integer)
  (let (values g s t) = (math:extended-gcd -54 24))
  (is (== g 6))
  (is (== (+ (* s -54) (* t 24)) g))
  (is (== (math:gcd -6 0) 6))

  (let ((z1 (math:complex 11 3))
        (z2 (math:complex 1 8)))
    (let (values q r) = (math:quotRem z1 z2))
    (is (== z1 (+ (* z2 q) r)))
    (is (< (math:euclidean-degree r) (math:euclidean-degree z2)))
    (let (values gz sz tz) = (math:extended-gcd z1 z2))
    (is (== gz (math:gcd z1 z2)))
    (is (== (math:normal-part gz) gz))
    (is (== (+ (* sz z1) (* tz z2)) gz))))

(define-test test-polynomial-and-ratio ()
  (let x = (the (poly:Polynomial Fraction) poly:poly-var))
  ;; (x^2 - 1) and (x^2 + 2x + 1) share factor (x + 1)
  (let p = (- (^ x 2) 1))
  (let q = (+ (+ (^ x 2) (* 2 x)) 1))
  (let g = (math:gcd p q))
  (is (== g (+ x 1)))

  ;; Bezout identity on polynomials over Q
  (let a = (+ (+ (^ x 3) (* 2 (^ x 2))) (+ x 2)))
  (let b = (- (^ x 2) 1))
  (let (values d s t) = (math:extended-gcd a b))
  (is (== d 1))
  (is (== (+ (* s a) (* t b)) d))

  ;; Evaluation, composition, calculus
  (is (== (poly:evaluate p 3) 8))
  (is (== (poly:compose p (+ x 1)) (+ (^ x 2) (* 2 x))))
  (is (== (poly:differentiate (+ (+ (^ x 3) (* 3 (^ x 2))) 5))
          (+ (* 3 (^ x 2)) (* 6 x))))
  (is (== (poly:differentiate (poly:integrate q)) q))

  ;; Polynomials over a non-Ring Semiring (TropicalMin)
  (let tp = (poly:polynomial (make-list (TropVal 2) (TropVal 5))))
  (is (== (poly:evaluate tp (TropVal 3)) (TropVal 2)))

  ;; Rational functions Ratio (Polynomial Fraction) with automatic factor cancellation
  (let rf1 = (ratio:mkRatio p q))
  (is (== (ratio:numerator rf1) (- x 1)))
  (is (== (ratio:denominator rf1) (+ x 1)))
  (let rf2 = (ratio:mkRatio 2 (+ x 1)))
  (is (== (+ rf1 rf2) 1))
  (is (== (* rf1 (math:reciprocal rf1)) 1)))

(define-test test-power-series ()
  (let x = (the (series:PowerSeries Fraction) series:series-var))

  ;; Fibonacci generating function: x / (1 - x - x^2)
  (let fib = (/ x (- (- 1 x) (* x x))))
  (is (== (series:series-prefix 9 fib)
          (make-list 0 1 1 2 3 5 8 13 21)))

  ;; Catalan generating function: (1 - sqrt(1 - 4x)) / (2x)
  ;; Equivalently 2 / (1 + sqrt(1 - 4x))
  (let catalan = (/ 2 (+ 1 (sqrt (- 1 (* 4 x))))))
  (is (== (series:series-prefix 7 catalan)
          (make-list 1 1 2 5 14 42 132)))

  ;; Elementary identities on PowerSeries Fraction
  (let ex = (exp x))
  (let l1+x = (ln (+ 1 x)))
  (is (== (series:series-prefix 6 ex)
          (make-list 1 1 1/2 1/6 1/24 1/120)))
  (is (== (series:series-prefix 6 l1+x)
          (make-list 0 1 -1/2 1/3 -1/4 1/5)))
  (is (== (exp l1+x) (+ 1 x)))
  (is (== (ln ex) x))

  ;; Trigonometric identities: sin^2(x) + cos^2(x) == 1, tan(x), atan(x), asin(x)
  (let sx = (sin x))
  (let cx = (cos x))
  (is (== (+ (* sx sx) (* cx cx)) 1))
  (is (== (series:series-differentiate sx) cx))
  (is (== (series:series-differentiate cx) (negate sx)))
  (is (== (series:series-prefix 6 (tan x))
          (make-list 0 1 0 1/3 0 2/15)))
  (is (== (series:series-prefix 6 (atan x))
          (make-list 0 1 0 -1/3 0 1/5)))
  (is (== (series:series-prefix 6 (asin x))
          (make-list 0 1 0 1/6 0 3/40)))

  ;; Composition and Lagrange reversion:
  ;; (exp(x) - 1)^<-1> == ln(1 + x), and sin^<-1>(x) == asin(x)
  (let expm1 = (- ex 1))
  (is (== (series:with-series-comparison-order 8
            (fn () (== (series:series-revert expm1) l1+x)))
          True))
  (is (== (series:with-series-comparison-order 8
            (fn () (== (series:series-revert sx) (asin x))))
          True))
  (is (== (series:with-series-comparison-order 8
            (fn () (== (series:series-compose sx (asin x)) x)))
          True)))